@model LinkedBoardsIndexViewModel
@{
    ViewData["Title"] = "Linked Boards";
}

<div class="card modern-card mb-4">
    <div class="card-header modern-card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">
            <i class="fas fa-link text-danger me-2"></i>
            Linked Boards
        </h2>
        <a asp-controller="Group" asp-action="Index" asp-area="Platform" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Groups
        </a>
    </div>
    <div class="card-body modern-card-body">
        <p class="text-muted">Boards in the same set show each other's quests and events on their calendars, read-only. A set links boards of one type, and a board can be in only one set.</p>
        <form asp-area="Platform" asp-controller="LinkedBoards" asp-action="Create" method="post">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label for="create-set-name" class="form-label">Set name</label>
                    <input id="create-set-name" name="Name" type="text" class="form-control" required maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label for="create-set-board-type" class="form-label">Board type</label>
                    <select id="create-set-board-type" name="BoardType" class="form-select" required>
                        <option value="">-- Select Board Type --</option>
                        <option value="@((int)BoardType.OneShot)">One-Shot</option>
                        <option value="@((int)BoardType.Campaign)">Campaign</option>
                    </select>
                </div>
            </div>
            <div class="form-text mt-2">Every board in the set must be this type. This cannot be changed after creation.</div>
            <hr>
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Create Set
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Sets.Count == 0)
{
    <div class="card modern-card">
        <div class="card-body modern-card-body">
            <div class="py-5 text-center">
                <i class="fas fa-link fa-3x text-muted mb-3"></i>
                <p class="mb-1"><strong>No linked sets yet.</strong></p>
                <p class="text-muted">Create a set above, then add boards of the same type to share their calendars.</p>
            </div>
        </div>
    </div>
}
else
{
    @foreach (var set in Model.Sets)
    {
        var typeLabel = set.BoardType == BoardType.Campaign ? "Campaign" : "One-Shot";
        var candidates = Model.UnlinkedBoards.Where(b => b.BoardType == set.BoardType).ToList();

        <div class="card modern-card mb-3">
            <div class="card-header modern-card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-link me-2"></i>@set.Name
                </h5>
                <div class="d-flex align-items-center gap-2">
                    @if (set.BoardType == BoardType.Campaign)
                    {
                        <span class="badge bg-info text-dark"><i class="fas fa-book-open me-1"></i>Campaign</span>
                    }
                    else
                    {
                        <span class="badge bg-primary"><i class="fas fa-dice-d20 me-1"></i>One-Shot</span>
                    }
                    @if (set.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body modern-card-body">
                @if (set.Boards.Count == 0)
                {
                    <p class="text-muted">No boards in this set yet.</p>
                }
                else
                {
                    if (!set.IsActive)
                    {
                        <p class="text-muted">Inactive: add at least one more board to share calendars.</p>
                    }
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Board</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var board in set.Boards)
                                {
                                    <tr>
                                        <td>@board.Name</td>
                                        <td class="text-end"></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-area="Platform" asp-controller="LinkedBoards" asp-action="AddBoard" asp-route-id="@set.Id" method="post">
                    <label for="add-board-@set.Id" class="form-label">Add a board</label>
                    <div class="input-group">
                        <select id="add-board-@set.Id" name="groupId" class="form-select" required disabled="@(candidates.Count == 0)">
                            <option value="">-- Select a board --</option>
                            @foreach (var candidate in candidates)
                            {
                                <option value="@candidate.Id">@candidate.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-success" disabled="@(candidates.Count == 0)">
                            <i class="fas fa-plus me-2"></i>Add Board
                        </button>
                    </div>
                    @if (candidates.Count == 0)
                    {
                        <div class="form-text">No unlinked @typeLabel boards are available.</div>
                    }
                </form>
            </div>
        </div>
    }
}
