@model LinkedBoardsIndexViewModel
@{
    ViewData["Title"] = "Linked Boards";
}

@section Styles {
    <link href="~/css/platform-group.mobile.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/platform-linked-boards.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="platform-group-card-mobile linked-boards-mobile mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h5 class="mb-0">
            <i class="fas fa-link text-danger me-2"></i>Linked Boards
        </h5>
        <a asp-controller="Group" asp-action="Index" asp-area="Platform" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left me-2"></i>Back to Groups
        </a>
    </div>

    <p>Boards in the same set show each other's quests and events on their calendars, read-only. A set links boards of one type, and a board can be in only one set.</p>

    <form asp-area="Platform" asp-controller="LinkedBoards" asp-action="Create" method="post" class="mb-3">
        <div class="mb-2">
            <label for="create-set-name" class="form-label">Set name</label>
            <input id="create-set-name" name="Name" type="text" class="form-control" required maxlength="100" />
        </div>
        <div class="mb-2">
            <label for="create-set-board-type" class="form-label">Board type</label>
            <select id="create-set-board-type" name="BoardType" class="form-select" required>
                <option value="">-- Select Board Type --</option>
                <option value="@((int)BoardType.OneShot)">One-Shot</option>
                <option value="@((int)BoardType.Campaign)">Campaign</option>
            </select>
        </div>
        <div class="form-text mb-3">Every board in the set must be this type. This cannot be changed after creation.</div>
        <button type="submit" class="btn btn-success w-100">
            <i class="fas fa-plus me-2"></i>Create Set
        </button>
    </form>

    @if (Model.Sets.Count == 0)
    {
        <div class="py-5 text-center">
            <i class="fas fa-link fa-3x text-muted mb-3"></i>
            <p class="mb-1"><strong>No linked sets yet.</strong></p>
            <p class="text-muted">Create a set above, then add boards of the same type to share their calendars.</p>
        </div>
    }
    else
    {
        @foreach (var set in Model.Sets)
        {
            var typeLabel = set.BoardType == BoardType.Campaign ? "Campaign" : "One-Shot";
            var candidates = Model.UnlinkedBoards.Where(b => b.BoardType == set.BoardType).ToList();

            <div class="group-card-mobile mb-3">
                <strong class="parchment-text">@set.Name</strong>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                    @if (set.BoardType == BoardType.Campaign)
                    {
                        <span class="badge bg-info text-dark"><i class="fas fa-book-open me-1"></i>Campaign</span>
                    }
                    else
                    {
                        <span class="badge bg-primary"><i class="fas fa-dice-d20 me-1"></i>One-Shot</span>
                    }
                    @if (set.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>

                @if (set.Boards.Count == 0)
                {
                    <p class="text-muted mt-2 mb-2">No boards in this set yet.</p>
                }
                else
                {
                    if (!set.IsActive)
                    {
                        <p class="text-muted mt-2 mb-1">Inactive: add at least one more board to share calendars.</p>
                    }
                    <div class="mt-2">
                        @foreach (var board in set.Boards)
                        {
                            <div class="linked-set-board-row">
                                <span class="linked-set-board-name parchment-text">@board.Name</span>
                            </div>
                        }
                    </div>
                }

                <form asp-area="Platform" asp-controller="LinkedBoards" asp-action="AddBoard" asp-route-id="@set.Id" method="post" class="mt-2">
                    <label for="add-board-@set.Id" class="form-label">Add a board</label>
                    <select id="add-board-@set.Id" name="groupId" class="form-select mb-2" required disabled="@(candidates.Count == 0)">
                        <option value="">-- Select a board --</option>
                        @foreach (var candidate in candidates)
                        {
                            <option value="@candidate.Id">@candidate.Name</option>
                        }
                    </select>
                    @if (candidates.Count == 0)
                    {
                        <div class="form-text mb-2">No unlinked @typeLabel boards are available.</div>
                    }
                    <button type="submit" class="btn btn-success w-100" disabled="@(candidates.Count == 0)">
                        <i class="fas fa-plus me-2"></i>Add Board
                    </button>
                </form>
            </div>
        }
    }
</div>
