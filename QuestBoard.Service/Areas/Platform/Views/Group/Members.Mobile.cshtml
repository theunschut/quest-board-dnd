@using QuestBoard.Service.ViewModels.AdminViewModels
@model GroupMembersViewModel
@{
    ViewData["Title"] = $"Members — {Model.Group.Name}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/platform-pages.mobile.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
}

<div class="card modern-card">
    <div class="card-header modern-card-header page-bar">
        <h1 class="mb-0">
            <i class="fas fa-users me-2" aria-hidden="true"></i>Members &mdash; @Model.Group.Name
        </h1>
        <div class="page-bar__actions">
            <a asp-controller="Group" asp-action="Index" asp-area="Platform" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Groups
            </a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createMemberModal">
                <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create New User
            </button>
        </div>
    </div>
    <div class="card-body modern-card-body">
        <section class="members-section" aria-labelledby="members-current">
            <h2 class="members-section__title" id="members-current">
                <i class="fas fa-users me-2" aria-hidden="true"></i>Current Members
            </h2>

            <form method="get" asp-action="Members" asp-route-id="@Model.Group.Id" asp-route-search="@Model.SearchQuery" class="members-search">
                <div class="input-group">
                    <label for="memberSearch-input" class="visually-hidden">Search members</label>
                    <input type="text" id="memberSearch-input" name="memberSearch" class="form-control" value="@Model.MemberSearchQuery"
                           placeholder="Search by name or email..." autocomplete="off" />
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-search me-2" aria-hidden="true"></i>Search
                    </button>
                </div>
            </form>

            @if (Model.Members.Any())
            {
                @foreach (var member in Model.Members)
                {
                    <div class="row-slip">
                        <div class="row-slip__head">
                            <span class="user-slip__name">@(member.User?.Name ?? "Unknown")</span>
                            <partial name="_RoleBadge" model="member.GroupRole" />
                        </div>
                        <p class="slip-line">@(member.User?.Email ?? "")</p>
                        <div class="row-slip__actions">
                            <form asp-action="RemoveMember" asp-route-id="@Model.Group.Id" asp-route-search="@Model.SearchQuery" asp-route-memberSearch="@Model.MemberSearchQuery"
                                  method="post" asp-antiforgery="true"
                                  data-confirm-message="Remove this member from the group? Their availability answers for events on this board will be deleted and cannot be recovered.">
                                <input type="hidden" name="userId" value="@member.UserId" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-user-minus me-2" aria-hidden="true"></i>Remove Member
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else if (string.IsNullOrWhiteSpace(Model.MemberSearchQuery))
            {
                <div class="empty-state">
                    <i class="fas fa-users empty-state-icon" aria-hidden="true"></i>
                    <p class="empty-state-text">No members in this group yet.</p>
                </div>
            }
            else
            {
                <p class="fst-italic">
                    No members match "@Model.MemberSearchQuery".
                    <a asp-action="Members" asp-route-id="@Model.Group.Id" asp-route-search="@Model.SearchQuery" class="clear-search">
                        <i class="fas fa-times me-1" aria-hidden="true"></i>Clear search
                    </a>
                </p>
            }
        </section>

        <section class="members-section" aria-labelledby="members-available">
            <h2 class="members-section__title" id="members-available">
                <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Available Users
            </h2>

            <form method="get" asp-action="Members" asp-route-id="@Model.Group.Id" asp-route-memberSearch="@Model.MemberSearchQuery" class="members-search">
                <div class="input-group">
                    <label for="search-input" class="visually-hidden">Search users</label>
                    <input type="text" id="search-input" name="search" class="form-control" value="@Model.SearchQuery"
                           placeholder="Search by name or email..." autocomplete="off" />
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-search me-2" aria-hidden="true"></i>Search
                    </button>
                </div>
            </form>

            @if (Model.AvailableUsers.Any())
            {
                @foreach (var u in Model.AvailableUsers)
                {
                    <div class="row-slip">
                        <div class="row-slip__head">
                            <span class="user-slip__name">@u.Name</span>
                        </div>
                        <p class="slip-line">@u.Email</p>
                        <div class="row-slip__actions">
                            <form asp-action="AddMember" asp-route-id="@Model.Group.Id" asp-route-search="@Model.SearchQuery" asp-route-memberSearch="@Model.MemberSearchQuery"
                                  method="post" asp-antiforgery="true" class="add-member-form">
                                <input type="hidden" name="UserId" value="@u.Id" />
                                <label for="role-@u.Id" class="visually-hidden">Role</label>
                                <select id="role-@u.Id" name="Role" asp-items="AdminPlatformDisplay.GroupRoleOptions()" class="form-select form-select-sm"></select>
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Add
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
            else if (string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <p class="fst-italic">All users are already members of this group.</p>
            }
            else
            {
                <p class="fst-italic">
                    No users match "@Model.SearchQuery".
                    <a asp-action="Members" asp-route-id="@Model.Group.Id" asp-route-memberSearch="@Model.MemberSearchQuery" class="clear-search">
                        <i class="fas fa-times me-1" aria-hidden="true"></i>Clear search
                    </a>
                </p>
            }
        </section>
    </div>
</div>

<div class="modal fade" id="createMemberModal" tabindex="-1" aria-labelledby="createMemberModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateMember" asp-route-id="@Model.Group.Id" asp-route-search="@Model.SearchQuery" asp-route-memberSearch="@Model.MemberSearchQuery" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title" id="createMemberModalTitle">
                        <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create New User
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-page">
                        <div class="mb-3">
                            <label for="createMemberEmail" class="form-label">@Html.DisplayNameFor(m => m.CreateMember.Email) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                            <input id="createMemberEmail" name="Email" type="email" class="form-control" autocomplete="off" required />
                        </div>
                        <div class="mb-3">
                            <label for="createMemberName" class="form-label">@Html.DisplayNameFor(m => m.CreateMember.Name) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                            <input id="createMemberName" name="Name" type="text" class="form-control" maxlength="100" autocomplete="off" required />
                        </div>
                        <div class="mb-3">
                            <label for="createMemberRole" class="form-label">@Html.DisplayNameFor(m => m.CreateMember.GroupRole) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                            <select id="createMemberRole" name="GroupRole" asp-items="AdminPlatformDisplay.GroupRoleOptions()" class="form-select" required></select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
