@using QuestBoard.Service.ViewModels.AdminViewModels
@model GroupEditViewModel
@{
    ViewData["Title"] = "Edit Group";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/platform-pages.mobile.css" asp-append-version="true" />
}

<div class="card modern-card">
    <div class="card-header modern-card-header">
        <h1 class="mb-0">
            <i class="fas fa-edit me-2" aria-hidden="true"></i>@ViewData["Title"]
        </h1>
    </div>
    <div class="card-body modern-card-body">
        @if (ViewData.ModelState.TryGetValue(string.Empty, out var boardErrors) && boardErrors.Errors.Count > 0)
        {
            foreach (var error in boardErrors.Errors)
            {
                <div role="alert" class="refusal-line">
                    <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                    <span>@error.ErrorMessage</span>
                </div>
            }
        }

        <form asp-action="Edit" method="post" class="form-page">
            <input asp-for="Id" type="hidden" />
            <input type="hidden" name="RenderedDisabledPages" value="@Model.RenderedDisabledPages" />
            <input type="hidden" name="RenderedHomePage" value="@Model.RenderedHomePage" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Html.DisplayNameFor(m => m.Name) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                <input asp-for="Name" class="form-control" autocomplete="off" aria-describedby="Name-error" />
                <span asp-validation-for="Name" id="Name-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BoardType" class="form-label"></label>
                <select asp-for="BoardType" asp-items="AdminPlatformDisplay.BoardTypeOptions()" class="form-select" disabled></select>
            </div>

            <div class="mb-3" role="group" aria-labelledby="pages-title" aria-describedby="pages-hint">
                <h2 class="form-section-title" id="pages-title">
                    <i class="fas fa-table-columns me-2" aria-hidden="true"></i>Pages
                </h2>
                <div class="form-text mb-2" id="pages-hint">Switch off the pages this board doesn't use. Nothing is deleted.</div>

                @{ var rowIndex = 0; }
                @foreach (var row in Model.Pages)
                {
                    var pageName = row.Page.ToString();
                    <div class="form-check form-switch page-switch">
                        @if (row.Locked)
                        {
                            <input type="checkbox" class="form-check-input" id="page-@pageName" role="switch" disabled aria-describedby="page-reason-@pageName" />
                            <label class="form-check-label" for="page-@pageName">@row.Label</label>
                            <p class="control-reason" id="page-reason-@pageName"><i class="fas fa-lock" aria-hidden="true"></i><span>@row.LockedReason</span></p>
                        }
                        else
                        {
                            <input type="hidden" name="Pages[@rowIndex].Page" value="@pageName" />
                            <input type="checkbox" class="form-check-input" id="page-@pageName" role="switch" name="Pages[@rowIndex].Enabled" value="true" checked="@row.Enabled" />
                            <input type="hidden" name="Pages[@rowIndex].Enabled" value="false" />
                            <label class="form-check-label" for="page-@pageName">@row.Label</label>
                            rowIndex++;
                        }
                    </div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="HomePage" class="form-label"></label>
                <select asp-for="HomePage" asp-items="Model.HomeChoices" class="form-select" aria-describedby="HomePage-hint HomePage-error"></select>
                <div class="form-text" id="HomePage-hint">Where the board opens, and where the brand link and refused pages lead.</div>
                <span asp-validation-for="HomePage" id="HomePage-error"></span>
            </div>

            <hr>

            <div class="form-actions form-actions--stack">
                <a asp-action="Index" asp-area="Platform" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Groups
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2" aria-hidden="true"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
