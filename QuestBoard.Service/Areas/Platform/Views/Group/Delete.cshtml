@model BoardDeletePageViewModel
@{
    ViewData["Title"] = "Delete Board";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-group-delete.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h2 class="mb-0">
                    <i class="fas fa-trash text-danger me-2" aria-hidden="true"></i>Delete board
                </h2>
                <span class="header-subtitle">This permanently removes the board and everything on it.</span>
            </div>
            <div class="card-body modern-card-body">
                <partial name="_BoardDeleteBody" model="Model" />
            </div>
        </div>
    </div>
</div>
