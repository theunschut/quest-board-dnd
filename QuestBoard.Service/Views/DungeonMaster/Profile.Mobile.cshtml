@using QuestBoard.Service.ViewModels.DungeonMasterViewModels
@using QuestBoard.Service.Extensions
@model DMProfileViewModel
@{
    ViewData["Title"] = $"{Model.Name} — DM Profile";
    var questsOn = (await BoardPages.GetAsync()).Serves(BoardPage.Quests);

    void RenderQuestDate(QuestSummaryViewModel quest)
    {
        <div class="member-row-line">
            <i class="fas fa-calendar-check me-1" aria-hidden="true"></i>
            @if (quest.Date.HasValue)
            {
                @Html.WallClock(quest.Date.Value, "date")
            }
            else
            {
                @:Date TBD
            }
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/markdown-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dm-profile.mobile.css" asp-append-version="true" />
}

<div class="dm-profile-page">
    <div class="card modern-card dm-profile-card mb-3">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">@Model.Name</h1>
        </div>
        <div class="card-body modern-card-body dm-profile-summary">
            @if (Model.HasProfilePicture)
            {
                <img class="dm-profile-photo" src="@Url.Action("GetDMProfilePicture", new { id = Model.UserId })" alt="" />
            }
            else
            {
                <div class="dm-profile-placeholder" aria-hidden="true"><i class="fas fa-user fa-4x"></i></div>
            }
            <p class="dm-profile-role"><i class="fas fa-crown me-1" aria-hidden="true"></i>Dungeon Master</p>
            @if (Model.CanEdit)
            {
                <a asp-action="EditProfile" asp-route-id="@Model.UserId" class="btn btn-warning dm-profile-edit">
                    <i class="fas fa-edit me-2" aria-hidden="true"></i>Edit Profile
                </a>
            }
        </div>
    </div>

    <section class="card modern-card modern-card--aside mb-3" aria-labelledby="dm-about-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="dm-about-title"><i class="fas fa-scroll me-2" aria-hidden="true"></i>About</h2>
        </div>
        <div class="card-body modern-card-body">
            @if (!string.IsNullOrWhiteSpace(Model.Bio))
            {
                @Html.Markdown(Model.Bio)
            }
            else
            {
                <p class="mb-0 text-muted">No bio provided yet.</p>
            }
        </div>
    </section>

    <section class="card modern-card modern-card--aside mb-3" aria-labelledby="dm-history-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="dm-history-title"><i class="fas fa-list me-2" aria-hidden="true"></i>Quest History</h2>
        </div>
        <div class="card-body modern-card-body">
            @if (Model.Quests.Any())
            {
                @foreach (var quest in Model.Quests)
                {
                    if (questsOn)
                    {
                        <div class="dm-quest-row member-row modern-card modern-card--interactive">
                            <div class="member-row-body">
                                <h3 class="member-row-name"><a class="row-nav-link" href="@Url.Action("Details", "Quest", new { id = quest.Id })">@quest.Title</a></h3>
                                @{ RenderQuestDate(quest); }
                            </div>
                            <span class="badge bg-secondary">CR @quest.ChallengeRating</span>
                        </div>
                    }
                    else
                    {
                        <div class="dm-quest-row member-row modern-card">
                            <div class="member-row-body">
                                <h3 class="member-row-name">@quest.Title</h3>
                                @{ RenderQuestDate(quest); }
                            </div>
                            <span class="badge bg-secondary">CR @quest.ChallengeRating</span>
                        </div>
                    }
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-dragon empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Quests Yet</h2>
                    <p class="empty-state-text">This Dungeon Master hasn't run any quests yet.</p>
                </div>
            }
        </div>
    </section>
</div>
