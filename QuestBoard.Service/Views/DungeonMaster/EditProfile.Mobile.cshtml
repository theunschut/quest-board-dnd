@using QuestBoard.Service.ViewModels.DungeonMasterViewModels
@using QuestBoard.Service.ViewModels.Shared
@model EditDMProfileViewModel
@{
    ViewData["Title"] = "Edit DM Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/image-crop.css" asp-append-version="true" />
    <link href="~/css/dm-editprofile.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
    <div class="dm-editprofile-card-mobile mb-3">

        <div class="mb-3">
            <h5 class="mb-0">
                <i class="fas fa-user-edit text-warning me-2"></i>Edit DM Profile
            </h5>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form asp-action="EditProfile" asp-route-id="@Model.DungeonMasterId"
              method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="DungeonMasterId" />

            <!-- Photo section at top -->
            <div class="dm-editprofile-photo-section mb-3">
                <label asp-for="ProfilePictureFile" class="form-label d-block">Profile Photo</label>
                @if (Model.HasProfilePicture)
                {
                    <div class="mb-2">
                        <img src="@Url.Action("GetDMProfilePicture", new { id = Model.DungeonMasterId })"
                             alt="Current profile photo"
                             class="dm-profile-photo" />
                        <div>
                            <button type="button" class="btn btn-sm btn-warning mt-2" id="recropPhotoBtn" data-crop-original-url="@Url.Action("GetOriginalDMProfilePicture", new { id = Model.DungeonMasterId })">
                                <i class="fas fa-crop-alt me-1"></i>Re-crop Photo
                            </button>
                        </div>
                    </div>
                }
                <input type="file" asp-for="ProfilePictureFile"
                       class="form-control" accept="image/*"
                       id="dmProfilePictureInput" data-crop-input data-crop-output-name="CroppedPictureFile" data-crop-aspect-ratio="1" />
                <input type="file" name="CroppedPictureFile" hidden />
                <small class="form-text">JPG, PNG or GIF — max 5 MB</small>
                <span asp-validation-for="ProfilePictureFile" class="text-danger"></span>
                <div id="fileSizeError" class="crop-error" role="alert" hidden><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span data-crop-error-text></span></div>
            </div>

            <!-- Bio textarea below photo section -->
            @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
               {
                   FieldName = "Bio",
                   Value = Model.Bio,
                   Label = "Bio",
                   Required = false,
                   Placeholder = null,
                   MaxLength = 2000
               }); }
            <small class="form-text">Introduce yourself to the players (max 2000 characters).</small>

            <div class="d-flex gap-2 mt-3">
                <a asp-action="Profile" asp-route-id="@Model.DungeonMasterId" class="btn btn-secondary flex-fill">
                    <i class="fas fa-arrow-left me-2"></i>Back to Profile
                </a>
                <button type="submit" class="btn btn-warning flex-fill">
                    <i class="fas fa-save me-2"></i>Save Profile
                </button>
            </div>
        </form>

    </div>
</div>

<partial name="_ImageCropDialog" />

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script src="~/lib/cropperjs-2.1.1/cropper.min.js"></script>
    <script type="module" src="~/js/image-crop.js" asp-append-version="true"></script>
}
