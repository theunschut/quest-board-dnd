@using QuestBoard.Domain.Models.BoardMove
@using QuestBoard.Service.ViewModels.MoveViewModels
@model MovePageViewModel
@{
    var preview = Model.Preview;
    var quest = (preview as QuestMovePreview)?.Quest;
    var questPreview = preview as QuestMovePreview;
    var targetName = preview.Target?.Name ?? string.Empty;
    ViewData["Title"] = $"Move {Model.KindTitle} to Linked Board";
}

<div class="row">
    <div class="col-lg-4">
        <div class="card modern-card mb-3">
            <div class="card-header modern-card-header">
                <h4 class="mb-0">This @Model.KindTitle</h4>
            </div>
            <div class="card-body modern-card-body">
                <p class="mb-1"><i class="fas fa-scroll me-2" aria-hidden="true"></i>@preview.EntryTitle</p>
                <p class="mb-1"><i class="fas fa-location-dot me-2" aria-hidden="true"></i>On @preview.SourceBoardName</p>
                @if (quest != null)
                {
                    if (quest.IsFinalized && quest.FinalizedDate.HasValue)
                    {
                        <p class="mb-1"><i class="fas fa-clock me-2" aria-hidden="true"></i>Session @Html.WallClock(quest.FinalizedDate.Value, "date-time")</p>
                    }
                    else
                    {
                        <p class="mb-1">
                            <i class="fas fa-calendar-day me-2" aria-hidden="true"></i>@(quest.ProposedDates.Count == 1 ? "Voting open, 1 proposed date" : $"Voting open, {quest.ProposedDates.Count} proposed dates")
                        </p>
                    }
                    <p class="mb-1"><i class="fas fa-user me-2" aria-hidden="true"></i>DM: @questPreview!.DmName</p>
                    <p class="mb-1"><i class="fas fa-circle-check me-2" aria-hidden="true"></i>@(quest.IsFinalized ? "Finalized" : "Open for signups")</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h2 class="mb-0">
                    <i class="fas fa-right-left text-info me-2" aria-hidden="true"></i>
                    Move @Model.KindTitle to Linked Board
                </h2>
            </div>
            <div class="card-body modern-card-body">
                @if (Model.ChangedSincePreview)
                {
                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-triangle-exclamation me-2" aria-hidden="true"></i>Things changed while you were reviewing this. Check what the move will do now, then confirm again.
                    </div>
                }

                <p>Choose the board this @Model.KindWord should live on. It will look as if it had been created there, and @preview.SourceBoardName will no longer show it.</p>

                @if (Model.ShowPicker)
                {
                    <form method="get" asp-controller="Move" asp-action="@Model.MoveAction" asp-route-id="@preview.EntryId" asp-fragment="move-preview" class="mb-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-8">
                                <label for="targetBoardId" class="form-label">Move to</label>
                                <select id="targetBoardId" name="targetBoardId" class="form-select">
                                    <option value="">-- Select a board --</option>
                                    @foreach (var board in preview.LinkedBoards)
                                    {
                                        <option value="@board.Id" selected="@(preview.Target?.Id == board.Id)">@board.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-info w-100">
                                    <i class="fas fa-eye me-2" aria-hidden="true"></i>Show What Will Happen
                                </button>
                            </div>
                        </div>
                    </form>
                }
                else if (preview.Target != null)
                {
                    <p><i class="fas fa-arrow-right me-2" aria-hidden="true"></i>Moving to @preview.Target.Name</p>
                }

                @if (preview.Status == MoveStatus.ChooseTarget)
                {
                    <p>Choose a board to see what the move will do there.</p>
                }
                else if (preview.Status == MoveStatus.TargetNotLinked)
                {
                    <div class="alert alert-danger" role="alert">That board is not part of this linked set. Choose one from the list.</div>
                }

                @if (Model.ShowPreview)
                {
                    <section id="move-preview" aria-labelledby="move-preview-heading">
                        <h4 id="move-preview-heading">What will happen on @targetName</h4>
                        @if (preview.Status == MoveStatus.DungeonMasterNotEligible)
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="fas fa-ban me-2" aria-hidden="true"></i>
                                <strong class="move-strong">@targetName cannot take this quest.</strong>
                                <div>@questPreview?.DmName is not a Dungeon Master or Admin on @targetName. Make them one there, or choose another board.</div>
                            </div>
                        }
                        else
                        {
                            <ul class="move-consequences list-unstyled">
                                <li class="move-consequence move-consequence--kept">
                                    <div class="move-consequence-icon"><i class="fas fa-fw fa-check" aria-hidden="true"></i></div>
                                    <div class="move-consequence-body"><p class="mb-0">@Model.KeptSentence</p></div>
                                </li>
                                <li class="move-consequence move-consequence--neutral">
                                    <div class="move-consequence-icon"><i class="fas fa-fw fa-envelope" aria-hidden="true"></i></div>
                                    <div class="move-consequence-body"><p class="mb-0">@Model.EmailSentence</p></div>
                                </li>
                            </ul>
                        }
                    </section>
                }

                <hr>
                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Details", Model.EntryController, new { id = preview.EntryId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to This @Model.KindTitle
                    </a>
                    @if (Model.ShowConfirm)
                    {
                        <form method="post" asp-controller="Move" asp-action="@Model.MoveAction">
                            <input type="hidden" name="id" value="@preview.EntryId" />
                            <input type="hidden" name="targetBoardId" value="@preview.Target!.Id" />
                            <input type="hidden" name="stamp" value="@preview.Stamp" />
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-right-left me-2" aria-hidden="true"></i>Move to @targetName
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
