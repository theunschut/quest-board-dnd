@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.Extensions
@using QuestBoard.Service.ViewModels.PlayersViewModels
@model PlayersIndexViewModel
@{
    ViewData["Title"] = "Players";
    var dungeonMasterProfileOn = (await BoardPages.GetAsync()).Serves(BoardPage.DungeonMasterProfile);
}

@section Styles {
    <link rel="stylesheet" href="~/css/member-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/players.mobile.css" asp-append-version="true" />
}

<div class="players-page">
    <div class="card modern-card mb-3">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">Players</h1>
        </div>
    </div>

    <section class="card modern-card modern-card--aside players-section" aria-labelledby="players-dm-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="players-dm-title"><i class="fas fa-crown me-2" aria-hidden="true"></i>Dungeon Masters</h2>
        </div>
        <div class="card-body modern-card-body">
            @if (Model.DungeonMasters.Any())
            {
                @foreach (var dm in Model.DungeonMasters)
                {
                    if (dungeonMasterProfileOn)
                    {
                        <div class="players-row member-row modern-card modern-card--interactive">
                            <h3 class="players-name"><a class="row-nav-link" asp-controller="DungeonMaster" asp-action="Profile" asp-route-id="@dm.Id">@dm.Name</a></h3>
                            <i class="fas fa-chevron-right players-chevron" aria-hidden="true"></i>
                        </div>
                    }
                    else
                    {
                        <div class="players-row member-row modern-card no-link">
                            <p class="players-name">@dm.Name</p>
                        </div>
                    }
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-crown empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Dungeon Masters Found</h2>
                    <p class="empty-state-text">No dungeon masters are registered yet. Brave souls may register as new quest leaders.</p>
                </div>
            }
        </div>
    </section>

    <section class="card modern-card modern-card--aside players-section" aria-labelledby="players-registered-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="players-registered-title"><i class="fas fa-users me-2" aria-hidden="true"></i>Registered Players</h2>
        </div>
        <div class="card-body modern-card-body">
            @if (Model.Players.Any())
            {
                @foreach (var player in Model.Players)
                {
                    <div class="players-row member-row modern-card no-link">
                        <p class="players-name">@player.Name</p>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-users empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Players Found</h2>
                    <p class="empty-state-text">No adventurers have registered yet. Players can register to join quests.</p>
                </div>
            }
        </div>
    </section>
</div>
