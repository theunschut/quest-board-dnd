@using QuestBoard.Domain.Enums
@using QuestBoard.Service.Constants
@using QuestBoard.Service.ViewModels.AgendaViewModels
@model AgendaViewModel
@{
    ViewData["Title"] = "My Agenda";
    var hasOtherBoardRow = Model.Rows.Any(r => !r.IsActiveBoard);
    var isDm = (await AuthorizationService.AuthorizeAsync(User, "DungeonMasterOnly")).Succeeded;
    var pages = await BoardPages.GetAsync();
}
@section Styles {
    <link rel="stylesheet" href="~/css/agenda.css" asp-append-version="true" />
}
@* This page's row action deliberately does not follow the availability overview's
   whole-row click target. Each row here also carries a full roster, and a full-row target
   would swallow text selection inside it -- and here the consequence of a click is a board
   switch rather than a plain navigation, so the target has to be a small, explicit control
   a reader cannot hit by accident. Do not "restore consistency" with the overview's pattern. *@

@* Full width rather than the availability overview's nine-column split: that page reserves the
   remaining columns for its legend, and this one has no legend to put there. *@
<div class="row">
    <div class="col-12">
        <div class="card modern-card">
            <div class="card-header modern-card-header d-flex justify-content-between align-items-start gap-2">
                <div>
                    <h1 class="mb-0">
                        <i class="fas fa-calendar-days text-purple me-2" aria-hidden="true"></i>@ViewData["Title"]
                    </h1>
                    <p class="header-subtitle mb-0">Upcoming events across all your boards</p>
                </div>
                @if (isDm && pages.Serves(BoardPage.Events))
                {
                    <a asp-controller="Events" asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-calendar-check me-2" aria-hidden="true"></i>Board Availability
                    </a>
                }
            </div>
            <div class="card-body modern-card-body">
                @if (Model.EmptyState == AgendaEmptyState.NoBoards)
                {
                    <div class="empty-state agenda-empty-state">
                        <i class="fas fa-calendar-xmark empty-state-icon" aria-hidden="true"></i>
                        <h2 class="empty-state-heading">No Boards Yet</h2>
                        <p class="empty-state-text">You're not a member of any board yet. Once you join one, your upcoming events will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="dropdown mb-3">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="fas fa-filter me-1" aria-hidden="true"></i>Filter Boards
                            <span class="badge bg-secondary ms-1">@Model.SelectedCount of @Model.TotalCount</span>
                        </button>
                        <div class="dropdown-menu p-3 agenda-filter-menu">
                            <p class="small text-muted mb-2">
                                Choose which of your own boards to show. This never adds boards you don't belong to -- only narrows the ones shown.
                            </p>
                            <form asp-action="Index" method="get">
                                @* A GET submission replaces the whole querystring, so without this
                                   the current window collapses back to the default page size the
                                   moment a reader narrows the filter. Model.Take is the value the
                                   server already clamped, so round-tripping it cannot widen it. *@
                                <input type="hidden" name="take" value="@Model.Take" />
                                <input type="hidden" name="boards" value="" />
                                @foreach (var board in Model.AvailableBoards)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="boards" value="@board.Id"
                                               id="board-@board.Id" checked="@board.IsSelected" />
                                        <label class="form-check-label small" for="board-@board.Id">@board.Name</label>
                                    </div>
                                }
                                <hr class="my-2" />
                                <button type="submit" class="btn btn-secondary btn-sm w-100">Apply</button>
                            </form>
                        </div>
                    </div>

                    @if (Model.EmptyState == AgendaEmptyState.NoUpcomingEvents)
                    {
                        <div class="empty-state agenda-empty-state">
                            <i class="fas fa-calendar-alt empty-state-icon" aria-hidden="true"></i>
                            <h2 class="empty-state-heading">No Upcoming Events</h2>
                            <p class="empty-state-text">None of your boards have anything scheduled yet. Once a DM schedules a session, it will appear here.</p>
                        </div>
                    }
                    else if (Model.EmptyState == AgendaEmptyState.AllBoardsFiltered)
                    {
                        <div class="empty-state agenda-empty-state">
                            <i class="fas fa-filter-circle-xmark empty-state-icon" aria-hidden="true"></i>
                            <h2 class="empty-state-heading">All Boards Filtered Out</h2>
                            <p class="empty-state-text">You've hidden every board from view. Adjust the filter above, or</p>
                            <a asp-action="Index" asp-route-boards="@SessionKeys.AgendaBoardFilterResetSentinel" class="btn btn-secondary btn-sm">
                                <i class="fas fa-rotate-left me-1" aria-hidden="true"></i>Show All Boards
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="agenda-list">
                            @foreach (var row in Model.Rows)
                            {
                                <div class="agenda-row">
                                    <div class="agenda-row-head">
                                        <div>
                                            <h2 class="agenda-row-title">@row.Title</h2>
                                            <div class="small text-muted">
                                                @Html.WallClock(row.Date.ToDateTime(TimeOnly.MinValue), "weekday-short")
                                                @if (row.StartTime.HasValue)
                                                {
                                                    @:&middot; @Html.WallClock(row.Date.ToDateTime(row.StartTime.Value), "time-24h")
                                                }
                                            </div>
                                        </div>
                                        <div class="agenda-row-board">
                                            <span class="fw-semibold">@row.BoardName</span>
                                            @if (row.BoardType == BoardType.Campaign)
                                            {
                                                <span class="badge bg-info text-dark"><i class="fas fa-book-open me-1" aria-hidden="true"></i>Campaign</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary"><i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>One-Shot</span>
                                            }
                                            @if (row.IsActiveBoard)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-check-circle me-1" aria-hidden="true"></i>Active
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="mt-2 d-flex align-items-center gap-2">
                                        <span class="small text-muted">Your answer:</span>
                                        @await Html.PartialAsync("~/Views/Events/_AvailabilityCell.cshtml", row.MyCell)
                                    </div>

                                    <div class="agenda-roster mt-2">
                                        <span class="small text-muted me-1">Roster:</span>
                                        @foreach (var member in row.Roster)
                                        {
                                            <span class="agenda-roster-entry">
                                                <span class="small @(member.IsViewer ? "fw-semibold" : "")">
                                                    @member.Name@(member.IsViewer ? " (you)" : "")
                                                </span>
                                                @await Html.PartialAsync("~/Views/Events/_AvailabilityCell.cshtml", member.Cell)
                                            </span>
                                        }
                                    </div>

                                    <hr class="my-2" />
                                    <div class="text-end">
                                        @if (row.IsActiveBoard)
                                        {
                                            <a asp-controller="Events" asp-action="Details" asp-route-id="@row.EventId" asp-route-from="agenda"
                                               class="btn btn-info btn-sm">
                                                <i class="fas fa-arrow-right me-1" aria-hidden="true"></i>Open Event
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-info btn-sm"
                                                    data-bs-toggle="modal" data-bs-target="#switchBoardModal"
                                                    data-group-id="@row.BoardId"
                                                    data-board-name="@row.BoardName"
                                                    data-return-url="@Url.Action("Details", "Events", new { id = row.EventId, from = "agenda" })">
                                                <i class="fas fa-right-left me-1" aria-hidden="true"></i>Switch &amp; Open
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (Model.CanShowMore)
                        {
                            <div class="text-center mt-3">
                                <a href="@Url.Action("Index", new { take = Model.NextTake, boards = Model.SelectedBoardIds })"
                                   class="btn btn-secondary">
                                    <i class="fas fa-chevron-down me-2" aria-hidden="true"></i>Show More Events
                                </a>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (hasOtherBoardRow)
{
    <div class="modal fade" id="switchBoardModal" tabindex="-1"
         aria-labelledby="switchBoardModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="switchBoardForm" asp-controller="GroupPicker" asp-action="SelectGroup" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="groupId" id="switchBoardGroupId" />
                    <input type="hidden" name="returnUrl" id="switchBoardReturnUrl" />
                    <div class="modal-header">
                        <h2 class="modal-title" id="switchBoardModalLabel">
                            <i class="fas fa-right-left me-2" aria-hidden="true"></i>
                            Switch to <span id="switchBoardName"></span>?
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (Model.ActiveBoardName != null)
                        {
                            <p class="mb-0">
                                Your active board is currently <strong>@Model.ActiveBoardName</strong>.
                                Switching to <strong id="switchBoardNameInline"></strong> will change what you
                                see everywhere else in the app -- quests, shop, gold, characters, and navigation
                                will all reflect it until you switch again.
                            </p>
                        }
                        else
                        {
                            <p class="mb-0">
                                You have no active board selected right now. Switching to
                                <strong id="switchBoardNameInline"></strong> will change what you see everywhere
                                else in the app -- quests, shop, gold, characters, and navigation will all reflect
                                it until you switch again.
                            </p>
                        }
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-right-left me-2" aria-hidden="true"></i>Switch &amp; Continue
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script type="module" src="~/js/agenda.js" asp-append-version="true"></script>
}
