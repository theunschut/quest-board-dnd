@using QuestBoard.Domain.Enums
@using QuestBoard.Service.ViewModels.CharacterViewModels
@using QuestBoard.Service.ViewModels.Shared
@model CharacterViewModel
@{
    ViewData["Title"] = "Create New Character";
}

<div class="character-form-page form-page">
    <div class="card modern-card">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">
                <i class="fas fa-plus me-2" aria-hidden="true"></i>
                Create New Character
            </h1>
        </div>
        <div class="card-body modern-card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="OwnerId" />

                <div asp-validation-summary="All" class="mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="ProfilePictureFile" class="form-label">Profile Picture</label>
                        <input type="file" asp-for="ProfilePictureFile" class="form-control" accept="image/*" id="profilePictureInput" data-crop-input data-crop-output-name="CroppedPictureFile" data-crop-aspect-ratio="1" />
                        <input type="file" name="CroppedPictureFile" hidden />
                        <small class="form-text">Upload a character portrait (JPG, PNG, GIF - Max 5 MB)</small>
                        <span asp-validation-for="ProfilePictureFile"></span>
                        <div id="fileSizeError" class="crop-error" role="alert" hidden><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span data-crop-error-text></span></div>
                    </div>

                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Character Name <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter character name" />
                            <span asp-validation-for="Name"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Level" class="form-label">Level <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                                <input asp-for="Level" type="number" class="form-control" min="1" max="20" />
                                <span asp-validation-for="Level"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label">Status</label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<CharacterStatus>()" class="form-select"></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Role</label>
                            <select asp-for="Role" asp-items="Html.GetEnumSelectList<CharacterRole>()" class="form-select"></select>
                            <small class="form-text">Set as Main to make this your primary character</small>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Classes <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                    <small class="form-text d-block mb-2">
                        Add one or more classes. Total class levels must equal character level.
                    </small>
                    @{ await Html.RenderPartialAsync("_CharacterClassRows", Model); }
                </div>

                <div class="mb-3">
                    <label asp-for="SheetLink" class="form-label">Character Sheet Link</label>
                    <input asp-for="SheetLink" type="url" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="SheetLink"></span>
                </div>

                @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                   {
                       FieldName = "Description",
                       Value = Model.Description,
                       Label = "Description",
                       Required = false,
                       Placeholder = "Brief character description..."
                   }); }

                @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                   {
                       FieldName = "Backstory",
                       Value = Model.Backstory,
                       Label = "Backstory",
                       Required = false,
                       Placeholder = "Character backstory..."
                   }); }

                <hr />

                <div class="form-actions form-actions--stack">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Create Character
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_ImageCropDialog" />

@section Styles {
    <link rel="stylesheet" href="~/css/character-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/image-crop.css" asp-append-version="true" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script type="module" src="~/js/character-form.js" asp-append-version="true"></script>
    <script src="~/lib/cropperjs-2.1.1/cropper.min.js"></script>
    <script type="module" src="~/js/image-crop.js" asp-append-version="true"></script>
}
