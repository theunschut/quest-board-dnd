@using QuestBoard.Domain.Enums
@using QuestBoard.Service.ViewModels.CharacterViewModels
@model CharactersIndexViewModel
@{
    ViewData["Title"] = "Characters";
}

@section Styles {
    <link rel="stylesheet" href="~/css/member-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/characters.css" asp-append-version="true" />
}

<div class="characters-page">
    <div class="card modern-card mb-4">
        <div class="card-header modern-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h1 class="mb-0">
                <i class="fas fa-people-group me-2" aria-hidden="true"></i>Characters
            </h1>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus me-2" aria-hidden="true"></i>Create New Character
            </a>
        </div>
    </div>

    <section class="card modern-card modern-card--aside characters-section mb-4" aria-labelledby="my-characters-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="my-characters-title">
                <i class="fas fa-user-circle me-2" aria-hidden="true"></i>My Characters
            </h2>
        </div>
        <div class="card-body modern-card-body">
            @if (Model.MyCharacters.Any())
            {
                <div class="member-grid">
                    @foreach (var character in Model.MyCharacters)
                    {
                        var statusClass = character.Status == CharacterStatus.Dead ? " member-card--dead" : character.Status == CharacterStatus.Retired ? " member-card--retired" : string.Empty;
                        <div class="character-card member-card modern-card modern-card--interactive@(statusClass)">
                            <div class="member-card-media">
                                @if (character.HasProfilePicture)
                                {
                                    <img class="member-card-image" src="@Url.Action("GetCroppedPicture", new { id = character.Id })" alt="" />
                                }
                                else
                                {
                                    <div class="member-card-placeholder" aria-hidden="true">
                                        <i class="fas fa-user fa-3x"></i>
                                    </div>
                                }
                                @if (character.Role == CharacterRole.Main || character.Status != CharacterStatus.Active)
                                {
                                    <div class="member-card-badges">
                                        @if (character.Role == CharacterRole.Main)
                                        {
                                            <span class="badge badge-main"><i class="fas fa-star me-1" aria-hidden="true"></i>Main</span>
                                        }
                                        @if (character.Status == CharacterStatus.Dead)
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-skull me-1" aria-hidden="true"></i>Dead</span>
                                        }
                                        @if (character.Status == CharacterStatus.Retired)
                                        {
                                            <span class="badge bg-info"><i class="fas fa-moon me-1" aria-hidden="true"></i>Retired</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="member-card-body">
                                <h3 class="member-card-name"><a class="row-nav-link" href="@Url.Action("Details", new { id = character.Id })">@character.Name</a></h3>
                                <p class="member-card-line member-card-line--strong">@string.Join(" / ", character.Classes.Select(c => $"{c.Class} {c.ClassLevel}"))</p>
                                <p class="member-card-line"><i class="fas fa-shield-alt me-1" aria-hidden="true"></i>Level @character.Level</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-users-slash empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Characters Yet</h2>
                    <p class="empty-state-text">Create your first character to get started!</p>
                    <a href="@Url.Action("Create")" class="btn btn-secondary">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Create Character
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="card modern-card modern-card--aside characters-section mb-4" aria-labelledby="roster-title">
        <div class="card-header modern-card-header">
            <h2 class="mb-0" id="roster-title">
                <i class="fas fa-users me-2" aria-hidden="true"></i>Character Roster
            </h2>
        </div>
        <div class="card-body modern-card-body">
            @if (Model.OtherCharacters.Any())
            {
                <div class="member-grid">
                    @foreach (var character in Model.OtherCharacters)
                    {
                        var statusClass = character.Status == CharacterStatus.Dead ? " member-card--dead" : character.Status == CharacterStatus.Retired ? " member-card--retired" : string.Empty;
                        <div class="character-card member-card modern-card modern-card--interactive@(statusClass)">
                            <div class="member-card-media">
                                @if (character.HasProfilePicture)
                                {
                                    <img class="member-card-image" src="@Url.Action("GetCroppedPicture", new { id = character.Id })" alt="" />
                                }
                                else
                                {
                                    <div class="member-card-placeholder" aria-hidden="true">
                                        <i class="fas fa-user fa-3x"></i>
                                    </div>
                                }
                                @if (character.Status != CharacterStatus.Active)
                                {
                                    <div class="member-card-badges">
                                        @if (character.Status == CharacterStatus.Dead)
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-skull me-1" aria-hidden="true"></i>Dead</span>
                                        }
                                        @if (character.Status == CharacterStatus.Retired)
                                        {
                                            <span class="badge bg-info"><i class="fas fa-moon me-1" aria-hidden="true"></i>Retired</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="member-card-body">
                                <h3 class="member-card-name"><a class="row-nav-link" href="@Url.Action("Details", new { id = character.Id })">@character.Name</a></h3>
                                <p class="member-card-line member-card-line--strong">@string.Join(" / ", character.Classes.Select(c => $"{c.Class} {c.ClassLevel}"))</p>
                                <p class="member-card-line"><i class="fas fa-shield-alt me-1" aria-hidden="true"></i>Level @character.Level</p>
                                <p class="member-card-line"><i class="fas fa-user me-1" aria-hidden="true"></i>@character.OwnerName</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-dungeon empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Other Characters</h2>
                    <p class="empty-state-text">No other adventurers have created characters yet!</p>
                </div>
            }
        </div>
    </section>
</div>
