@using QuestBoard.Service.ViewModels.ContactViewModels
@model ContactsIndexViewModel
@{
    ViewData["Title"] = "Contacts";

    // Read once so the header controls and the filter row below share a single evaluation of
    // the audience gate rather than two independently derived checks.
    var viewerIsDmTier = Model.ViewerIsDmTier;

    void RenderContactCard(ContactViewModel contact)
    {
        <div class="contact-card member-card modern-card modern-card--interactive">
            <div class="member-card-media">
                @if (contact.HasContactImage)
                {
                    <img class="member-card-image" src="@Url.Action("GetCroppedContactImage", new { id = contact.Id })" alt="" />
                }
                else
                {
                    <div class="member-card-placeholder" aria-hidden="true">
                        <i class="fas fa-user fa-3x"></i>
                    </div>
                }
                @if (!contact.IsRevealed)
                {
                    <div class="member-card-badges">
                        <span class="badge bg-secondary"><i class="fas fa-eye-slash me-1" aria-hidden="true"></i>Hidden</span>
                    </div>
                }
            </div>
            <div class="member-card-body">
                <h3 class="member-card-name"><a class="row-nav-link" href="@Url.Action("Details", new { id = contact.Id })">@contact.Name</a></h3>
                @if (!string.IsNullOrEmpty(contact.TownCity))
                {
                    <p class="member-card-line"><i class="fas fa-map-marker-alt me-1" aria-hidden="true"></i>@contact.TownCity</p>
                }
                @if (!string.IsNullOrEmpty(contact.SubLocation))
                {
                    <p class="member-card-line">@contact.SubLocation</p>
                }
                @if (viewerIsDmTier && contact.Tags.Any())
                {
                    <div class="member-card-tags">
                        @foreach (var tag in contact.Tags)
                        {
                            <span class="contact-tag-chip badge bg-secondary">@tag.Name</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/member-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contacts.css" asp-append-version="true" />
}

<div class="contacts-page">
    <div class="card modern-card mb-4">
        <div class="card-header modern-card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h1 class="mb-0">
                <i class="fas fa-address-book me-2" aria-hidden="true"></i>Contacts
            </h1>
            @if (viewerIsDmTier)
            {
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="ToggleShowHidden" method="post">
                        @foreach (var selectedTagId in Model.SelectedTagIds)
                        {
                            <input type="hidden" name="tag" value="@selectedTagId" />
                        }
                        @if (Model.ShowHidden)
                        {
                            <button type="submit" class="btn btn-secondary" aria-pressed="true">
                                <i class="fas fa-eye me-2" aria-hidden="true"></i>Hide Hidden
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-secondary" aria-pressed="false">
                                <i class="fas fa-eye-slash me-2" aria-hidden="true"></i>Show Hidden
                            </button>
                        }
                    </form>
                    <a href="@Url.Action("Index", "ContactCategoryManagement")" class="btn btn-secondary">
                        <i class="fas fa-tags me-2" aria-hidden="true"></i>Manage Categories
                    </a>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Contact
                    </a>
                </div>
            }
        </div>
        @if (viewerIsDmTier && Model.AvailableTags.Any())
        {
            <div class="card-body modern-card-body">
                <form method="get" action="@Url.Action("Index")" class="contact-filter-row">
                    <span class="contact-filter-label">Tags:</span>
                    <div class="contact-filter-tag-group">
                        @foreach (var availableTag in Model.AvailableTags)
                        {
                            <label class="contact-filter-check-label">
                                <input class="form-check-input m-0" type="checkbox" name="tag" value="@availableTag.Id" checked="@(Model.SelectedTagIds.Contains(availableTag.Id))" />
                                @availableTag.Name
                            </label>
                        }
                    </div>
                    <button type="submit" class="btn btn-secondary btn-sm contact-filter-apply-btn">
                        <i class="fas fa-filter me-2" aria-hidden="true"></i>Apply Filters
                    </button>
                    @if (Model.HasActiveFilters)
                    {
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm contact-filter-clear-btn">
                            <i class="fas fa-times me-2" aria-hidden="true"></i>Clear Filters
                        </a>
                    }
                </form>
            </div>
        }
    </div>

    @if (Model.HasCategories && Model.Contacts.Any())
    {
        @foreach (var (group, index) in Model.CategoryGroups.Select((g, i) => (g, i)))
        {
            <section class="card modern-card modern-card--aside contacts-group" aria-labelledby="contact-group-@index">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0" id="contact-group-@index"><i class="fas fa-tag me-2" aria-hidden="true"></i>@group.Title</h2>
                </div>
                <div class="card-body modern-card-body">
                    <div class="member-grid">
                        @foreach (var contact in group.Contacts)
                        {
                            RenderContactCard(contact);
                        }
                    </div>
                </div>
            </section>
        }
    }
    else if (Model.Contacts.Any())
    {
        <section class="card modern-card modern-card--aside contacts-group" aria-label="Contacts">
            <div class="card-body modern-card-body">
                <div class="member-grid">
                    @foreach (var contact in Model.Contacts)
                    {
                        RenderContactCard(contact);
                    }
                </div>
            </div>
        </section>
    }
    else if (Model.HasActiveFilters)
    {
        <div class="card modern-card modern-card--aside">
            <div class="card-body modern-card-body">
                <div class="empty-state">
                    <i class="fas fa-filter empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No contacts match your filters</h2>
                    <p class="empty-state-text">Try selecting different tags.</p>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times me-2" aria-hidden="true"></i>Clear filters
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card modern-card modern-card--aside">
            <div class="card-body modern-card-body">
                <div class="empty-state">
                    <i class="fas fa-address-book empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Contacts Yet</h2>
                    <p class="empty-state-text">No one has added a contact yet. DMs can create the first one to start building out the world.</p>
                </div>
            </div>
        </div>
    }
</div>
