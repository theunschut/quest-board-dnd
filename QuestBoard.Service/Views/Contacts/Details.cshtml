@using QuestBoard.Service.Extensions
@using QuestBoard.Service.ViewModels.ContactViewModels
@using QuestBoard.Service.ViewModels.Shared
@model ContactViewModel
@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/markdown-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact-detail.css" asp-append-version="true" />
}

@* One view for both layouts. The title card, the Actions card, the Description and the Notes come in the order a
   phone reads them; from the large breakpoint the title card and Actions sit in the left column and the Description
   and Notes in the right. *@
<div class="contact-detail-page">
    <div class="row">
        <div class="col-lg-4">
            <div class="card modern-card mb-3">
                <div class="card-header modern-card-header">
                    <h1 class="mb-0">@Model.Name</h1>
                </div>
                <div class="card-body modern-card-body text-center">
                    @if (Model.HasContactImage)
                    {
                        <img src="@Url.Action("GetContactImage", new { id = Model.Id })" alt="" class="contact-detail-portrait" />
                    }
                    else
                    {
                        <div class="contact-detail-portrait contact-detail-portrait--placeholder" aria-hidden="true">
                            <i class="fas fa-user fa-5x"></i>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.TownCity))
                    {
                        <p class="contact-info-value"><i class="fas fa-map-marker-alt me-1" aria-hidden="true"></i>@Model.TownCity</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.SubLocation))
                    {
                        <p class="contact-info-value">@Model.SubLocation</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.CategoryName))
                    {
                        <p class="contact-info-value"><i class="fas fa-tag me-1" aria-hidden="true"></i>@Model.CategoryName</p>
                    }
                    @if (!Model.IsRevealed)
                    {
                        <p class="contact-info-value">
                            <span class="badge bg-secondary">
                                <i class="fas fa-eye-slash me-1" aria-hidden="true"></i>Hidden
                            </span>
                        </p>
                    }
                    @if (Model.CanManage && Model.Tags.Any())
                    {
                        <p class="contact-info-value contact-tag-list">
                            <i class="fas fa-tags me-1" aria-hidden="true"></i>
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="contact-tag-chip badge bg-secondary">@tag.Name</span>
                            }
                        </p>
                    }
                </div>
            </div>

            @if (Model.CanManage)
            {
                <section class="card modern-card modern-card--aside mb-3" aria-labelledby="actions-title">
                    <div class="card-header modern-card-header">
                        <h2 class="mb-0" id="actions-title"><i class="fas fa-cog me-2" aria-hidden="true"></i>Actions</h2>
                    </div>
                    <div class="card-body modern-card-body">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning w-100 mb-2">
                            <i class="fas fa-pen me-2" aria-hidden="true"></i>Edit Contact
                        </a>
                        <form asp-action="ToggleReveal" method="post" class="mb-2">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @if (!Model.IsRevealed)
                            {
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-eye me-2" aria-hidden="true"></i>Reveal Contact
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-secondary w-100">
                                    <i class="fas fa-eye-slash me-2" aria-hidden="true"></i>Hide Contact
                                </button>
                            }
                        </form>
                        <form asp-action="Delete" method="post" data-confirm-message="Are you sure you want to delete this contact? This action cannot be undone.">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="fas fa-trash me-2" aria-hidden="true"></i>Delete Contact
                            </button>
                        </form>
                    </div>
                </section>
            }
        </div>

        <div class="col-lg-8">
            <section class="card modern-card modern-card--aside mb-3" aria-labelledby="description-title">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0" id="description-title"><i class="fas fa-scroll me-2" aria-hidden="true"></i>Description</h2>
                </div>
                <div class="card-body modern-card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Markdown(Model.Description)
                    }
                    else
                    {
                        <p class="mb-0">No description provided.</p>
                    }
                </div>
            </section>

            <section id="notes-card" class="card modern-card modern-card--aside mb-3" aria-labelledby="notes-title">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0" id="notes-title"><i class="fas fa-comment me-2" aria-hidden="true"></i>Notes</h2>
                </div>
                <div class="card-body modern-card-body">
                    <form asp-action="AddNote" method="post" class="notes-form form-page">
                        <input type="hidden" name="contactId" value="@Model.Id" />
                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "Text",
                               Value = null,
                               Label = "Add a Note",
                               Required = true,
                               Placeholder = "Add a note about this contact..."
                           }); }
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Note
                            </button>
                        </div>
                    </form>

                    @if (Model.Notes.Any())
                    {
                        <ul class="notes-list">
                            @foreach (var note in Model.Notes)
                            {
                                <li class="notes-slip" data-note-id="@note.Id">
                                    <div class="notes-meta">
                                        <i class="fas fa-user me-1" aria-hidden="true"></i>@note.AuthorName
                                        <span class="ms-2"><i class="fas fa-clock me-1" aria-hidden="true"></i>@Html.LocalTime(note.CreatedAt, "date-time")</span>
                                        @if (note.UpdatedAt != null)
                                        {
                                            <span class="ms-2">(edited)</span>
                                        }
                                    </div>
                                    <div class="notes-text">
                                        @Html.Markdown(note.Text)
                                        <div class="notes-actions">
                                            <button type="button" class="btn btn-warning btn-sm note-edit-btn" aria-label="Edit note">
                                                <i class="fas fa-pen" aria-hidden="true"></i>
                                            </button>
                                            <form asp-action="DeleteNote" method="post" class="d-inline" data-confirm-message="Delete this note? This action cannot be undone.">
                                                <input type="hidden" name="id" value="@note.Id" />
                                                <input type="hidden" name="contactId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm" aria-label="Delete note">
                                                    <i class="fas fa-trash" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <form asp-action="EditNote" method="post" class="notes-edit-form form-page" hidden>
                                        <input type="hidden" name="id" value="@note.Id" />
                                        <input type="hidden" name="contactId" value="@Model.Id" />
                                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                                           {
                                               FieldName = "Text",
                                               ElementId = $"Text_{note.Id}",
                                               Value = note.Text,
                                               Label = "Edit Note",
                                               Required = true
                                           }); }
                                        <div class="notes-actions">
                                            <button type="button" class="btn btn-secondary btn-sm note-cancel-btn">Cancel</button>
                                            <button type="submit" class="btn btn-success btn-sm">Save</button>
                                        </div>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-comment-slash empty-state-icon" aria-hidden="true"></i>
                            <h3 class="empty-state-heading">No Notes Yet</h3>
                            <p class="empty-state-text">Be the first to jot something down about this contact.</p>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>

    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Contacts
    </a>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script type="module" src="~/js/contact-notes.js" asp-append-version="true"></script>
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
}
