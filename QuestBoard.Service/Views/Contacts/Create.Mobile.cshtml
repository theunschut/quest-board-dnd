@using QuestBoard.Service.ViewModels.ContactViewModels
@using QuestBoard.Service.ViewModels.Shared
@model ContactViewModel
@{
    ViewData["Title"] = "Create New Contact";
}

@section Styles {
    <link rel="stylesheet" href="~/css/image-crop.css" asp-append-version="true" />
    <link href="~/css/contact-form.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-3 py-3">
    <div class="contact-form-card">
        <h4><i class="fas fa-plus me-2"></i>Create New Contact</h4>
        <hr class="mb-3" style="border-color: rgba(244,228,188,0.3);" />

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ContactImageFile" class="form-label">Contact Image</label>
                <input type="file" asp-for="ContactImageFile" class="form-control" accept="image/*" id="contactImageInput" data-crop-input data-crop-output-name="CroppedPictureFile" data-crop-aspect-ratio="1" />
                <input type="file" name="CroppedPictureFile" hidden />
                <small class="form-text">Upload a contact portrait (JPG, PNG, GIF - Max 5 MB)</small>
                <span asp-validation-for="ContactImageFile" class="text-danger"></span>
                <div id="fileSizeError" class="crop-error" role="alert" hidden><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span data-crop-error-text></span></div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Enter contact name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TownCity" class="form-label">Town/City</label>
                <input asp-for="TownCity" class="form-control" placeholder="e.g. Waterdeep" />
                <span asp-validation-for="TownCity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SubLocation" class="form-label">Sub-location</label>
                <input asp-for="SubLocation" class="form-control" placeholder="e.g. The Guilded Rose Smithy" />
                <span asp-validation-for="SubLocation" class="text-danger"></span>
            </div>

            <div class="mb-3 contact-tags-input">
                <label asp-for="TagsInput" class="form-label">Tags</label>
                <input asp-for="TagsInput" class="form-control" id="TagsInput" placeholder="Add a tag and press Enter…" />
                <span asp-validation-for="TagsInput" class="text-danger"></span>
                <small class="form-text text-muted">Optional — e.g. shopkeeper, quest giver</small>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Category</label>
                @if (Model.HasCategories)
                {
                    <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                        <option value="">— None —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                }
                else
                {
                    <select class="form-select" disabled>
                        <option>— None —</option>
                    </select>
                    <small class="form-text text-muted">
                        No categories yet.
                        <a asp-controller="ContactCategoryManagement" asp-action="Index">Manage Categories</a>
                        to create one.
                    </small>
                }
            </div>

            @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
               {
                   FieldName = "Description",
                   Value = Model.Description,
                   Label = "Description",
                   Required = false,
                   Placeholder = "Brief contact description"
               }); }

            <hr style="border-color: rgba(244,228,188,0.3);" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-plus me-2"></i>Create Contact
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<partial name="_ImageCropDialog" />

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script src="~/lib/cropperjs-2.1.1/cropper.min.js"></script>
    <script type="module" src="~/js/image-crop.js" asp-append-version="true"></script>
    <link href="~/lib/tagify-4.38.0/tagify.css" rel="stylesheet" />
    <script src="~/lib/tagify-4.38.0/tagify.min.js"></script>
    <script src="~/js/contact-tags.js" asp-append-version="true"></script>
    <script>
        initContactTags({ inputId: 'TagsInput', whitelist: @Html.Raw(Json.Serialize(Model.AvailableTagNames)) });
    </script>
}
