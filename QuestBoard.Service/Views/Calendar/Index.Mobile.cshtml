@using Microsoft.AspNetCore.Html
@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.CalendarViewModels
@model CalendarViewModel
@{
    ViewData["Title"] = "Quest Calendar";
    ViewBag.IsDetailsPage = false;
    var pages = await BoardPages.GetAsync();
    var prevMonth = Model.FirstDayOfMonth.AddMonths(-1);
    var nextMonth = Model.FirstDayOfMonth.AddMonths(1);
    var boardToday = (DateOnly)ViewBag.BoardToday;
    var agendaDays = Model.GetCalendarDays().Where(d => !d.IsEmpty && (d.QuestsOnDay.Any() || d.EventsOnDay.Any() || d.Linked.HasEntries)).ToList();
}
@section Styles {
    <link href="~/css/calendar.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
<div class="card modern-card agenda-page agenda-card-mobile">
    <div class="card-header modern-card-header">
        <h1><i class="fas fa-calendar-alt me-2" aria-hidden="true"></i>@ViewData["Title"]</h1>
    </div>
    <div class="card-body modern-card-body">

    @* Month navigation bar *@
    <nav class="agenda-month-nav" aria-label="Month">
        <a href="@Url.Action("Index", new { year = prevMonth.Year, month = prevMonth.Month })"
           class="btn btn-secondary calendar-nav-btn" aria-label="Previous month">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </a>
        <span class="agenda-month-name">@Model.MonthName</span>
        <a href="@Url.Action("Index", new { year = nextMonth.Year, month = nextMonth.Month })"
           class="btn btn-secondary calendar-nav-btn" aria-label="Next month">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </a>
    </nav>

    @* Names the other boards whose entries share this agenda. Board names only, never the
       name of the set, and nothing renders for a board with no linked boards. *@
    @if (Model.LinkedBoards.Count > 0)
    {
        <p class="agenda-linked-note"><i class="fas fa-link me-2" aria-hidden="true"></i>Also showing: @string.Join(", ", Model.LinkedBoards.Select(b => b.Name))</p>
    }

    <div class="d-grid gap-2 mb-3">
        @if ((await AuthorizationService.AuthorizeAsync(User, "DungeonMasterOnly")).Succeeded && pages.Serves(BoardPage.Events))
        {
            <a asp-controller="Events" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-calendar-check me-2"></i>Board Availability
            </a>
        }
        <a asp-controller="Agenda" asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-calendar-days me-2"></i>My Agenda
        </a>
    </div>

    @* Low-runway warning: a player has no action to take on a scheduling warning, so this
       block is gated to managers only, matching the desktop calendar's banner. *@
    @if (Model.CanManage && Model.SeriesBelowRunway.Any())
    {
        <div class="alert alert-warning mb-0" role="alert">
            @if (Model.SeriesBelowRunway.Count == 1)
            {
                var series = Model.SeriesBelowRunway[0];
                <text>The '</text><a class="alert-link" href="@Url.Action("Details", "Series", new { id = series.SeriesId })">@series.Title</a><text>' series is running low — only @series.UpcomingCount upcoming session(s) left. Visit its series page to check the cadence.</text>
            }
            else
            {
                <text>@Model.SeriesBelowRunway.Count recurring series are running low on upcoming sessions: </text>
                @for (var i = 0; i < Model.SeriesBelowRunway.Count; i++)
                {
                    var series = Model.SeriesBelowRunway[i];
                    <a class="alert-link" href="@Url.Action("Details", "Series", new { id = series.SeriesId })">@series.Title</a>
                    if (i < Model.SeriesBelowRunway.Count - 1)
                    {
                        <text>, </text>
                    }
                }
                <text>. Visit each series page to check its cadence.</text>
            }
        </div>
    }

    @* Agenda list: one section per day that has at least one quest or event *@
    @if (!agendaDays.Any())
    {
        @* Empty state stays month-neutral because this block now covers both quests and events *@
        <div class="text-center text-muted py-5">
            <i class="fas fa-calendar-alt fa-3x mb-3"></i>
            <h5>Nothing This Month</h5>
            <p>No quests or events are planned for @Model.MonthName. Check another month.</p>
        </div>
    }
    else
    {
        <div class="agenda-days">
        @foreach (var day in agendaDays)
        {
            <section class="agenda-day-section" aria-current="@(DateOnly.FromDateTime(day.Date) == boardToday ? "date" : null)">
                @* Day label: Saturday, June 14 (the sheet sets it in capitals) *@
                <div class="agenda-day-head">
                    <h2 class="agenda-day-label">@Html.WallClock(day.Date, "weekday-long")</h2>
                </div>
                @* Every entry is a slip with one stretched link, so the whole slip is the tap target and
                   no handler is needed. Events render first so the agenda groups a day the same way the
                   desktop day cell does; the time slot always prints something because a blank slot is
                   indistinguishable from a loading failure. *@
                <ul class="agenda-list">
                @foreach (var eventOnDay in day.EventsOnDay)
                {
                    var cancelledEvent = eventOnDay.Event.IsCancelled;
                    <li class="agenda-slip agenda-event-entry@(cancelledEvent ? " cancelled" : "")">
                        <div class="agenda-slip__head">
                            <span class="agenda-mark @(cancelledEvent ? "agenda-mark--cancelled" : "agenda-mark--event")" aria-hidden="true"><i class="fas @(cancelledEvent ? "fa-ban" : "fa-calendar-day")"></i></span>
                            <span class="visually-hidden">@(cancelledEvent ? "Cancelled." : "Event.")</span>
                            <span class="agenda-slip__title"><a class="row-nav-link" href="@Url.Action("Details", "Events", new { id = eventOnDay.Event.Id })">@eventOnDay.Event.Title</a></span>
                        </div>
                        <p class="agenda-slip__meta"><span class="agenda-time">@eventOnDay.TimeLabel</span></p>
                    </li>
                }
                @* Quest entries for this day: all quests, no cap *@
                @foreach (var questOnDay in day.QuestsOnDay)
                {
                    <li class="agenda-slip agenda-quest-entry @(questOnDay.IsFinalized ? "agenda-quest-finalized" : "agenda-quest-proposed")">
                        <div class="agenda-slip__head">
                            <span class="agenda-mark@(questOnDay.IsFinalized ? " agenda-mark--finalized" : "")" aria-hidden="true"><i class="fas @(questOnDay.IsFinalized ? "fa-circle-check" : "fa-hourglass-half")"></i></span>
                            <span class="visually-hidden">@(questOnDay.IsFinalized ? "Finalized." : "Proposed.")</span>
                            <span class="agenda-slip__title"><a class="row-nav-link" href="@Url.Action("Details", "Quest", new { id = questOnDay.Quest.Id })">@questOnDay.Quest.Title</a></span>
                        </div>
                        <p class="agenda-slip__meta"><span class="agenda-time">@Html.WallClock(questOnDay.ProposedDate.Date, "time-24h")</span></p>
                    </li>
                }
                @* Linked entries come after the board's own: events first, then quests. They are
                   read-only slips from other boards in the set, and keep the board name visible
                   as text because there is room for it on a phone. A slip links like the board's
                   own only when the viewer can open the details page. Otherwise it is a plain slip
                   with no link, no tab stop and no data attribute: either they are not a member of
                   the owning board, where the page would not open, or that board no longer offers
                   the page. *@
                @foreach (var eventOnDay in day.Linked.Events)
                {
                    var linkedEvent = eventOnDay.Entry;
                    var eventUrl = Url.Action("Details", "Events", new { id = linkedEvent.EventId });
                    <li class="agenda-slip agenda-linked-entry agenda-linked-entry--event@(linkedEvent.IsCancelled ? " agenda-linked-entry--cancelled" : "") @(linkedEvent.CanOpen ? "agenda-linked-entry--open" : "agenda-linked-entry--static")">
                        <div class="agenda-slip__head">
                            <span class="agenda-mark @(linkedEvent.IsCancelled ? "agenda-mark--cancelled" : "agenda-mark--event")" aria-hidden="true"><i class="fas @(linkedEvent.IsCancelled ? "fa-ban" : "fa-calendar-day")"></i></span>
                            <span class="visually-hidden">@(linkedEvent.IsCancelled ? "Cancelled." : "Event.")</span>
                            <span class="agenda-slip__title">@if (linkedEvent.CanOpen) {<a class="row-nav-link" href="@eventUrl">@linkedEvent.Title</a>} else {@linkedEvent.Title}</span>
                        </div>
                        <p class="agenda-slip__meta"><span class="agenda-time">@eventOnDay.TimeLabel</span></p>
                        <p class="agenda-slip__meta"><span class="agenda-linked-board"><i class="fas fa-link" aria-hidden="true"></i><strong>@linkedEvent.BoardName</strong></span></p>
                    </li>
                }
                @foreach (var questOnDay in day.Linked.Quests)
                {
                    var linkedQuest = questOnDay.Entry;
                    var questUrl = Url.Action("Details", "Quest", new { id = linkedQuest.QuestId });
                    <li class="agenda-slip agenda-linked-entry agenda-linked-entry--quest @(questOnDay.IsFinalized ? "agenda-linked-entry--finalized" : "agenda-linked-entry--proposed") @(linkedQuest.CanOpen ? "agenda-linked-entry--open" : "agenda-linked-entry--static")">
                        <div class="agenda-slip__head">
                            <span class="agenda-mark@(questOnDay.IsFinalized ? " agenda-mark--finalized" : "")" aria-hidden="true"><i class="fas @(questOnDay.IsFinalized ? "fa-circle-check" : "fa-hourglass-half")"></i></span>
                            <span class="visually-hidden">@(questOnDay.IsFinalized ? "Finalized." : "Proposed.")</span>
                            <span class="agenda-slip__title">@if (linkedQuest.CanOpen) {<a class="row-nav-link" href="@questUrl">@linkedQuest.Title</a>} else {@linkedQuest.Title}</span>
                        </div>
                        <p class="agenda-slip__meta"><span class="agenda-time">@questOnDay.TimeLabel</span></p>
                        <p class="agenda-slip__meta"><span class="agenda-linked-board"><i class="fas fa-link" aria-hidden="true"></i><strong>@linkedQuest.BoardName</strong> · @linkedQuest.DungeonMasterName</span></p>
                    </li>
                }
                </ul>
            </section>
        }
        </div>
    }

    </div>
</div>
</div>
