@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.QuestViewModels
@using QuestBoard.Service.ViewModels.Shared
@model EditQuestViewModel
@{
    ViewData["Title"] = $"Edit Quest: {Model.Quest.Title}";
    ViewData["BodyClass"] = "quest-form-page";
    var boardType = (BoardType)ViewBag.BoardType;
}

@section Styles {
    <link href="~/css/quest-form.css" asp-append-version="true" rel="stylesheet" />
}

<div class="quest-form-wrap">
    <div class="row">
        <div class="col-lg-8 col-md-7">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h1 class="mb-0">
                        <i class="fas fa-edit me-2" aria-hidden="true"></i>
                        @ViewData["Title"]
                    </h1>
                </div>
                <div class="card-body modern-card-body">
                    <div asp-validation-summary="All" class="mb-3"></div>
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Quest.Title" class="form-label">Quest Title <span class="text-danger" aria-hidden="true">*</span></label>
                            <input asp-for="Quest.Title" class="form-control" placeholder="Enter the quest title..." />
                            <span asp-validation-for="Quest.Title"></span>
                        </div>

                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "Quest.Description",
                               Value = Model.Quest.Description,
                               Label = "Description",
                               Required = true,
                               Placeholder = "Describe the quest, what players can expect, any special requirements..."
                           }); }

                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "Quest.Rewards",
                               Value = Model.Quest.Rewards,
                               Label = "Rewards",
                               Required = false,
                               Placeholder = "Describe the loot, gold, or other rewards for this quest..."
                           }); }

                        @if (boardType != BoardType.Campaign)
                        {
                            <div class="mb-3">
                                <label asp-for="Quest.ChallengeRating" class="form-label">Challenge Rating <span class="text-danger" aria-hidden="true">*</span></label>
                                <input asp-for="Quest.ChallengeRating" type="number" class="form-control" min="1" max="20" step="1" placeholder="Enter level (e.g., 1, 5, 10, 15)" aria-describedby="Quest_ChallengeRating-help" />
                                <div id="Quest_ChallengeRating-help" class="form-text">Enter the recommended player level for this quest (1-20). This helps players understand if the quest is appropriate for their character level.</div>
                                <span asp-validation-for="Quest.ChallengeRating"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Quest.TotalPlayerCount" class="form-label">Total Player Count <span class="text-danger" aria-hidden="true">*</span></label>
                                <input asp-for="Quest.TotalPlayerCount" inputmode="numeric" class="form-control" />
                                <span asp-validation-for="Quest.TotalPlayerCount"></span>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input asp-for="Quest.DungeonMasterSession" class="form-check-input" type="checkbox" aria-describedby="Quest_DungeonMasterSession-help" />
                                    <label asp-for="Quest.DungeonMasterSession" class="form-check-label">
                                        <i class="fas fa-crown me-2" aria-hidden="true"></i>Dungeon Master Session Only
                                    </label>
                                </div>
                                <div id="Quest_DungeonMasterSession-help" class="form-text">Check this box to make this quest visible only to Dungeon Masters and Admins. Regular players will not be able to see or sign up for this quest.</div>
                            </div>

                            @if (!Model.IsFinalized)
                            {
                                @if (Model.HasExistingSignups)
                                {
                                    <div class="alert alert-warning quest-form-dates-warning">
                                        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
                                        <strong>Note:</strong> Players have already signed up for this quest.
                                        Removing or significantly changing dates will notify affected players via email and remove their votes for those dates.
                                    </div>
                                }

                                <div class="mb-3">
                                    <div id="proposed-dates-label" class="form-label">Proposed Dates &amp; Times <span class="text-danger" aria-hidden="true">*</span></div>
                                    <div id="proposed-dates" role="group" aria-labelledby="proposed-dates-label">
                                        @{
                                            var sortedProposedDates = Model.Quest.ProposedDates.OrderBy(pd => pd).ToList();
                                        }
                                        @for (int i = 0; i < sortedProposedDates.Count; i++)
                                        {
                                            <div class="mb-3 proposed-date-item">
                                                <div class="form-label">Proposed Date @(i + 1)</div>
                                                <div class="input-group">
                                                    <div class="form-control-plaintext">@Html.WallClock(sortedProposedDates[i], "date-time")</div>
                                                    <input type="hidden" name="Quest.ProposedDates[@i]" value="@sortedProposedDates[i].ToString("yyyy-MM-ddTHH:mm")" />
                                                    <button type="button" class="btn btn-danger" data-action="remove-proposed-date" aria-label="Remove proposed date @(i + 1)">
                                                        <i class="fas fa-trash me-2" aria-hidden="true"></i>Remove
                                                    </button>
                                                </div>
                                                <span asp-validation-for="Quest.ProposedDates[i]"></span>
                                            </div>
                                        }
                                    </div>
                                    <button type="button" class="btn btn-secondary btn-sm" data-action="add-proposed-date" aria-describedby="proposed-dates-help">
                                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Another Date Option
                                    </button>
                                    <div id="proposed-dates-help" class="form-text">Provide multiple date/time options for players to vote on. At least one date is required.</div>
                                    <span asp-validation-for="Quest.ProposedDates"></span>
                                </div>
                            }
                        }

                        <hr>
                        <div class="d-flex justify-content-between quest-form-actions">
                            <a href="@Url.Action("Manage", "Quest", new { id = Model.Id })" class="btn btn-secondary">
                                <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2" aria-hidden="true"></i>Update Quest
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-5 mt-3 mt-md-0">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0">
                        <i class="fas fa-lightbulb me-2" aria-hidden="true"></i>
                        Quest Editing Tips
                    </h2>
                </div>
                <div class="card-body modern-card-body">
                    @if (!Model.IsFinalized)
                    {
                        <ul class="list-unstyled mb-0 quest-form-tips">
                            <li class="mb-2">
                                <i class="fas fa-check me-2" aria-hidden="true"></i>
                                Existing dates cannot be edited, only removed
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check me-2" aria-hidden="true"></i>
                                Add new dates if you need different times
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check me-2" aria-hidden="true"></i>
                                Removed dates clear associated player votes
                            </li>
                            <li>
                                <i class="fas fa-check me-2" aria-hidden="true"></i>
                                Players can vote on new dates after changes
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0 quest-form-tips">
                            <li>
                                <i class="fas fa-check me-2" aria-hidden="true"></i>
                                The proposed and selected dates for a finalized quest cannot be changed here — use Open Quest if you need to change the dates or re-run signups.
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_QuestFormScripts"); }
}
