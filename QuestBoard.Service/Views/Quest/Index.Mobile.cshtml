@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Extensions
@using QuestBoard.Domain.Interfaces
@using QuestBoard.Domain.Models.QuestBoard
@model IEnumerable<Quest>
@{
    ViewData["Title"] = "Quest Board";
    ViewData["BodyClass"] = "home-page";
    var currentUserId = ViewBag.CurrentUserId as int?;
    var boardType = (BoardType)ViewBag.BoardType;
    var boardToday = (DateOnly)ViewBag.BoardToday;
}
@section Styles {
    <link href="~/css/home.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
    <h1 class="visually-hidden">Quest Board</h1>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-scroll empty-state-icon" aria-hidden="true"></i>
            <h2 class="empty-state-heading">No Quests Available</h2>
            <p class="empty-state-text">Check back soon — a Dungeon Master may post a quest at any time.</p>
        </div>
    }
    else
    {
        <div class="quest-list-mobile">
            @foreach (var quest in Model)
            {
                var isUserSignedUp = currentUserId.HasValue
                    && quest.PlayerSignups.Any(ps => ps.Player.Id == currentUserId.Value);

                var navUrl = currentUserId.HasValue && currentUserId.Value == quest.DungeonMaster?.Id
                    ? Url.Action("Manage", "Quest", new { id = quest.Id })
                    : Url.Action("Details", "Quest", new { id = quest.Id });

                var dmName = string.IsNullOrWhiteSpace(quest.DungeonMaster?.Name) ? "Unknown DM" : quest.DungeonMaster!.Name;
                var finalizedWithDate = boardType != BoardType.Campaign && quest.IsFinalized && quest.FinalizedDate.HasValue;

                string statusBadge;
                string statusIcon;
                string statusText;

                if (boardType == BoardType.Campaign)
                {
                    if (quest.IsClosed)
                    {
                        statusBadge = "bg-secondary";
                        statusIcon = "fas fa-flag-checkered";
                        statusText = "Closed";
                    }
                    else
                    {
                        statusBadge = "bg-success";
                        statusIcon = "fas fa-clock";
                        statusText = "Open";
                    }
                }
                else if (quest.HasBeenPlayed(boardToday))
                {
                    statusBadge = "bg-secondary";
                    statusIcon = "fas fa-flag-checkered";
                    statusText = "Done";
                }
                else if (quest.IsFinalized)
                {
                    statusBadge = "bg-primary";
                    statusIcon = "fas fa-check-circle";
                    statusText = "Finalized";
                }
                else
                {
                    statusBadge = "bg-success";
                    statusIcon = "fas fa-clock";
                    statusText = "Open";
                }
                <div class="quest-card-mobile modern-card modern-card--interactive">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2 class="quest-card-title"><a class="row-nav-link" href="@navUrl">@quest.Title</a></h2>
                        <div class="d-flex flex-column align-items-end gap-1">
                            <span class="badge @statusBadge flex-shrink-0">
                                <i class="@statusIcon me-1" aria-hidden="true"></i>@statusText
                            </span>
                            @if (isUserSignedUp)
                            {
                                <span class="badge bg-success flex-shrink-0">
                                    <i class="fas fa-check me-1" aria-hidden="true"></i>Signed up
                                </span>
                            }
                        </div>
                    </div>

                    <div class="quest-card-meta">
                        <p class="quest-card-line">
                            <i class="fas fa-crown me-1" aria-hidden="true"></i><strong>DM:</strong> @dmName
                        </p>
                        @if (finalizedWithDate)
                        {
                            <p class="quest-card-line">
                                <i class="fas fa-calendar-check me-1" aria-hidden="true"></i><strong>Quest Date:</strong> @Html.WallClock(quest.FinalizedDate!.Value, "date-time")
                            </p>
                            <p class="quest-card-line">
                                <i class="fas fa-users me-1" aria-hidden="true"></i><strong>Selected Adventurers:</strong> @quest.PlayerSignups.Count(ps => ps.IsSelected)
                            </p>
                        }
                        else if (boardType != BoardType.Campaign)
                        {
                            <p class="quest-card-line">
                                <i class="fas fa-users me-1" aria-hidden="true"></i><strong>Adventurers signed up:</strong> @quest.PlayerSignups.Count()
                            </p>
                        }
                        @if (boardType != BoardType.Campaign)
                        {
                            <span class="badge bg-dark border quest-card-cr">
                                <i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>CR @quest.ChallengeRating
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
