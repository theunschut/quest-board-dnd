@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.QuestViewModels
@using QuestBoard.Service.ViewModels.Shared
@model QuestViewModel
@{
    ViewData["Title"] = "Create Quest";
    ViewData["BodyClass"] = "quest-form-page";
    var boardType = (BoardType)ViewBag.BoardType;
}

@section Styles {
    <link href="~/css/quest-form.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/dm-create.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
    <div class="card modern-card dm-create-card-mobile mb-3">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">
                <i class="fas fa-scroll me-2" aria-hidden="true"></i>
                Create New Quest
            </h1>
        </div>
        <div class="card-body modern-card-body">
            <div asp-validation-summary="All" class="mb-3"></div>

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Quest Title <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter the quest title..." />
                    <span asp-validation-for="Title"></span>
                </div>

                @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                   {
                       FieldName = "Description",
                       Value = Model.Description,
                       Label = "Description",
                       Required = true,
                       Placeholder = "Describe the quest, what players can expect, any special requirements..."
                   }); }

                @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                   {
                       FieldName = "Rewards",
                       Value = Model.Rewards,
                       Label = "Rewards",
                       Required = false,
                       Placeholder = "Describe the loot, gold, or other rewards for this quest..."
                   }); }

                @if (boardType != BoardType.Campaign)
                {
                    <div class="mb-3">
                        <label asp-for="ChallengeRating" class="form-label">Challenge Rating <span class="text-danger" aria-hidden="true">*</span></label>
                        <input asp-for="ChallengeRating" type="number" class="form-control"
                               min="1" max="20" step="1" placeholder="Enter level (e.g., 1, 5, 10, 15)" aria-describedby="ChallengeRating-help" />
                        <div id="ChallengeRating-help" class="form-text">Enter the recommended player level for this quest (1-20). This helps players understand if the quest is appropriate for their character level.</div>
                        <span asp-validation-for="ChallengeRating"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TotalPlayerCount" class="form-label">Total Player Count <span class="text-danger" aria-hidden="true">*</span></label>
                        <input asp-for="TotalPlayerCount" inputmode="numeric" class="form-control" />
                        <span asp-validation-for="TotalPlayerCount"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="DungeonMasterSession" class="form-check-input" type="checkbox" aria-describedby="DungeonMasterSession-help" />
                            <label asp-for="DungeonMasterSession" class="form-check-label">
                                <i class="fas fa-crown me-2" aria-hidden="true"></i>Dungeon Master Session Only
                            </label>
                        </div>
                        <div id="DungeonMasterSession-help" class="form-text">Check this box to make this quest visible only to Dungeon Masters and Admins. Regular players will not be able to see or sign up for this quest.</div>
                    </div>

                    <div class="mb-3">
                        <div id="proposed-dates-label" class="form-label">Proposed Dates &amp; Times <span class="text-danger" aria-hidden="true">*</span></div>
                        <div id="proposed-dates" role="group" aria-labelledby="proposed-dates-label">
                            @for (int i = 0; i < Model.ProposedDates.Count; i++)
                            {
                                <div class="mb-3 proposed-date-item">
                                    <label asp-for="ProposedDates[i]" class="form-label">Proposed Date @(i + 1)</label>
                                    <div class="input-group">
                                        <input asp-for="ProposedDates[i]" type="datetime-local"
                                               class="form-control" required step="60" />
                                        <button type="button" class="btn btn-danger" data-action="remove-proposed-date" aria-label="Remove proposed date @(i + 1)">
                                            <i class="fas fa-trash me-2" aria-hidden="true"></i>Remove
                                        </button>
                                    </div>
                                    <span asp-validation-for="ProposedDates[i]"></span>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" data-action="add-proposed-date" aria-describedby="proposed-dates-help">
                            <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Another Date Option
                        </button>
                        <div id="proposed-dates-help" class="form-text">Provide multiple date/time options for players to vote on. At least one date is required.</div>
                        <span asp-validation-for="ProposedDates"></span>
                    </div>
                }

                <hr>
                <div class="d-flex justify-content-between quest-form-actions">
                    <a href="@Url.Action("Index", "Quest")" class="btn btn-secondary">
                        <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Create Quest
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_QuestFormScripts"); }
}
