@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Models.QuestBoard
@model IEnumerable<Quest>
@{
    ViewData["Title"] = "Quest Board";
    ViewData["BodyClass"] = "home-page";
    var boardType = (BoardType)ViewBag.BoardType;
    var campaign = boardType == BoardType.Campaign;
    var currentUserId = ViewBag.CurrentUserId as int?;
    var quests = Model.ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/quests.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/quest-board.js" asp-append-version="true"></script>
}

<h1 class="visually-hidden">Quest Board</h1>

@if (quests.Count == 0)
{
    <h2 class="visually-hidden">No quests available</h2>
}
else
{
    <div class="quest-board-container">
        @foreach (var quest in quests)
        {
            var dmName = quest.DungeonMaster?.Name;
            var finalizedWithDate = !campaign && quest.IsFinalized && quest.FinalizedDate.HasValue;
            var pick = QuestPosterPicker.Pick(quest.Id, quest.Title, dmName, finalizedWithDate, campaign);

            var isSignedUp = currentUserId.HasValue
                && quest.PlayerSignups.Any(ps => ps.Player.Id == currentUserId.Value);

            var navUrl = currentUserId.HasValue && currentUserId.Value == quest.DungeonMaster?.Id
                ? Url.Action("Manage", "Quest", new { id = quest.Id })
                : Url.Action("Details", "Quest", new { id = quest.Id });

            var status = campaign
                ? (quest.IsClosed ? "closed" : "open")
                : (quest.IsFinalized ? "finalized" : "open");
            var statusSeal = campaign || quest.IsFinalized;
            var sealFile = Uri.EscapeDataString(pick.Seal);
            var titleClass = pick.TitleTier == 2 ? "quest-poster-title quest-poster-title--tier2" : "quest-poster-title";

            <article class="quest-poster @pick.Poster.CssClass">
                @if (statusSeal)
                {
                    <picture class="quest-poster-seal">
                        <source type="image/webp" srcset="/images/Wax%20Seals/@(sealFile).webp" />
                        <img src="/images/Wax%20Seals/@(sealFile).png" alt="" width="80" height="80" />
                    </picture>
                }
                @if (isSignedUp)
                {
                    <picture class="quest-poster-seal quest-poster-seal--signed-up">
                        <source type="image/webp" srcset="/images/Wax%20Seals/@(sealFile).webp" />
                        <img src="/images/Wax%20Seals/@(sealFile).png" alt="" width="80" height="80" />
                    </picture>
                }
                <div class="quest-poster-text">
                    <h2 class="@titleClass">
                        <a class="row-nav-link" href="@navUrl">@quest.Title<span class="visually-hidden">, @status@(isSignedUp ? ", signed up" : "")</span></a>
                    </h2>
                    <div class="quest-poster-meta">
                        @if (finalizedWithDate)
                        {
                            <p><strong class="quest-poster-label">Quest Date:</strong><br />@Html.WallClock(quest.FinalizedDate!.Value, "date-time")</p>
                            <p><strong class="quest-poster-label">Selected Adventurers:</strong> @quest.PlayerSignups.Count(ps => ps.IsSelected)</p>
                        }
                        else if (!campaign)
                        {
                            <p><strong class="quest-poster-label">Adventurers signed up:</strong> @quest.PlayerSignups.Count()</p>
                        }
                        <p><strong class="quest-poster-label">DM:</strong> @(string.IsNullOrWhiteSpace(dmName) ? "Unknown DM" : dmName)</p>
                        @if (!campaign)
                        {
                            <span class="badge quest-poster-cr"><i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>CR @quest.ChallengeRating</span>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
