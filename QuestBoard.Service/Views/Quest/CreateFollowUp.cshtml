@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.QuestViewModels
@using QuestBoard.Service.ViewModels.Shared
@model FollowUpQuestViewModel
@{
    ViewData["Title"] = "Create Follow-Up Quest";
    ViewData["BodyClass"] = "quest-form-page";

    // The form always opens with one date row so the dates group is never empty; it starts blank when the
    // original quest brought no dates along.
    var dateRowCount = Math.Max(1, Model.ProposedDates.Count);
}

@section Styles {
    <link href="~/css/quest-form.css" asp-append-version="true" rel="stylesheet" />
}

<div class="quest-form-wrap">
    <div class="row">
        <div class="col-lg-8 col-md-7">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h1 class="mb-0">
                        <i class="fas fa-scroll me-2" aria-hidden="true"></i>
                        Create Follow-Up Quest
                    </h1>
                </div>
                <div class="card-body modern-card-body">
                    <div asp-validation-summary="All" class="mb-3"></div>
                    <form asp-action="CreateFollowUp" asp-route-id="@Model.OriginalQuestId" method="post">
                        <input type="hidden" asp-for="OriginalQuestId" />
                        <input type="hidden" asp-for="DungeonMasterId" />

                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                            This form is pre-filled from the original quest. Update the title, add at least one date, and save to create the follow-up.
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Quest Title <span class="text-danger" aria-hidden="true">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter the quest title..." />
                            <span asp-validation-for="Title"></span>
                        </div>

                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "Description",
                               Value = Model.Description,
                               Label = "Description",
                               Required = true,
                               Placeholder = "Describe the quest..."
                           }); }

                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "Rewards",
                               Value = Model.Rewards,
                               Label = "Rewards",
                               Required = false,
                               Placeholder = "Describe the loot, gold, or other rewards for this quest..."
                           }); }

                        <div class="mb-3">
                            <label asp-for="ChallengeRating" class="form-label">Challenge Rating <span class="text-danger" aria-hidden="true">*</span></label>
                            <input asp-for="ChallengeRating" type="number" class="form-control" min="1" max="20" step="1" aria-describedby="ChallengeRating-help" />
                            <div id="ChallengeRating-help" class="form-text">Recommended player level for this quest (1-20).</div>
                            <span asp-validation-for="ChallengeRating"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TotalPlayerCount" class="form-label">Total Player Count <span class="text-danger" aria-hidden="true">*</span></label>
                            <input asp-for="TotalPlayerCount" inputmode="numeric" class="form-control" />
                            <span asp-validation-for="TotalPlayerCount"></span>
                        </div>

                        <div class="mb-3">
                            <div id="proposed-dates-label" class="form-label">Proposed Dates &amp; Times <span class="text-danger" aria-hidden="true">*</span></div>
                            <div id="proposed-dates" role="group" aria-labelledby="proposed-dates-label">
                                @for (int i = 0; i < dateRowCount; i++)
                                {
                                    <div class="mb-3 proposed-date-item">
                                        <label for="ProposedDates_@(i)_" class="form-label">Proposed Date @(i + 1)</label>
                                        <div class="input-group">
                                            <input type="datetime-local" id="ProposedDates_@(i)_" name="ProposedDates[@i]"
                                                   value="@(i < Model.ProposedDates.Count ? Model.ProposedDates[i].ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                   class="form-control" required step="60" />
                                            <button type="button" class="btn btn-danger" data-action="remove-proposed-date" aria-label="Remove proposed date @(i + 1)">
                                                <i class="fas fa-trash me-2" aria-hidden="true"></i>Remove
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <button type="button" class="btn btn-secondary btn-sm" data-action="add-proposed-date" aria-describedby="proposed-dates-help">
                                <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Date
                            </button>
                            <div id="proposed-dates-help" class="form-text">Provide multiple date/time options for players to vote on. At least one date is required.</div>
                            <span asp-validation-for="ProposedDates"></span>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between quest-form-actions">
                            <a href="@Url.Action("Manage", "Quest", new { id = Model.OriginalQuestId })" class="btn btn-secondary">
                                <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" data-busy-label="Saving follow-up quest...">
                                <i class="fas fa-scroll me-2" aria-hidden="true"></i>Save Follow-Up Quest
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-5 mt-3 mt-md-0">
            <div class="card modern-card modern-card--aside">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0">
                        <i class="fas fa-users me-2" aria-hidden="true"></i>
                        Pre-Approved Players
                    </h2>
                </div>
                <div class="card-body modern-card-body">
                    <p>
                        Selected players from the original quest will be automatically added as pre-approved signups once this quest is saved.
                    </p>
                    @if (ViewBag.PreApprovedPlayers != null && ((IEnumerable<dynamic>)ViewBag.PreApprovedPlayers).Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var player in ViewBag.PreApprovedPlayers)
                            {
                                <li class="mb-1"><i class="fas fa-check-circle text-success me-2" aria-hidden="true"></i><span class="visually-hidden">Pre-approved: </span>@player.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0">No players were selected on the original quest. You can add players manually after saving.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_QuestFormScripts"); }
}
