@using QuestBoard.Service.ViewModels.QuestLogViewModels
@using QuestBoard.Domain.Enums
@model QuestLogIndexViewModel
@{
    ViewData["Title"] = "Quest Log";
    ViewData["BodyClass"] = "quest-log-page";
    var boardType = (BoardType)ViewBag.BoardType;
}
@section Styles {
    <link href="~/css/quest-log.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
    <div class="card modern-card quest-log-intro">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">
                <i class="fas fa-book-open me-2" aria-hidden="true"></i>Quest Log
            </h1>
            <span class="header-subtitle">"A chronicle of legendary adventures and heroic deeds..."</span>
        </div>
    </div>

    @if (Model.CompletedQuests?.Any() != true)
    {
        <div class="card modern-card">
            <div class="empty-state">
                <i class="fas fa-book-open empty-state-icon" aria-hidden="true"></i>
                <h2 class="empty-state-heading">No Completed Quests Yet</h2>
                <p class="empty-state-text">Completed quests will appear here once they have been undertaken and finished.</p>
            </div>
        </div>
    }
    else
    {
        <div class="quest-log-list-mobile">
            @foreach (var quest in Model.CompletedQuests)
            {
                <article class="card modern-card modern-card--interactive quest-log-item">
                    <div class="quest-log-item-top">
                        <h2 class="quest-log-item-title"><a class="row-nav-link" href="@Url.Action("Details", "QuestLog", new { id = quest.Id })">@quest.Title</a></h2>
                        @if (boardType != BoardType.Campaign)
                        {
                            <span class="badge bg-secondary">
                                <i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>CR @quest.ChallengeRating
                            </span>
                        }
                    </div>
                    <div class="quest-log-item-meta">
                        <p class="quest-log-item-line">
                            <i class="fas fa-crown me-2" aria-hidden="true"></i><strong>DM:</strong> @(quest.DungeonMaster?.Name ?? "Unknown DM")
                        </p>
                        <p class="quest-log-item-line">
                            <i class="fas fa-calendar-check me-2" aria-hidden="true"></i><strong>Completed:</strong>
                            @if (quest.FinalizedDate.HasValue)
                            {
                                @Html.WallClock(quest.FinalizedDate.Value, "date")
                            }
                            else if (quest.ClosedDate.HasValue)
                            {
                                @Html.LocalTime(quest.ClosedDate.Value, "date")
                            }
                            else
                            {
                                @:Unknown Date
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(quest.Recap))
                    {
                        <span class="badge bg-info quest-log-item-recap">
                            <i class="fas fa-scroll me-1" aria-hidden="true"></i>Session Recap Available
                        </span>
                    }
                </article>
            }
        </div>
    }
</div>
