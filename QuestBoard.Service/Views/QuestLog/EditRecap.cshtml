@using QuestBoard.Service.ViewModels.QuestLogViewModels
@using QuestBoard.Service.ViewModels.Shared
@model EditRecapViewModel
@{
    ViewData["Title"] = $"Edit Recap: {Model.Quest.Title}";
}
@section Styles {
    <link rel="stylesheet" href="~/css/quest-log.css" asp-append-version="true" />
}

<div class="quest-log-edit-page">
    <div class="row">
        <div class="col-lg-8">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h1 class="mb-0">
                        <i class="fas fa-book me-2" aria-hidden="true"></i>@ViewData["Title"]
                    </h1>
                </div>
                <div class="card-body modern-card-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <form asp-action="EditRecap" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />

                        @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
                           {
                               FieldName = "recap",
                               Value = Model.Recap,
                               Label = "Recap",
                               Required = false,
                               Placeholder = "Describe what happened during this quest..."
                           }); }
                        <div class="form-text">Share the story of this adventure with your players!</div>

                        <hr />

                        <div class="d-flex justify-content-between quest-log-edit-actions">
                            <a href="@Url.Action("Details", "QuestLog", new { id = Model.Id })" class="btn btn-secondary">
                                <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2" aria-hidden="true"></i>Save Recap
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
}
