@using QuestBoard.Service.ViewModels.QuestLogViewModels
@using QuestBoard.Domain.Enums
@using QuestBoard.Service.Extensions
@model QuestLogDetailsViewModel
@{
    ViewData["Title"] = $"Quest Log: {Model.Quest.Title}";
    var boardType = (BoardType)ViewBag.BoardType;
    var selectedPlayers = Model.Quest.PlayerSignups.Where(ps => ps.IsSelected).OrderBy(ps => ps.SignupTime).ToList();
    var hasRecap = !string.IsNullOrWhiteSpace(Model.Quest.Recap);
}
@section Styles {
    <link rel="stylesheet" href="~/css/quest-log.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/avatar-fallback.js" asp-append-version="true"></script>
}

<div class="quest-log-detail-page">
    <div class="row">
        <div class="col-md-8">
            <div class="card modern-card quest-log-detail-main">
                <div class="card-header modern-card-header d-flex justify-content-between align-items-start gap-3">
                    <h1 class="mb-0">@Model.Quest.Title</h1>
                    @if (boardType != BoardType.Campaign)
                    {
                        <span class="badge bg-secondary flex-shrink-0">
                            <i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>CR @Model.Quest.ChallengeRating
                        </span>
                    }
                </div>
                <div class="card-body modern-card-body">
                    <section class="quest-log-section">
                        <h2><i class="fas fa-info-circle me-2" aria-hidden="true"></i>Quest Information</h2>
                        <div class="row">
                            <div class="col-sm-6">
                                <p><strong>Dungeon Master:</strong> @Model.Quest.DungeonMaster?.Name</p>
                                @if (boardType != BoardType.Campaign)
                                {
                                    <p><strong>Challenge Rating:</strong> @Model.Quest.ChallengeRating</p>
                                }
                            </div>
                            <div class="col-sm-6">
                                <p>
                                    <strong>Completed On:</strong>
                                    @if (Model.Quest.FinalizedDate.HasValue)
                                    {
                                        @Html.WallClock(Model.Quest.FinalizedDate.Value, "date-time")
                                    }
                                    else if (Model.Quest.ClosedDate.HasValue)
                                    {
                                        @Html.LocalTime(Model.Quest.ClosedDate.Value, "date-time")
                                    }
                                </p>
                                <p><strong>Created:</strong> @Html.LocalTime(Model.Quest.CreatedAt, "date")</p>
                            </div>
                        </div>
                    </section>

                    <hr />

                    <section class="quest-log-section">
                        <h2><i class="fas fa-scroll me-2" aria-hidden="true"></i>Original Quest Description</h2>
                        <div class="quest-log-text-box">@Html.Markdown(Model.Quest.Description)</div>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(Model.Quest.Rewards))
                    {
                        <hr />

                        <section class="quest-log-section">
                            <h2><i class="fas fa-coins me-2" aria-hidden="true"></i>Rewards</h2>
                            <div class="quest-log-text-box">@Html.Markdown(Model.Quest.Rewards)</div>
                        </section>
                    }

                    @if (boardType != BoardType.Campaign)
                    {
                        <hr />

                        <section class="quest-log-section">
                            <h2><i class="fas fa-users me-2" aria-hidden="true"></i>Adventurers</h2>
                            @if (selectedPlayers.Any())
                            {
                                <ul class="quest-log-adventurers list-unstyled">
                                    @foreach (var player in selectedPlayers)
                                    {
                                        <li class="quest-log-adventurer">
                                            <strong>@player.Player.Name</strong>
                                            @if (player.Character != null)
                                            {
                                                <span class="quest-log-adventurer-character">
                                                    <img src="@Url.Action("GetCroppedPicture", "Characters", new { id = player.Character.Id })"
                                                         alt=""
                                                         class="avatar-32" />
                                                    <span class="avatar-32 avatar-32--placeholder" hidden aria-hidden="true">
                                                        <i class="fas fa-user" aria-hidden="true"></i>
                                                    </span>
                                                    <span>@player.Character.Name</span>
                                                </span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>No adventurers participated in this quest.</p>
                            }
                        </section>
                    }

                    <hr />

                    <section class="quest-log-section">
                        <h2><i class="fas fa-book me-2" aria-hidden="true"></i>Session Recap</h2>
                        @if (hasRecap)
                        {
                            <div class="quest-log-text-box">@Html.Markdown(Model.Quest.Recap)</div>
                        }
                        else
                        {
                            <p>No recap has been written for this quest yet.</p>
                        }
                    </section>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card modern-card quest-log-side-card">
                <div class="card-body modern-card-body">
                    <h2><i class="fas fa-bolt me-2" aria-hidden="true"></i>Quick Actions</h2>
                    <a href="@Url.Action("Index", "QuestLog")" class="btn btn-secondary w-100">
                        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Quest Log
                    </a>
                    @if ((bool)ViewBag.CanManageQuest)
                    {
                        <a href="@Url.Action("Manage", "Quest", new { id = Model.Quest.Id })" class="btn btn-info w-100">
                            <i class="fas fa-cog me-2" aria-hidden="true"></i>Manage Quest
                        </a>
                    }
                    @if ((bool)ViewBag.CanEditRecap)
                    {
                        <a href="@Url.Action("EditRecap", "QuestLog", new { id = Model.Quest.Id })" class="btn btn-primary w-100">
                            @if (hasRecap)
                            {
                                <i class="fas fa-edit me-2" aria-hidden="true"></i>@:Edit Recap
                            }
                            else
                            {
                                <i class="fas fa-plus me-2" aria-hidden="true"></i>@:Add Recap
                            }
                        </a>
                    }
                </div>
            </div>

            @if (boardType != BoardType.Campaign)
            {
                var dmHasKey = Model.Quest.DungeonMaster?.HasKey == true;
                var playersHaveKey = Model.Quest.PlayerSignups?.Any(ps => ps.Player.HasKey == true) == true;
                var anyoneHasKey = dmHasKey || playersHaveKey;

                <div class="card modern-card quest-log-side-card">
                    <div class="card-body modern-card-body">
                        <h2><i class="fas fa-chart-bar me-2" aria-hidden="true"></i>Quest Statistics</h2>
                        <p><strong>Total Signups:</strong> @Model.Quest.PlayerSignups.Count</p>
                        <p><strong>Participants:</strong> @selectedPlayers.Count / @Model.Quest.TotalPlayerCount</p>
                        <p>
                            <strong>Building Access:</strong>
                            <span class="badge @(anyoneHasKey ? "bg-success" : "bg-danger")">
                                @if (anyoneHasKey)
                                {
                                    <i class="fas fa-key me-1" aria-hidden="true"></i>@:Available
                                }
                                else
                                {
                                    <i class="fas fa-lock me-1" aria-hidden="true"></i>@:No Key
                                }
                            </span>
                        </p>
                        <p>
                            <strong>Status:</strong>
                            <span class="badge bg-secondary">
                                <i class="fas fa-flag-checkered me-1" aria-hidden="true"></i>Completed
                            </span>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
