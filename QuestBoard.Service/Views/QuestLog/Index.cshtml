@using QuestBoard.Service.ViewModels.QuestLogViewModels
@using QuestBoard.Domain.Enums
@inject QuestBoard.Domain.Interfaces.IMarkdownService MarkdownService
@model QuestLogIndexViewModel
@{
    ViewData["Title"] = "Quest Log";
    var boardType = (BoardType)ViewBag.BoardType;
}
@section Styles {
    <link rel="stylesheet" href="~/css/quest-log.css" asp-append-version="true" />
}

<div class="quest-log-wrap">
    <div class="card modern-card quest-log-intro">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">
                <i class="fas fa-book-open me-2" aria-hidden="true"></i>Quest Log
            </h1>
            <span class="header-subtitle">"A chronicle of legendary adventures and heroic deeds..."</span>
        </div>
    </div>

    @if (Model.CompletedQuests?.Any() == true)
    {
        <div class="quest-log-grid">
            @foreach (var quest in Model.CompletedQuests)
            {
                var selectedCount = quest.PlayerSignups.Count(ps => ps.IsSelected);
                var plainDescription = MarkdownService.ExtractPlainText(quest.Description);
                // Cut before a high surrogate that would be left without its pair, so an emoji is never split.
                var excerptLength = plainDescription.Length > 200 && char.IsHighSurrogate(plainDescription[199]) ? 199 : 200;
                var shortDescription = plainDescription.Length > 200
                    ? plainDescription.Substring(0, excerptLength) + "..."
                    : plainDescription;

                <article class="card modern-card modern-card--interactive quest-log-card">
                    <div class="card-body modern-card-body">
                        <div class="quest-log-card-top">
                            <h2 class="quest-log-card-title"><a class="row-nav-link" href="@Url.Action("Details", "QuestLog", new { id = quest.Id })">@quest.Title</a></h2>
                            @if (boardType != BoardType.Campaign)
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-dice-d20 me-1" aria-hidden="true"></i>CR @quest.ChallengeRating
                                </span>
                            }
                        </div>

                        <div class="quest-log-meta">
                            <p class="quest-log-meta-line">
                                <i class="fas fa-crown me-2" aria-hidden="true"></i><strong>DM:</strong> @(quest.DungeonMaster?.Name ?? "Unknown DM")
                            </p>
                            <p class="quest-log-meta-line">
                                <i class="fas fa-calendar-check me-2" aria-hidden="true"></i><strong>Completed:</strong>
                                @if (quest.FinalizedDate.HasValue)
                                {
                                    @Html.WallClock(quest.FinalizedDate.Value, "date")
                                }
                                else if (quest.ClosedDate.HasValue)
                                {
                                    @Html.LocalTime(quest.ClosedDate.Value, "date")
                                }
                                else
                                {
                                    @:Unknown Date
                                }
                            </p>
                            @if (boardType != BoardType.Campaign)
                            {
                                <p class="quest-log-meta-line">
                                    <i class="fas fa-users me-2" aria-hidden="true"></i><strong>Adventurers:</strong> @selectedCount
                                </p>
                            }
                        </div>

                        <p class="quest-log-card-description">@shortDescription</p>
                    </div>

                    <div class="card-footer modern-card-footer quest-log-card-footer">
                        @if (!string.IsNullOrWhiteSpace(quest.Recap))
                        {
                            <span class="badge bg-info">
                                <i class="fas fa-scroll me-1" aria-hidden="true"></i>Session Recap Available
                            </span>
                        }
                        <span class="quest-log-card-cue">
                            Click to view details <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
                        </span>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="card modern-card">
            <div class="empty-state">
                <i class="fas fa-book-open empty-state-icon" aria-hidden="true"></i>
                <h2 class="empty-state-heading">No Completed Quests Yet</h2>
                <p class="empty-state-text">Completed quests will appear here once they have been undertaken and finished.</p>
            </div>
        </div>
    }
</div>
