@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.AdminViewModels
@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

@section Styles {
    <link href="~/css/admin-pages.css" asp-append-version="true" rel="stylesheet" />
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-user-edit me-2" aria-hidden="true"></i>@ViewData["Title"]
                </h1>
            </div>
            <div class="card-body modern-card-body">
                <form asp-action="EditUser" method="post" class="form-page">
                    <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Html.DisplayNameFor(m => m.Name) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" aria-describedby="Name-error" />
                        <span asp-validation-for="Name" id="Name-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="off" aria-describedby="Email-error" />
                        <span asp-validation-for="Email" id="Email-error"></span>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="HasKey" class="form-check-input" type="checkbox" />
                            <label asp-for="HasKey" class="form-check-label">
                                <i class="fas fa-key me-2" aria-hidden="true"></i>
                                User has a building key (can close the building)
                            </label>
                        </div>
                        <span asp-validation-for="HasKey"></span>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h2 class="form-section-title">
                            <i class="fas fa-key me-2" aria-hidden="true"></i>Password Management
                        </h2>
                        <p class="form-text">Reset this user's password (they will need to use the new password to log in).</p>
                        <a asp-action="ResetPassword" asp-route-userId="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-key me-2" aria-hidden="true"></i>Reset Password
                        </a>
                    </div>

                    <hr>

                    <div class="form-actions">
                        <a asp-action="Users" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Users
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2" aria-hidden="true"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
