@using QuestBoard.Domain.Enums
@using QuestBoard.Domain.Models.QuestBoard
@using QuestBoard.Service.ViewModels.AdminViewModels
@inject QuestBoard.Domain.Interfaces.IMarkdownService MarkdownService
@model IEnumerable<Quest>

@{
    var boardType = (BoardType)ViewBag.BoardType;
    var boardToday = (DateOnly)ViewBag.BoardToday;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-pages.css" asp-append-version="true" />
}

<div class="card modern-card">
    <div class="card-header modern-card-header page-bar">
        <h1 class="mb-0">
            <i class="fas fa-scroll me-2" aria-hidden="true"></i>Quest Management
        </h1>
    </div>
    <div class="card-body modern-card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Description</th>
                            <th scope="col">Dungeon Master</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var quest in Model)
                        {
                            var plainQuestDescription = MarkdownService.ExtractPlainText(quest.Description);
                            <tr>
                                <td class="name-cell">
                                    <i class="fas fa-dragon me-2" aria-hidden="true"></i>@quest.Title
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(plainQuestDescription))
                                    {
                                        <span class="quest-excerpt" title="@plainQuestDescription">@plainQuestDescription</span>
                                    }
                                    else
                                    {
                                        <span class="quest-excerpt quest-excerpt--none">No description provided</span>
                                    }
                                </td>
                                <td>
                                    <div class="user-cell">
                                        <i class="fas fa-user-tie me-2" aria-hidden="true"></i><span class="user-cell__name">@(quest.DungeonMaster?.Name ?? "Unknown")</span>
                                        @if (!string.IsNullOrEmpty(quest.DungeonMaster?.Email))
                                        {
                                            <a href="mailto:@quest.DungeonMaster.Email" class="email-link user-cell__email">@quest.DungeonMaster.Email</a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <partial name="_QuestStatusBadge" model="new QuestStatusBadgeModel(quest, boardType, boardToday)" />
                                </td>
                                <td class="actions-cell">
                                    <div class="row-actions">
                                        <a asp-controller="Quest" asp-action="Edit" asp-route-id="@quest.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit me-2" aria-hidden="true"></i>Edit
                                        </a>
                                        <form asp-action="DeleteQuest" asp-route-id="@quest.Id" method="post"
                                              data-confirm-message="Are you sure you want to delete this quest? This action cannot be undone.">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash me-2" aria-hidden="true"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-scroll empty-state-icon" aria-hidden="true"></i>
                <h2 class="empty-state-heading">No quests found.</h2>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
}
