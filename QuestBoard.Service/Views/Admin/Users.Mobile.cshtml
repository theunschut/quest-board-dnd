@using QuestBoard.Domain.Enums
@using QuestBoard.Service.ViewModels.AdminViewModels
@model IEnumerable<UserManagementViewModel>

@section Styles {
    <link rel="stylesheet" href="~/css/admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-pages.mobile.css" asp-append-version="true" />
}

<div class="card modern-card">
    <div class="card-header modern-card-header page-bar">
        <h1 class="mb-0">
            <i class="fas fa-users-cog me-2" aria-hidden="true"></i>User Management
        </h1>
        <a asp-action="CreateUser" class="btn btn-primary">
            <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create User
        </a>
    </div>
    <div class="card-body modern-card-body">
        @if (Model.Any())
        {
            @foreach (var userModel in Model)
            {
                // Which of this row's controls the server will refuse, and the reason line each one points at. A person's own row
                // is refused for the self reason even when they are also the board's only Admin, so one sentence serves them.
                var id = userModel.User.Id;
                var lastAdminRefused = !userModel.IsSelf && userModel.IsLastAdmin;
                var reachRefused = userModel.Reach != AccountReach.Reachable;
                string? selfRefusal = userModel.IsSelf ? $"reason-self-{id}" : null;
                string? lastAdminRefusal = lastAdminRefused ? $"reason-last-{id}" : null;
                string? reachRefusal = reachRefused ? $"reason-reach-{id}" : null;
                var promoteRefusal = selfRefusal;
                var demoteRefusal = selfRefusal ?? lastAdminRefusal;
                var removeRefusal = selfRefusal ?? lastAdminRefusal;
                var promoteAction = userModel.IsDungeonMaster ? "PromoteToAdmin" : userModel.IsPlayer ? "PromoteToDM" : null;
                var promoteLabel = userModel.IsDungeonMaster ? "Promote to Admin" : "Promote to DM";
                var demoteAction = userModel.IsAdmin ? "DemoteFromAdmin" : userModel.IsDungeonMaster ? "DemoteToPlayer" : null;
                var demoteLabel = userModel.IsAdmin ? "Demote to DM" : "Demote to Player";
                <div class="row-slip">
                    <div class="row-slip__head">
                        <span class="user-slip__name"><i class="fas fa-user me-2" aria-hidden="true"></i>@userModel.User.Name</span>
                        @if (userModel.Role is { } role)
                        {
                            <partial name="_RoleBadge" model="role" />
                        }
                    </div>
                    <div class="row-slip__actions">
                        @if (promoteAction is not null && promoteRefusal is not null)
                        {
                            <button type="button" class="btn btn-sm btn-success disabled" aria-disabled="true" aria-describedby="@promoteRefusal">
                                <i class="fas fa-arrow-up me-2" aria-hidden="true"></i>@promoteLabel
                            </button>
                        }
                        else if (promoteAction is not null)
                        {
                            <form asp-action="@promoteAction" method="post">
                                <input type="hidden" name="userId" value="@userModel.User.Id" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="fas fa-arrow-up me-2" aria-hidden="true"></i>@promoteLabel
                                </button>
                            </form>
                        }
                        @if (demoteAction is not null && demoteRefusal is not null)
                        {
                            <button type="button" class="btn btn-sm btn-secondary disabled" aria-disabled="true" aria-describedby="@demoteRefusal">
                                <i class="fas fa-arrow-down me-2" aria-hidden="true"></i>@demoteLabel
                            </button>
                        }
                        else if (demoteAction is not null)
                        {
                            <form asp-action="@demoteAction" method="post">
                                <input type="hidden" name="userId" value="@userModel.User.Id" />
                                <button type="submit" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-arrow-down me-2" aria-hidden="true"></i>@demoteLabel
                                </button>
                            </form>
                        }
                        @if (!userModel.EmailConfirmed && !string.IsNullOrEmpty(userModel.User.Email))
                        {
                            if (reachRefusal is not null)
                            {
                                <button type="button" class="btn btn-sm btn-info disabled" aria-disabled="true" aria-describedby="@reachRefusal">
                                    <i class="fas fa-envelope me-2" aria-hidden="true"></i>Resend Welcome Email
                                </button>
                            }
                            else
                            {
                                <form asp-action="SendConfirmationEmail" method="post">
                                    <input type="hidden" name="userId" value="@userModel.User.Id" />
                                    <button type="submit" class="btn btn-sm btn-info">
                                        <i class="fas fa-envelope me-2" aria-hidden="true"></i>Resend Welcome Email
                                    </button>
                                </form>
                            }
                        }
                        @if (reachRefusal is not null)
                        {
                            <button type="button" class="btn btn-sm btn-warning disabled" aria-disabled="true" aria-describedby="@reachRefusal">
                                <i class="fas fa-edit me-2" aria-hidden="true"></i>Edit
                            </button>
                        }
                        else
                        {
                            <a asp-action="EditUser" asp-route-userId="@userModel.User.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit me-2" aria-hidden="true"></i>Edit
                            </a>
                        }
                        @if (removeRefusal is not null)
                        {
                            <button type="button" class="btn btn-sm btn-danger disabled" aria-disabled="true" aria-describedby="@removeRefusal">
                                <i class="fas fa-user-minus me-2" aria-hidden="true"></i>Remove from Group
                            </button>
                        }
                        else
                        {
                            <form asp-action="DeleteUser" asp-route-id="@userModel.User.Id" method="post"
                                  data-confirm-message="@AdminActionMessages.RemoveMemberConfirm">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-user-minus me-2" aria-hidden="true"></i>Remove from Group
                                </button>
                            </form>
                        }
                    </div>
                    @if (userModel.IsSelf)
                    {
                        <p class="control-reason" id="reason-self-@userModel.User.Id"><i class="fas fa-lock" aria-hidden="true"></i><span>@AdminActionMessages.ReasonSelf</span></p>
                    }
                    @if (lastAdminRefused)
                    {
                        <p class="control-reason" id="reason-last-@userModel.User.Id"><i class="fas fa-lock" aria-hidden="true"></i><span>@AdminActionMessages.ReasonLastAdmin</span></p>
                    }
                    @if (reachRefused)
                    {
                        <p class="control-reason" id="reason-reach-@userModel.User.Id"><i class="fas fa-lock" aria-hidden="true"></i><span>@AdminActionMessages.ReasonReach</span></p>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-users empty-state-icon" aria-hidden="true"></i>
                <h2 class="empty-state-heading">No users found.</h2>
                <p class="empty-state-text">Users appear here once registered.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
}
