@using QuestBoard.Service.ViewModels.AdminViewModels
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

@section Styles {
    <link href="~/css/admin-pages.css" asp-append-version="true" rel="stylesheet" />
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-key me-2" aria-hidden="true"></i>Reset Password for @Model.UserName
                </h1>
            </div>
            <div class="card-body modern-card-body">
                <form asp-action="ResetPassword" method="post" class="form-page">
                    <div asp-validation-summary="All" class="mb-3"></div>

                    <input asp-for="UserId" type="hidden" />
                    <input asp-for="UserName" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">@Html.DisplayNameFor(m => m.NewPassword) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="NewPassword-hint NewPassword-error" />
                        <div class="form-text" id="NewPassword-hint">At least 8 characters, with an upper-case letter, a lower-case letter and a digit.</div>
                        <span asp-validation-for="NewPassword" id="NewPassword-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">@Html.DisplayNameFor(m => m.ConfirmPassword) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="ConfirmPassword-error" />
                        <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error"></span>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
                        <strong>Warning:</strong> This will reset the password for @Model.UserName. The user will need to use the new password to log in.
                    </div>

                    <hr>

                    <div class="form-actions">
                        <a asp-action="Users" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Users
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2" aria-hidden="true"></i>Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
