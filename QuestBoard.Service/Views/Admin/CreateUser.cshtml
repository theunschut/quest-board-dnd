@using QuestBoard.Service.ViewModels.AdminViewModels
@model CreateUserViewModel
@{
    ViewData["Title"] = "Create New User";
}

@section Styles {
    <link href="~/css/admin-pages.css" asp-append-version="true" rel="stylesheet" />
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-user-plus me-2" aria-hidden="true"></i>@ViewData["Title"]
                </h1>
            </div>
            <div class="card-body modern-card-body">
                <form asp-action="CreateUser" method="post" class="form-page">
                    <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@Html.DisplayNameFor(m => m.Email) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="off" aria-describedby="Email-error" />
                        <span asp-validation-for="Email" id="Email-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">@Html.DisplayNameFor(m => m.Name) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" aria-describedby="Name-error" />
                        <span asp-validation-for="Name" id="Name-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GroupRole" class="form-label">@Html.DisplayNameFor(m => m.GroupRole) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                        <select asp-for="GroupRole" asp-items="AdminPlatformDisplay.GroupRoleOptions()" class="form-select" aria-describedby="GroupRole-error"></select>
                        <span asp-validation-for="GroupRole" id="GroupRole-error"></span>
                    </div>

                    <hr>

                    <div class="form-actions">
                        <a asp-action="Users" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Users
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus me-2" aria-hidden="true"></i>Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
