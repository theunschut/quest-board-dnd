@model QuestBoard.Service.ViewModels.AdminViewModels.EmailStatsViewModel

@{
    ViewData["Title"] = "Email Stats";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-pages.css" asp-append-version="true" />
}

<div class="card modern-card">
    <div class="card-header modern-card-header">
        <h1 class="mb-0">
            <i class="fas fa-envelope-open-text me-2" aria-hidden="true"></i>Email Stats
        </h1>
    </div>
    <div class="card-body modern-card-body">
        @if (Model.IsMissingKey)
        {
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
                <strong>ResendApiKey not configured</strong> — add it to <code>appsettings.json</code> to enable stats.
            </div>
        }
        else if (Model.IsApiError)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-times-circle me-2" aria-hidden="true"></i>
                <strong>Could not fetch email stats</strong> — Resend API returned an error. Check your API key and try again.
            </div>
        }
        else
        {
            <div class="stat-tiles">
                <div class="stat-tile stat-tile--neutral">
                    <i class="fas fa-paper-plane stat-tile__icon" aria-hidden="true"></i>
                    <span class="stat-tile__figure">@Model.Sent</span>
                    <span class="stat-tile__label">In Transit</span>
                </div>
                <div class="stat-tile stat-tile--success">
                    <i class="fas fa-check-circle stat-tile__icon" aria-hidden="true"></i>
                    <span class="stat-tile__figure">@Model.Delivered</span>
                    <span class="stat-tile__label">Delivered</span>
                </div>
                <div class="stat-tile stat-tile--warning">
                    <i class="fas fa-exclamation-triangle stat-tile__icon" aria-hidden="true"></i>
                    <span class="stat-tile__figure">@Model.Bounced</span>
                    <span class="stat-tile__label">Bounced</span>
                </div>
                <div class="stat-tile stat-tile--danger">
                    <i class="fas fa-times-circle stat-tile__icon" aria-hidden="true"></i>
                    <span class="stat-tile__figure">@Model.Failed</span>
                    <span class="stat-tile__label">Failed</span>
                </div>
            </div>
            <p class="stat-asof">
                <i class="fas fa-clock me-1" aria-hidden="true"></i>
                Stats as of @(Model.AsOf.HasValue ? Html.LocalTime(Model.AsOf.Value, "date-time") : Html.Raw(string.Empty)) — cached for 5 minutes
            </p>
        }

        <hr />
        <div class="d-flex justify-content-end mt-3">
            <a href="/Admin/EmailStats?force=true" class="btn btn-primary">
                <i class="fas fa-sync-alt me-2" aria-hidden="true"></i>Refresh Email Stats
            </a>
        </div>
    </div>
</div>
