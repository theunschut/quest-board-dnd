@using QuestBoard.Service.ViewModels.EventViewModels
@using QuestBoard.Service.ViewModels.Shared
@model EventViewModel
@{
    ViewData["Title"] = "Edit Event";
    var pages = await BoardPages.GetAsync();
}

<div class="card modern-card">
    <div class="card-header modern-card-header">
        <h1 class="mb-0">
            <i class="fas fa-pen me-2" aria-hidden="true"></i>
            Edit @Model.Title
        </h1>
    </div>
    <div class="card-body modern-card-body">
        <form asp-action="Edit" method="post" id="editEventForm" data-event-id="@Model.Id" data-collision-url="@Url.Action("CheckOccurrenceCollision", "Events")">
            <input type="hidden" asp-for="Id" />
            @if (Model.SeriesId != null)
            {
                @* The scope dialog is the only place this field is set. It defaults to the
                   safe single-event outcome so a form submitted without the dialog running
                   (should the intercept ever fail to attach) never silently sweeps the series. *@
                <input type="hidden" name="EditScope" id="EditScope" value="@((int)EventEditScope.OnlyThisEvent)" />
                <input type="hidden" id="originalDate" value="@Model.Date.ToString("yyyy-MM-dd")" />
            }
            <div asp-validation-summary="All" class="mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title <span class="text-danger" aria-hidden="true">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="Enter event title" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Date" class="form-label">Date <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="field-validation-error"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="StartTime" class="form-label">Start Time (optional)</label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="field-validation-error"></span>
                </div>
            </div>

            @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
               {
                   FieldName = "Description",
                   Value = Model.Description,
                   Label = "Description",
                   Required = false,
                   Placeholder = "What's happening?"
               }); }

            <hr />

            <div class="d-flex justify-content-between">
                <a href="@(pages.Serves(BoardPage.Calendar) ? Url.Action("Index", "Calendar", new { year = Model.Date.Year, month = Model.Date.Month }) : Url.Action("Index", "Events"))" class="btn btn-secondary">
                    <i class="fas fa-times me-2" aria-hidden="true"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary" id="saveChangesBtn">
                    <i class="fas fa-save me-2" aria-hidden="true"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.SeriesId != null)
{
    @* A custom two-button modal, not the app's usual native confirm(), because this prompt
       has two affirmative outcomes and a native dialog is binary. *@
    <div class="modal fade" id="saveScopeModal" tabindex="-1" aria-labelledby="saveScopeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="saveScopeModalLabel">Save this change</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">Update just this event, or this event and every future session in the series?</p>
                    <div class="alert alert-warning d-none" id="saveScopeCollisionNotice" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-secondary" id="saveScopeFutureBtn" data-scope-value="@((int)EventEditScope.ThisAndFutureEvents)">This and all future events</button>
                    <button type="button" class="btn btn-primary" id="saveScopeOnlyBtn" data-scope-value="@((int)EventEditScope.OnlyThisEvent)">Only this event</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script type="module" src="~/js/event-series-form.js" asp-append-version="true"></script>
}
