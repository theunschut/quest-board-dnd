@using QuestBoard.Domain.Enums
@using QuestBoard.Service.Constants
@using QuestBoard.Service.ViewModels.EventViewModels
@model EventOverviewViewModel
@{
    ViewData["Title"] = "Board Availability";
    var activeGroupName = Context.Session?.GetString(SessionKeys.ActiveGroupName);
    var subtitleBoardName = string.IsNullOrEmpty(activeGroupName) ? "this board" : activeGroupName;
    var isDm = (await AuthorizationService.AuthorizeAsync(User, "DungeonMasterOnly")).Succeeded;
}
@section Styles {
    <link href="~/css/events-overview.mobile.css" asp-append-version="true" rel="stylesheet" />
}

<div class="container-fluid px-2 mt-2">
    <div class="avail-page-header">
        <div>
            <h1 class="mb-0">
                <i class="fas fa-calendar-check text-purple me-2" aria-hidden="true"></i>@ViewData["Title"]
            </h1>
            <p class="header-subtitle mb-0">Events on @subtitleBoardName</p>
        </div>
        @if (isDm)
        {
            <a asp-controller="Agenda" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-calendar-days me-1" aria-hidden="true"></i>My Agenda
            </a>
        }
    </div>

    <div class="mb-3">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="collapse" data-bs-target="#avail-legend" aria-expanded="false" aria-controls="avail-legend">
            What do these mean?
        </button>
        <div class="collapse mt-2" id="avail-legend">
            <div class="card modern-card">
                <div class="card-body modern-card-body">
                    <div class="d-flex align-items-center mb-2">
                        @await Html.PartialAsync("_AvailabilityCell", AvailabilityCellState.ConfirmedYes)
                        <small class="ms-2">Confirmed available</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        @await Html.PartialAsync("_AvailabilityCell", AvailabilityCellState.ConfirmedMaybe)
                        <small class="ms-2">Confirmed maybe</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        @await Html.PartialAsync("_AvailabilityCell", AvailabilityCellState.ConfirmedNo)
                        <small class="ms-2">Confirmed not available</small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        @await Html.PartialAsync("_AvailabilityCell", AvailabilityCellState.UnconfirmedYes)
                        <small class="ms-2">Counted by default — not yet confirmed</small>
                    </div>
                    <div class="d-flex align-items-center">
                        @await Html.PartialAsync("_AvailabilityCell", AvailabilityCellState.Empty)
                        <small class="ms-2">No signup for this event</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="empty-state">
            <i class="fas fa-calendar-alt empty-state-icon" aria-hidden="true"></i>
            <h2 class="empty-state-heading">No Upcoming Events</h2>
            <p class="empty-state-text">This board has no upcoming events yet. Once a DM schedules one, it will appear here.</p>
        </div>
    }
    else
    {
        <div class="avail-card-list">
            @foreach (var row in Model.Rows)
            {
                @* The title link is stretched over the card, so the card is the tap target. The roster toggle and the
                   roster sit above that link, so a tap on them never reaches it and no handler is needed. *@
                <div class="avail-card modern-card modern-card--interactive">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <h2 class="avail-card-title"><a class="row-nav-link" href="@Url.Action("Details", "Events", new { id = row.EventId })">@row.Title</a></h2>
                            <small class="avail-card-meta">
                                @Html.WallClock(row.Date.ToDateTime(TimeOnly.MinValue), "weekday-short")
                                @if (row.StartTime.HasValue)
                                {
                                    @:&middot; @Html.WallClock(row.Date.ToDateTime(row.StartTime.Value), "time-24h")
                                }
                            </small>
                        </div>
                        @await Html.PartialAsync("_AvailabilityCounts", row)
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary avail-expand-toggle"
                            data-bs-toggle="collapse" data-bs-target="#roster-@row.EventId"
                            aria-expanded="false" aria-controls="roster-@row.EventId">
                        <i class="fas fa-chevron-down me-1" aria-hidden="true"></i>Show players
                    </button>
                    <div class="collapse avail-roster" id="roster-@row.EventId">
                        <ul class="list-unstyled mb-0 small">
                            @for (var i = 0; i < Model.Members.Count; i++)
                            {
                                var member = Model.Members[i];
                                var cell = i < row.Cells.Count ? row.Cells[i] : AvailabilityCellState.Empty;
                                <li class="d-flex justify-content-between align-items-center">
                                    <span class="avail-roster-name">@member.Name@(member.UserId == Model.CurrentUserId ? " (you)" : "")</span>
                                    @await Html.PartialAsync("_AvailabilityCell", cell)
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
        @if (Model.CanShowMore)
        {
            <div class="d-grid mb-3">
                <a href="@Url.Action("Index", new { take = Model.NextTake })" class="btn btn-primary">
                    <i class="fas fa-chevron-down me-2" aria-hidden="true"></i>Show More Events
                </a>
            </div>
        }
    }
</div>
