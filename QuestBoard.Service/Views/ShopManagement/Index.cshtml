@using QuestBoard.Service.ViewModels.ShopViewModels
@model ShopManagementIndexViewModel
@inject QuestBoard.Domain.Interfaces.IMarkdownService MarkdownService
@{
    ViewData["Title"] = "Shop Management - DM Dashboard";
    ViewData["Theme"] = "shop";
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, "AdminOnly")).Succeeded;
}

@functions {
    string DescriptionTeaser(string description)
    {
        var plain = MarkdownService.ExtractPlainText(description);
        return plain.Length > 50 ? plain.Substring(0, 50) + "..." : plain;
    }
}

<div class="card modern-card">
    <div class="card-header modern-card-header">
        <h1 class="mb-0">
            <i class="fas fa-store me-2" aria-hidden="true"></i>Shop Management Dashboard
        </h1>
    </div>
    <div class="card-body modern-card-body">
        <div class="mgmt-bar">
            <a href="/ShopManagement/Create" class="btn btn-primary">
                <i class="fas fa-plus me-2" aria-hidden="true"></i>Add New Item
            </a>
            <a href="/Shop" class="btn btn-secondary">
                <i class="fas fa-store me-2" aria-hidden="true"></i>View Shop
            </a>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#bulkActionsModal">
                <i class="fas fa-tasks me-2" aria-hidden="true"></i>Bulk Actions
            </button>
        </div>

        @if (Model.ItemsForReview.Any())
        {
            <section class="card modern-card modern-card--aside mgmt-section" aria-labelledby="mgmtReviewTitle">
                <div class="card-header modern-card-header">
                    <h2 id="mgmtReviewTitle"><i class="fas fa-clock me-2" aria-hidden="true"></i>Items Awaiting Review</h2>
                    <span class="header-subtitle">(@Model.ItemsForReview.Count items need DM votes)</span>
                </div>
                <div class="card-body modern-card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Item</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Rarity</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Submitted By</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ItemsForReview)
                                {
                                    <tr>
                                        <td>
                                            <strong class="mgmt-name">@item.Name</strong>
                                            <span class="mgmt-teaser">@DescriptionTeaser(item.Description)</span>
                                        </td>
                                        <td><partial name="_ShopTypeChip" model="item.Type" /></td>
                                        <td><partial name="_ShopRarityChip" model="item.Rarity" /></td>
                                        <td>@item.Price gp</td>
                                        <td>@item.CreatedByDmName</td>
                                        <td><partial name="_ShopStatusBadge" model="item.Status" /></td>
                                        <td>
                                            <div class="mgmt-row-actions">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm" title="View Details" aria-label="View item">
                                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                                </a>
                                                <form method="post" action="/ShopManagement/Publish/@item.Id" data-confirm-message="Are you sure you want to publish this item?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-sm" title="Publish" aria-label="Publish item">
                                                        <i class="fas fa-check" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-danger btn-sm" title="Deny" aria-label="Deny item"
                                                        data-bs-toggle="modal" data-bs-target="#denyModal"
                                                        data-deny-url="/ShopManagement/Deny/@item.Id" data-deny-name="@item.Name">
                                                    <i class="fas fa-times" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

        <section class="card modern-card modern-card--aside mgmt-section" aria-labelledby="mgmtMineTitle">
            <div class="card-header modern-card-header">
                <h2 id="mgmtMineTitle"><i class="fas fa-user-cog me-2" aria-hidden="true"></i>My Items</h2>
                <span class="header-subtitle">(@Model.MyItems.Count items)</span>
            </div>
            <div class="card-body modern-card-body">
                @if (Model.MyItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Item</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Rarity</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Stock</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MyItems.OrderByDescending(i => i.Id))
                                {
                                    <tr>
                                        <td>
                                            <strong class="mgmt-name">@item.Name</strong>
                                            <span class="mgmt-teaser">@DescriptionTeaser(item.Description)</span>
                                            @if (item.Status == ItemStatus.Denied && !string.IsNullOrEmpty(item.DenialReason))
                                            {
                                                <div class="mgmt-denial">
                                                    <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                                                    <div>
                                                        <strong>Denial Reason:</strong> @item.DenialReason
                                                        @if (item.DeniedAt.HasValue)
                                                        {
                                                            <br>
                                                            <span>Denied on @Html.LocalTime(item.DeniedAt.Value, "date")</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td><partial name="_ShopTypeChip" model="item.Type" /></td>
                                        <td><partial name="_ShopRarityChip" model="item.Rarity" /></td>
                                        <td>@item.Price gp</td>
                                        <td><partial name="_ShopManagementStockBadge" model="item.Quantity" /></td>
                                        <td><partial name="_ShopStatusBadge" model="item.Status" /></td>
                                        <td>
                                            <div class="mgmt-row-actions">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm" title="View Details" aria-label="View item">
                                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                                </a>
                                                <a href="/ShopManagement/Edit/@item.Id" class="btn btn-warning btn-sm" title="Edit" aria-label="Edit item">
                                                    <i class="fas fa-edit" aria-hidden="true"></i>
                                                </a>
                                                @if (item.Status == ItemStatus.Published)
                                                {
                                                    <form method="post" action="/ShopManagement/Archive/@item.Id" data-confirm-message="Are you sure you want to archive this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-secondary btn-sm" title="Archive" aria-label="Archive item">
                                                            <i class="fas fa-ban" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else if (item.Status == ItemStatus.Archived)
                                                {
                                                    <form method="post" action="/ShopManagement/Reopen/@item.Id" data-confirm-message="Are you sure you want to reopen this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm" title="Reopen" aria-label="Reopen item">
                                                            <i class="fas fa-undo" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Draft && isAdmin)
                                                {
                                                    <form method="post" action="/ShopManagement/Publish/@item.Id" data-confirm-message="Are you sure you want to publish this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm" title="Publish" aria-label="Publish item">
                                                            <i class="fas fa-check" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Denied)
                                                {
                                                    <a href="/ShopManagement/Edit/@item.Id" class="btn btn-warning btn-sm" title="Edit &amp; Resubmit" aria-label="Edit &amp; Resubmit item">
                                                        <i class="fas fa-redo" aria-hidden="true"></i>
                                                    </a>
                                                }
                                                @if (item.Status == ItemStatus.Denied || (item.Status != ItemStatus.Draft && item.Status != ItemStatus.Denied && isAdmin))
                                                {
                                                    <form method="post" action="/ShopManagement/Delete/@item.Id" data-confirm-message="Are you sure you want to permanently delete this item? This action cannot be undone.">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm" title="Delete" aria-label="Delete item">
                                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-info-circle empty-state-icon" aria-hidden="true"></i>
                        <h3 class="empty-state-heading">No Items Yet</h3>
                        <p class="empty-state-text">You haven't created any shop items yet. Start by adding your first item!</p>
                        <a href="/ShopManagement/Create" class="btn btn-secondary">
                            <i class="fas fa-plus me-2" aria-hidden="true"></i>Create First Item
                        </a>
                    </div>
                }
            </div>
        </section>

        <section class="card modern-card modern-card--aside mgmt-section" aria-labelledby="mgmtOthersTitle">
            <div class="card-header modern-card-header">
                <h2 id="mgmtOthersTitle"><i class="fas fa-store me-2" aria-hidden="true"></i>All Other Published Items</h2>
                <span class="header-subtitle">(@Model.AllOtherItems.Count items from other DMs)</span>
            </div>
            <div class="card-body modern-card-body">
                @if (Model.AllOtherItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Item</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Rarity</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Stock</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Created By</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AllOtherItems.OrderBy(i => i.Name))
                                {
                                    <tr>
                                        <td>
                                            <strong class="mgmt-name">@item.Name</strong>
                                            <span class="mgmt-teaser">@DescriptionTeaser(item.Description)</span>
                                        </td>
                                        <td><partial name="_ShopTypeChip" model="item.Type" /></td>
                                        <td><partial name="_ShopRarityChip" model="item.Rarity" /></td>
                                        <td>@item.Price gp</td>
                                        <td><partial name="_ShopManagementStockBadge" model="item.Quantity" /></td>
                                        <td><partial name="_ShopStatusBadge" model="item.Status" /></td>
                                        <td>@item.CreatedByDmName</td>
                                        <td>
                                            <div class="mgmt-row-actions">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm" title="View Details" aria-label="View item">
                                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                                </a>
                                                <a href="/ShopManagement/Edit/@item.Id" class="btn btn-warning btn-sm" title="Edit" aria-label="Edit item">
                                                    <i class="fas fa-edit" aria-hidden="true"></i>
                                                </a>
                                                @if (item.Status == ItemStatus.Published)
                                                {
                                                    <form method="post" action="/ShopManagement/Archive/@item.Id" data-confirm-message="Are you sure you want to archive this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-secondary btn-sm" title="Archive" aria-label="Archive item">
                                                            <i class="fas fa-ban" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else if (item.Status == ItemStatus.Archived)
                                                {
                                                    <form method="post" action="/ShopManagement/Reopen/@item.Id" data-confirm-message="Are you sure you want to reopen this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm" title="Reopen" aria-label="Reopen item">
                                                            <i class="fas fa-undo" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Draft || isAdmin)
                                                {
                                                    <form method="post" action="/ShopManagement/Delete/@item.Id" data-confirm-message="Are you sure you want to permanently delete this item? This action cannot be undone.">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm" title="Delete" aria-label="Delete item">
                                                            <i class="fas fa-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-info-circle empty-state-icon" aria-hidden="true"></i>
                        <h3 class="empty-state-heading">No Other Items</h3>
                        <p class="empty-state-text">No other DMs have published items yet.</p>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

<partial name="_ShopManagementDialogs" />

@section Styles {
    <link rel="stylesheet" href="~/css/shop-pages.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
    <script type="module" src="~/js/shop-management.js" asp-append-version="true"></script>
}
