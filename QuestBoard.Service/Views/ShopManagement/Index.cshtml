@using QuestBoard.Service.ViewModels.ShopViewModels
@model ShopManagementIndexViewModel
@inject QuestBoard.Domain.Interfaces.IMarkdownService MarkdownService
@{
    ViewData["Title"] = "Shop Management - DM Dashboard";
}

@functions {
    string DescriptionTeaser(string description)
    {
        var plain = MarkdownService.ExtractPlainText(description);
        return plain.Length > 50 ? plain.Substring(0, 50) + "..." : plain;
    }
}

<div class="container-fluid">
    <div class="card modern-card">
        <div class="card-header modern-card-header">
            <h2 class="mb-0">
                <i class="fas fa-store text-warning me-2"></i>
                Shop Management Dashboard
            </h2>
        </div>
        <div class="card-body modern-card-body">
            <!-- Action Buttons -->
            <div class="d-flex gap-3 mb-4">
                <a href="/ShopManagement/Create" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Add New Item
                </a>
                <a href="/Shop" class="btn btn-outline-primary">
                    <i class="fas fa-store me-2"></i>View Shop
                </a>
                <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#bulkActionsModal">
                    <i class="fas fa-tasks me-2"></i>Bulk Actions
                </button>
            </div>

            <!-- Items Pending Review Section -->
            @if (Model.ItemsForReview.Any())
            {
                <div class="mb-5">
                    <h4 class="text-warning mb-3">
                        <i class="fas fa-clock me-2"></i>Items Awaiting Review
                        <small class="text-muted">(@Model.ItemsForReview.Count items need DM votes)</small>
                    </h4>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Rarity</th>
                                    <th>Price</th>
                                    <th>Submitted By</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ItemsForReview)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                            <br><small class="text-muted">@DescriptionTeaser(item.Description)</small>
                                        </td>
                                        <td>
                                            <partial name="_ShopTypeChip" model="item.Type" />
                                        </td>
                                        <td>
                                            <partial name="_ShopRarityChip" model="item.Rarity" />
                                        </td>
                                        <td>@item.Price gp</td>
                                        <td>@item.CreatedByDmName</td>
                                        <td>
                                            <partial name="_ShopStatusBadge" model="item.Status" />
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm btn-action" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <form method="post" action="/ShopManagement/Publish/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to publish this item?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-sm btn-action" title="Publish">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-danger btn-sm btn-action" title="Deny" 
                                                        data-bs-toggle="modal" data-bs-target="#denyModal" 
                                                        data-deny-url="/ShopManagement/Deny/@item.Id" data-deny-name="@item.Name">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- My Items Section -->
            <div class="mb-4">
                <h4 class="text-primary mb-3">
                    <i class="fas fa-user-cog me-2"></i>My Items
                    <small class="text-muted">(@Model.MyItems.Count items)</small>
                </h4>

                @if (Model.MyItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Rarity</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MyItems.OrderByDescending(i => i.Id))
                                {
                                    <tr class="@(item.Status == ItemStatus.Draft ? "table-warning" : item.Status == ItemStatus.Denied ? "table-danger" : "")">
                                        <td>
                                            <strong>@item.Name</strong>
                                            <br><small class="text-muted">@DescriptionTeaser(item.Description)</small>
                                            @if (item.Status == ItemStatus.Denied && !string.IsNullOrEmpty(item.DenialReason))
                                            {
                                                <br>
                                                <div class="alert alert-danger mt-2 mb-0 py-1 px-2">
                                                    <small>
                                                        <i class="fas fa-exclamation-circle me-1"></i>
                                                        <strong>Denial Reason:</strong> @item.DenialReason
                                                        @if (item.DeniedAt.HasValue)
                                                        {
                                                            <br>
                                                            <span class="text-muted">Denied on @Html.LocalTime(item.DeniedAt.Value, "date")</span>
                                                        }
                                                    </small>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <partial name="_ShopTypeChip" model="item.Type" />
                                        </td>
                                        <td>
                                            <partial name="_ShopRarityChip" model="item.Rarity" />
                                        </td>
                                        <td>@item.Price gp</td>
                                        <td>
                                            @if (item.Quantity == -1)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-infinity me-1"></i>Unlimited
                                                </span>
                                            }
                                            else if (item.Quantity == 0)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle me-1"></i>Sold Out
                                                </span>
                                            }
                                            else if (item.Quantity <= 5)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>@item.Quantity left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="fas fa-box me-1"></i>@item.Quantity
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <partial name="_ShopStatusBadge" model="item.Status" />
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm btn-action" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/ShopManagement/Edit/@item.Id" class="btn btn-primary btn-sm btn-action" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (item.Status == ItemStatus.Published)
                                                {
                                                    <form method="post" action="/ShopManagement/Archive/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to archive this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-secondary btn-sm btn-action" title="Archive">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else if (item.Status == ItemStatus.Archived)
                                                {
                                                    <form method="post" action="/ShopManagement/Reopen/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to reopen this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm btn-action" title="Reopen">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Draft && (await AuthorizationService.AuthorizeAsync(User, "AdminOnly")).Succeeded)
                                                {
                                                    <form method="post" action="/ShopManagement/Publish/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to publish this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm btn-action" title="Publish">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Denied)
                                                {
                                                    <a href="/ShopManagement/Edit/@item.Id" class="btn btn-warning btn-sm btn-action" title="Edit & Resubmit">
                                                        <i class="fas fa-redo"></i>
                                                    </a>
                                                }
                                                @if (item.Status == ItemStatus.Denied || (item.Status != ItemStatus.Draft && item.Status != ItemStatus.Denied && (await AuthorizationService.AuthorizeAsync(User, "AdminOnly")).Succeeded))
                                                {
                                                    <form method="post" action="/ShopManagement/Delete/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to permanently delete this item? This action cannot be undone.">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm btn-action" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center py-4">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <h5>No Items Yet</h5>
                        <p>You haven't created any shop items yet. Start by adding your first item!</p>
                        <a href="/ShopManagement/Create" class="btn btn-success">
                            <i class="fas fa-plus me-2"></i>Create First Item
                        </a>
                    </div>
                }
            </div>

            <!-- All Other Items Section -->
            <div class="mb-4">
                <h4 class="text-secondary mb-3">
                    <i class="fas fa-store me-2"></i>All Other Published Items
                    <small class="text-muted">(@Model.AllOtherItems.Count items from other DMs)</small>
                </h4>

                @if (Model.AllOtherItems.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Rarity</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Status</th>
                                    <th>Created By</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AllOtherItems.OrderBy(i => i.Name))
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Name</strong>
                                            <br><small class="text-muted">@DescriptionTeaser(item.Description)</small>
                                        </td>
                                        <td>
                                            <partial name="_ShopTypeChip" model="item.Type" />
                                        </td>
                                        <td>
                                            <partial name="_ShopRarityChip" model="item.Rarity" />
                                        </td>
                                        <td>@item.Price gp</td>
                                        <td>
                                            @if (item.Quantity == -1)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-infinity me-1"></i>Unlimited
                                                </span>
                                            }
                                            else if (item.Quantity == 0)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle me-1"></i>Sold Out
                                                </span>
                                            }
                                            else if (item.Quantity <= 5)
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>@item.Quantity left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="fas fa-box me-1"></i>@item.Quantity
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <partial name="_ShopStatusBadge" model="item.Status" />
                                        </td>
                                        <td>@item.CreatedByDmName</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/Shop/Details/@item.Id" class="btn btn-info btn-sm btn-action" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="/ShopManagement/Edit/@item.Id" class="btn btn-primary btn-sm btn-action" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (item.Status == ItemStatus.Published)
                                                {
                                                    <form method="post" action="/ShopManagement/Archive/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to archive this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-secondary btn-sm btn-action" title="Archive">
                                                            <i class="fas fa-ban"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else if (item.Status == ItemStatus.Archived)
                                                {
                                                    <form method="post" action="/ShopManagement/Reopen/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to reopen this item?">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-success btn-sm btn-action" title="Reopen">
                                                            <i class="fas fa-undo"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (item.Status == ItemStatus.Draft ||
                                                                                        (item.Status != ItemStatus.Draft && (await AuthorizationService.AuthorizeAsync(User, "AdminOnly")).Succeeded))
                                                {
                                                    <form method="post" action="/ShopManagement/Delete/@item.Id" class="d-inline" data-confirm-message="Are you sure you want to permanently delete this item? This action cannot be undone.">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm btn-action" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center py-4">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <h5>No Other Items</h5>
                        <p>No other DMs have published items yet.</p>
                    </div>
                }
            </div>

            <hr>
        </div>
    </div>
</div>

<!-- Bulk Actions Modal -->
<div class="modal fade" id="bulkActionsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Bulk Actions</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Select an action to apply to multiple items:</p>
                <div class="d-grid gap-2">
                    <button class="btn btn-warning" data-bulk-action="discontinue">
                        <i class="fas fa-ban me-2"></i>Discontinue Selected Items
                    </button>
                    <button class="btn btn-success" data-bulk-action="activate">
                        <i class="fas fa-check me-2"></i>Activate Selected Items
                    </button>
                    <button class="btn btn-info" data-bulk-action="restock">
                        <i class="fas fa-plus-circle me-2"></i>Restock Selected Items
                    </button>
                </div>
                <hr>
                <p class="small text-muted">Note: Bulk actions will be available in a future update.</p>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Deny Item Modal -->
<div class="modal fade" id="denyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <form id="denyForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">
                        <i class="fas fa-times-circle text-danger me-2"></i>
                        Deny Item
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to deny: <strong data-deny-item-name></strong></p>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        This item will be marked as denied and the creator will see your reason.
                    </div>
                    <div class="mb-3">
                        <label for="denialReason" class="form-label">
                            <i class="fas fa-comment me-1"></i>
                            Reason for Denial <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="denialReason" name="denialReason" rows="4" 
                                  placeholder="Please provide a clear reason for denying this item..." required></textarea>
                        <div class="form-text">Explain why this item cannot be approved (e.g., too powerful, doesn't fit campaign setting, etc.)</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-2"></i>Deny Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/shop-pages.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
    <script type="module" src="~/js/shop-management.js" asp-append-version="true"></script>
}
