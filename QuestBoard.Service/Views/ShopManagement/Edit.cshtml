@using QuestBoard.Service.ViewModels.ShopViewModels
@using QuestBoard.Service.ViewModels.Shared
@model EditShopItemViewModel
@{
    ViewData["Title"] = "Edit Shop Item - " + Model.Name;
    ViewData["Theme"] = "shop";
    var hasAvailabilityWindow = Model.AvailableFrom != null || Model.AvailableUntil != null;
}

<div class="card modern-card shop-form form-page">
    <div class="card-header modern-card-header">
        <h1 class="mb-0">
            <i class="fas fa-edit me-2" aria-hidden="true"></i>
            Edit Shop Item
        </h1>
    </div>
    <div class="card-body modern-card-body">
        <form asp-action="Edit" method="post" data-shop-item-form>
            <input asp-for="Id" type="hidden" />

            <div class="alert alert-info shop-form__status">
                <div>
                    <h2>
                        <i class="fas fa-info-circle me-2" aria-hidden="true"></i>Current Status
                    </h2>
                    <div class="shop-form__status-line">
                        <partial name="_ShopStatusBadge" model="Model.Status" />
                        @if (Model.Status == ItemStatus.Draft)
                        {
                            <span>This item is awaiting DM approval</span>
                        }
                    </div>
                </div>
                <span>Item ID: #@Model.Id</span>
            </div>

            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="shop-form__row shop-form__row--wide">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Item Name <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Type" class="form-label">Item Type <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                    <select asp-for="Type" class="form-select">
                        <option value="Equipment" selected="@(Model.Type == ItemType.Equipment)">Equipment</option>
                        <option value="MagicItem" selected="@(Model.Type == ItemType.MagicItem)">Magic Item</option>
                        <option value="QuestItems" selected="@(Model.Type == ItemType.QuestItems)">Quest Item</option>
                    </select>
                    <span asp-validation-for="Type" class="field-validation-error"></span>
                </div>
            </div>

            @{ await Html.RenderPartialAsync("_MarkdownEditor", new MarkdownEditorViewModel
               {
                   FieldName = "Description",
                   Value = Model.Description,
                   Label = "Description",
                   Required = true,
                   Placeholder = "Describe the item's appearance, properties, and lore..."
               }); }

            <div class="shop-form__row">
                <div class="mb-3">
                    <label asp-for="Rarity" class="form-label">Rarity <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                    <select asp-for="Rarity" class="form-select">
                        <option value="Common" selected="@(Model.Rarity == ItemRarity.Common)">Common</option>
                        <option value="Uncommon" selected="@(Model.Rarity == ItemRarity.Uncommon)">Uncommon</option>
                        <option value="Rare" selected="@(Model.Rarity == ItemRarity.Rare)">Rare</option>
                        <option value="VeryRare" selected="@(Model.Rarity == ItemRarity.VeryRare)">Very Rare</option>
                        <option value="Legendary" selected="@(Model.Rarity == ItemRarity.Legendary)">Legendary</option>
                    </select>
                    <span asp-validation-for="Rarity" class="field-validation-error"></span>
                    @if (Model.Status == ItemStatus.Draft)
                    {
                        <div class="form-text">
                            <i class="fas fa-exclamation-triangle me-1" aria-hidden="true"></i>
                            Changes to rarity may require re-approval
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" class="form-control" min="-1" aria-describedby="Quantity-help" />
                    <span asp-validation-for="Quantity" class="field-validation-error"></span>
                    <div id="Quantity-help" class="form-text">Set to -1 for unlimited stock, 0 means sold out, positive numbers for limited stock</div>
                </div>
            </div>

            <div class="shop-form__row">
                <div class="mb-3">
                    <label for="Price" class="form-label">Price (Gold Pieces) <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                    <div class="input-group">
                        <input asp-for="Price" type="number" class="form-control" min="0" step="0.01" aria-describedby="price-suggestion" />
                        <button type="button" class="btn btn-secondary" id="randomPriceBtn" data-random-price title="Set random price within rarity range" aria-label="Set random price within rarity range">
                            <i class="fas fa-dice" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn btn-info" id="calculatedPriceBtn" data-calculated-price title="Use Tasha's recommended price" aria-label="Use Tasha's recommended price">
                            <i class="fas fa-hat-wizard" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Price" class="field-validation-error"></span>
                    <div class="form-text shop-form__hint" id="price-suggestion" aria-live="polite">Select a rarity to see pricing suggestions.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ReferenceUrl" class="form-label"></label>
                    <input asp-for="ReferenceUrl" type="url" class="form-control" aria-describedby="ReferenceUrl-help" />
                    <span asp-validation-for="ReferenceUrl" class="field-validation-error"></span>
                    <div id="ReferenceUrl-help" class="form-text">Optional D&amp;D Beyond link for reference</div>
                </div>
            </div>

            <h2 class="shop-form__section-title">
                <i class="fas fa-clock" aria-hidden="true"></i>Availability Window
            </h2>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="enableAvailabilityWindow" data-availability-toggle aria-describedby="enableAvailabilityWindow-help" checked="@hasAvailabilityWindow" />
                <label class="form-check-label" for="enableAvailabilityWindow">
                    Set specific availability dates for this item
                </label>
                <div id="enableAvailabilityWindow-help" class="form-text">Check this to set when the item should be available in the shop. Leave unchecked for permanent availability.</div>
            </div>
            <div class="shop-form__row">
                <div class="mb-3">
                    <label asp-for="AvailableFrom" class="form-label"></label>
                    <input asp-for="AvailableFrom" type="datetime-local" class="form-control" disabled="@(!hasAvailabilityWindow)" />
                    <span asp-validation-for="AvailableFrom" class="field-validation-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AvailableUntil" class="form-label"></label>
                    <input asp-for="AvailableUntil" type="datetime-local" class="form-control" disabled="@(!hasAvailabilityWindow)" />
                    <span asp-validation-for="AvailableUntil" class="field-validation-error"></span>
                </div>
            </div>

            @if (Model.Status == ItemStatus.Draft)
            {
                <div class="alert alert-warning">
                    <h2 class="shop-form__section-title mt-0">
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>Item Under Review
                    </h2>
                    <p class="mb-0">This item is currently being reviewed by other Dungeon Masters. Major changes may require re-approval.</p>
                </div>
            }

            <hr>

            <div class="form-actions">
                <a href="/ShopManagement" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Management
                </a>
                <div class="shop-form__actions-end">
                    <a href="/Shop/Details/@Model.Id" class="btn btn-info">
                        <i class="fas fa-eye me-2" aria-hidden="true"></i>View Details
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2" aria-hidden="true"></i>Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/shop-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-form.css" asp-append-version="true" />
}

@section Scripts {
    @{ await Html.RenderPartialAsync("~/Views/Quest/_QuestFormScripts.cshtml"); }
    <script type="module" src="~/js/shop-item-form.js" asp-append-version="true"></script>
}
