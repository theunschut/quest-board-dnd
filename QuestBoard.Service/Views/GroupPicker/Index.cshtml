@using QuestBoard.Service.ViewModels.GroupPickerViewModels
@model GroupPickerViewModel
@{
    ViewData["Title"] = "Select Your Group";
    Layout = "~/Views/Shared/_Layout.GroupPicker.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/group-picker.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        @if (Model.IsSuperAdmin)
        {
            <div class="d-grid mb-3">
                <a href="/platform" class="btn btn-secondary btn-lg">
                    <i class="fas fa-cog me-2" aria-hidden="true"></i>Go to Platform
                </a>
            </div>
        }

        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-layer-group me-2" aria-hidden="true"></i>
                    Select Your Group
                </h1>
            </div>
            <div class="card-body modern-card-body">
                @if (Model.HasNoGroups)
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
                        Your account is not assigned to any group. Please contact your administrator.
                    </div>
                }
                else
                {
                    <ul class="group-picker-list" role="list">
                        @foreach (var group in Model.Groups)
                        {
                            <li>
                                <form asp-action="SelectGroup" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="groupId" value="@group.Id" />
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button type="submit" class="group-picker-row">
                                        <span class="group-picker-text">
                                            <span class="group-picker-name">@group.Name</span>
                                            <span class="group-picker-meta"><i class="fas fa-users me-1" aria-hidden="true"></i>@group.MemberCount member(s)</span>
                                        </span>
                                        <i class="fas fa-chevron-right group-picker-chevron" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
