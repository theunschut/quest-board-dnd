@using QuestBoard.Service.ViewModels.ShopViewModels
@using QuestBoard.Domain.Enums
@using Microsoft.AspNetCore.Http
@model ShopIndexViewModel
@inject QuestBoard.Domain.Interfaces.IMarkdownService MarkdownService
@{
    ViewData["Title"] = "The Mystical Merchant's Emporium";
    ViewData["Theme"] = "shop";
}

@section Styles {
    <link rel="stylesheet" href="~/css/markdown-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-pages.css" asp-append-version="true" />
}

@functions {
    string BuildTabUrl(ItemType? tabType, IList<ItemRarity> rarities, string? sort, string? search = null)
    {
        var pairs = new List<KeyValuePair<string, string?>>();
        if (tabType.HasValue)
            pairs.Add(new("type", tabType.Value.ToString()));
        foreach (var r in rarities)
            pairs.Add(new("rarity", r.ToString()));
        if (!string.IsNullOrEmpty(sort))
            pairs.Add(new("sort", sort));
        if (!string.IsNullOrEmpty(search))
            pairs.Add(new("search", search));
        // page intentionally omitted — tab switch resets to page 1
        return Url.Action("Index", "Shop") + Microsoft.AspNetCore.Http.QueryString.Create(pairs).Value;
    }

    string BuildPageUrl(int pageNumber)
    {
        var pairs = new List<KeyValuePair<string, string?>>();
        if (Model.SelectedType.HasValue)
            pairs.Add(new("type", Model.SelectedType.Value.ToString()));
        foreach (var r in Model.SelectedRarities)
            pairs.Add(new("rarity", r.ToString()));
        if (!string.IsNullOrEmpty(Model.SelectedSort))
            pairs.Add(new("sort", Model.SelectedSort));
        if (!string.IsNullOrEmpty(Model.SearchQuery))
            pairs.Add(new("search", Model.SearchQuery));
        if (pageNumber > 1)
            pairs.Add(new("page", pageNumber.ToString()));
        return Url.Action("Index", "Shop") + Microsoft.AspNetCore.Http.QueryString.Create(pairs).Value;
    }

    IEnumerable<int?> PageWindow(int current, int total)
    {
        var pages = new SortedSet<int> { 1, total };
        for (int i = Math.Max(1, current - 2); i <= Math.Min(total, current + 2); i++)
            pages.Add(i);

        int? prev = null;
        foreach (var p in pages)
        {
            if (prev.HasValue && p - prev.Value > 1)
                yield return null; // ellipsis
            yield return p;
            prev = p;
        }
    }
}

<!-- Purchase History Side Panel -->
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="purchase-history-panel">
        <div class="panel-header">
            <h6 class="mb-0">
                <i class="fas fa-history me-2"></i>My Transactions
            </h6>
        </div>
        <div class="panel-body">
            @if (Model.UserPurchases?.Any() == true)
            {
                <div class="purchase-list">
                    @foreach (var purchase in Model.UserPurchases.Take(15))
                    {
                        @if (purchase.TransactionType == QuestBoard.Domain.Enums.TransactionType.Purchase)
                        {
                            var timeSincePurchase = DateTime.UtcNow - purchase.TransactionDate;
                            var canReturn = timeSincePurchase.TotalHours <= 24;
                            var hasRemainingItems = purchase.RemainingQuantity > 0;

                            <div class="purchase-item mb-2 p-2 position-relative @(!hasRemainingItems ? "sold-returned" : "")">
                                <div class="purchase-name fw-bold text-truncate" title="@purchase.ItemName">
                                    @purchase.ItemName
                                    @if (!hasRemainingItems)
                                    {
                                        <span class="purchase-details-text">(Fully Returned/Sold)</span>
                                    }
                                </div>
                                <div class="purchase-details d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-sort-numeric-up me-1"></i>
                                        @if (hasRemainingItems && purchase.RemainingQuantity != purchase.Quantity)
                                        {
                                            @purchase.RemainingQuantity<text>/</text>@purchase.Quantity
                                        }
                                        else
                                        {
                                            @purchase.Quantity
                                        }
                                    </small>
                                    <small class="text-warning">
                                        <i class="fas fa-coins me-1"></i>@purchase.Price gp
                                    </small>
                                </div>
                                <small class="text-muted d-block">
                                    <i class="fas fa-clock me-1"></i>@Html.LocalTime(purchase.TransactionDate, "date-compact")
                                </small>

                                <!-- Return/Sell buttons (shown on hover, only if items remaining) -->
                                @if (hasRemainingItems)
                                {
                                    <div class="return-sell-buttons position-absolute">
                                        @if (canReturn)
                                        {
                                            <form method="post" asp-controller="Shop" asp-action="Sell" class="d-inline">
                                                <input type="hidden" name="id" value="@purchase.Id" />
                                                <input type="hidden" name="quantity" value="@purchase.RemainingQuantity" />
                                                <button type="submit" class="btn btn-success btn-sm me-1" title="Return @purchase.RemainingQuantity item(s) for full price (within 24h)">
                                                    <i class="fas fa-undo me-1"></i>Return (@purchase.RemainingQuantity)
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-controller="Shop" asp-action="Sell" class="d-inline">
                                                <input type="hidden" name="id" value="@purchase.Id" />
                                                <input type="hidden" name="quantity" value="@purchase.RemainingQuantity" />
                                                <button type="submit" class="btn btn-warning btn-sm" title="Sell @purchase.RemainingQuantity item(s) for 50% of original price">
                                                    <i class="fas fa-coins me-1"></i>Sell (@purchase.RemainingQuantity)
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="purchase-item mb-2 p-2">
                                <div class="purchase-name fw-bold text-truncate" title="@purchase.ItemName">
                                    @purchase.ItemName @(purchase.TransactionType == QuestBoard.Domain.Enums.TransactionType.Sell ? "(Sold/Returned)" : "")
                                </div>
                                <div class="purchase-details d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        <i class="fas fa-sort-numeric-up me-1"></i>@purchase.Quantity
                                    </small>
                                    <small class="@(purchase.TransactionType == QuestBoard.Domain.Enums.TransactionType.Sell ? "text-success" : "text-warning")">
                                        <i class="fas fa-coins me-1"></i>@(purchase.TransactionType == QuestBoard.Domain.Enums.TransactionType.Sell ? "+" : "")@purchase.Price gp
                                    </small>
                                </div>
                                <small class="text-muted d-block">
                                    <i class="fas fa-clock me-1"></i>@Html.LocalTime(purchase.TransactionDate, "date-compact")
                                </small>
                            </div>
                        }
                    }
                </div>
                @if (Model.UserPurchases.Count > 15)
                {
                    <div class="text-center mt-2">
                        <small class="text-muted">Showing latest 15 purchases</small>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted p-3">
                    <i class="fas fa-shopping-cart fa-2x mb-2 opacity-50"></i>
                    <p class="mb-0">No purchases yet</p>
                    <small>Your purchase history will appear here</small>
                </div>
            }
        </div>
    </div>
}

<div class="shop-container @(User.Identity?.IsAuthenticated == true ? "with-panel" : "")">
    <div class="shop-page">
        <div class="shop-hero">
            <h1 class="shop-hero__title"><i class="fas fa-store" aria-hidden="true"></i>The Mystical Merchant's Emporium</h1>
            <p class="shop-hero__sub">"Welcome, adventurer! Browse my wares and find what you seek..."</p>
        </div>

        <nav class="category-tabs" aria-label="Item categories">
            <a href="@BuildTabUrl(null, Model.SelectedRarities, Model.SelectedSort, Model.SearchQuery)" class="category-btn"
               aria-current="@(Model.SelectedType == null ? "page" : null)">
                <i class="fas fa-list" aria-hidden="true"></i>All Items
            </a>
            <a href="@BuildTabUrl(ItemType.Equipment, Model.SelectedRarities, Model.SelectedSort, Model.SearchQuery)" class="category-btn"
               aria-current="@(Model.SelectedType == ItemType.Equipment ? "page" : null)">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>Equipment
            </a>
            <a href="@BuildTabUrl(ItemType.MagicItem, Model.SelectedRarities, Model.SelectedSort, Model.SearchQuery)" class="category-btn"
               aria-current="@(Model.SelectedType == ItemType.MagicItem ? "page" : null)">
                <i class="fas fa-magic" aria-hidden="true"></i>Magic Items
            </a>
            <a href="@BuildTabUrl(ItemType.QuestItems, Model.SelectedRarities, Model.SelectedSort, Model.SearchQuery)" class="category-btn"
               aria-current="@(Model.SelectedType == ItemType.QuestItems ? "page" : null)">
                <i class="fas fa-scroll" aria-hidden="true"></i>Quest Items
            </a>
        </nav>

        @{
            var allRarities = Enum.GetValues<ItemRarity>();
        }
        <div class="modern-card modern-card--aside shop-filter-card">
            <div class="modern-card-header">
                <h2><i class="fas fa-filter me-2" aria-hidden="true"></i>Filter &amp; Sort</h2>
                @if (Model.HasActiveFilters)
                {
                    <span class="badge bg-secondary"><i class="fas fa-filter me-1" aria-hidden="true"></i>Active</span>
                }
            </div>
            <div class="modern-card-body">
                <form method="get" action="@Url.Action("Index", "Shop")" id="shop-filter-form">
                    @if (Model.SelectedType != null)
                    {
                        <input type="hidden" name="type" value="@Model.SelectedType" />
                    }

                    <fieldset class="filter-rarity">
                        <legend class="shop-filter-label">Rarity</legend>
                        <div class="filter-rarity__grid">
                            @foreach (var r in allRarities)
                            {
                                <label class="filter-check">
                                    <input class="form-check-input" type="checkbox" name="rarity" value="@r" @(Model.SelectedRarities.Contains(r) ? "checked" : "") />
                                    <partial name="_ShopRarityChip" model="r" />
                                </label>
                            }
                        </div>
                    </fieldset>

                    <div class="filter-controls">
                        <div class="filter-search">
                            <div class="input-group">
                                <label for="shopSearch" class="visually-hidden">Search items</label>
                                <input type="text" id="shopSearch" name="search" class="form-control"
                                       placeholder="Search items by name or description..."
                                       value="@Model.SearchQuery" autocomplete="off" />
                                <button type="submit" class="btn btn-secondary">
                                    <i class="fas fa-search me-2" aria-hidden="true"></i>Search
                                </button>
                            </div>
                        </div>

                        <div class="filter-sort">
                            <label for="sortSelect" class="shop-filter-label">Sort</label>
                            <select id="sortSelect" name="sort" class="form-select">
                                <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedSort))">Default</option>
                                <option value="price_asc" selected="@(Model.SelectedSort == "price_asc")">Price &#8593;</option>
                                <option value="price_desc" selected="@(Model.SelectedSort == "price_desc")">Price &#8595;</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-secondary">
                                <i class="fas fa-filter me-2" aria-hidden="true"></i>Apply Filters
                            </button>
                            @if (Model.HasActiveFilters)
                            {
                                <a href="@Url.Action("Index", "Shop", Model.SelectedType != null ? new { type = Model.SelectedType } : null)" class="btn btn-secondary">
                                    <i class="fas fa-times me-2" aria-hidden="true"></i>Clear Filters
                                </a>
                            }
                        </div>
                    </div>

                    <input type="hidden" name="page" value="1" />
                </form>
            </div>
        </div>

        <h2 class="visually-hidden">Items</h2>
        @if (Model.Items?.Any() == true)
        {
            <div class="inventory-grid" id="inventory-grid">
                @foreach (var item in Model.Items)
                {
                    var detailsUrl = Url.Action("Details", "Shop", new { id = item.Id, isModal = true });
                    var stockModifier = item.Quantity == -1 ? "unlimited" : (item.Quantity == 0 ? "soldout" : (item.Quantity <= 5 ? "low" : null));
                    var plainDescription = MarkdownService.ExtractPlainText(item.Description);
                    var shortDescription = plainDescription.Length > 120
                        ? plainDescription.Substring(0, 120) + "..."
                        : plainDescription;

                    <div class="modern-card modern-card--interactive shop-card item-card" data-item-card data-item-url="@detailsUrl">
                        <div class="shop-card__head">
                            <h3 class="shop-card__name">
                                <a class="row-nav-link" href="@Url.Action("Details", "Shop", new { id = item.Id })"
                                   data-bs-toggle="modal" data-bs-target="#itemDetailsModal"
                                   data-item-url="@detailsUrl">@item.Name</a>
                            </h3>
                            <partial name="_ShopRarityChip" model="item.Rarity" />
                        </div>

                        <p class="shop-card__excerpt">@shortDescription</p>

                        <div class="shop-card__foot">
                            <span class="shop-card__price"><i class="fas fa-coins" aria-hidden="true"></i>@item.Price gp</span>
                            <span class="shop-card__stock@(stockModifier != null ? $" shop-card__stock--{stockModifier}" : "")">
                                @if (item.Quantity == -1)
                                {
                                    <i class="fas fa-infinity" aria-hidden="true"></i><text>Unlimited</text>
                                }
                                else if (item.Quantity == 0)
                                {
                                    <i class="fas fa-times-circle" aria-hidden="true"></i><text>Sold Out</text>
                                }
                                else if (item.Quantity <= 5)
                                {
                                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i><text>@item.Quantity left</text>
                                }
                                else
                                {
                                    <i class="fas fa-box" aria-hidden="true"></i><text>@item.Quantity in stock</text>
                                }
                            </span>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button type="button" class="btn btn-primary w-100 shop-card__action"
                                    data-bs-toggle="modal" data-bs-target="#itemDetailsModal"
                                    data-item-url="@detailsUrl"
                                    @(item.Status != QuestBoard.Domain.Enums.ItemStatus.Published || item.Quantity == 0 ? "disabled" : "")>
                                <i class="fas fa-shopping-cart me-2" aria-hidden="true"></i>Purchase
                            </button>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")" class="btn btn-primary w-100 shop-card__action" title="Login required">
                                <i class="fas fa-lock me-2" aria-hidden="true"></i>Login to Purchase
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="modern-card">
                <div class="empty-state">
                    @if (Model.HasActiveSearch)
                    {
                        <i class="fas fa-search empty-state-icon" aria-hidden="true"></i>
                        <h3 class="empty-state-heading">No items match your search</h3>
                        <p class="empty-state-text">Try a different name or adjust your filters.</p>
                        <a href="@BuildTabUrl(Model.SelectedType, Model.SelectedRarities, Model.SelectedSort, null)" class="btn btn-secondary">
                            <i class="fas fa-times me-2" aria-hidden="true"></i>Clear search
                        </a>
                    }
                    else if (Model.HasActiveFilters)
                    {
                        <i class="fas fa-filter empty-state-icon" aria-hidden="true"></i>
                        <h3 class="empty-state-heading">No items match your filters</h3>
                        <p class="empty-state-text">Try removing some rarity filters or changing the sort order.</p>
                        <a href="@Url.Action("Index", "Shop")" class="btn btn-secondary">
                            <i class="fas fa-times me-2" aria-hidden="true"></i>Clear filters
                        </a>
                    }
                    else
                    {
                        <i class="fas fa-store-slash empty-state-icon" aria-hidden="true"></i>
                        <h3 class="empty-state-heading">The shop is currently empty</h3>
                        <p class="empty-state-text">Check back later for new items, or contact a Dungeon Master about stocking the shop.</p>
                    }
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            var onFirstPage = Model.CurrentPage <= 1;
            var onLastPage = Model.CurrentPage >= Model.TotalPages;
            <nav aria-label="Shop page navigation">
                <ul class="pagination shop-pager">
                    <li class="page-item@(onFirstPage ? " disabled" : "")"><a class="page-link" href="@BuildPageUrl(Model.CurrentPage - 1)" aria-label="Previous page" aria-disabled="@(onFirstPage ? "true" : null)" tabindex="@(onFirstPage ? "-1" : null)"><i class="fas fa-chevron-left me-1" aria-hidden="true"></i>Previous</a></li>

                    @foreach (var p in PageWindow(Model.CurrentPage, Model.TotalPages))
                    {
                        if (p == null)
                        {
                            <li class="page-item disabled"><span class="page-link">&#8230;</span></li>
                        }
                        else if (p == Model.CurrentPage)
                        {
                            <li class="page-item active"><span class="page-link" aria-current="page">@p</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@BuildPageUrl(p.Value)">@p</a></li>
                        }
                    }

                    <li class="page-item@(onLastPage ? " disabled" : "")"><a class="page-link" href="@BuildPageUrl(Model.CurrentPage + 1)" aria-label="Next page" aria-disabled="@(onLastPage ? "true" : null)" tabindex="@(onLastPage ? "-1" : null)">Next<i class="fas fa-chevron-right ms-1" aria-hidden="true"></i></a></li>
                </ul>
            </nav>
            <p class="shop-count">Showing @((Model.CurrentPage - 1) * 12 + 1)&#8211;@(Math.Min(Model.CurrentPage * 12, Model.TotalItems)) of @Model.TotalItems items</p>
        }
    </div>

    <!-- Floating Merchant -->
    <div class="shop-merchant" title="Mystical Merchant" onclick="showMerchantDialog()">
        <i class="fas fa-user-tie"></i>
    </div>
</div>

@* The details dialog. shop-item-modal.js fills the body from the address on the card or button that opened it. *@
<div class="modal fade" id="itemDetailsModal" tabindex="-1" aria-labelledby="itemDetailsTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="itemDetailsTitle">Item Details</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="itemDetailsBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/shop-item-sell.js" asp-append-version="true"></script>
    <script type="module" src="~/js/shop-item-modal.js" asp-append-version="true"></script>
    <script>
        // Show merchant dialog
        function showMerchantDialog() {
            const messages = [
                "Welcome to my shop, traveler! What can I get for you today?",
                "These items are of the finest quality, I assure you!",
                "Looking for something specific? Browse my collection!",
                "Every adventurer needs good equipment. Take a look around!",
                "Ah, another customer! Please, examine my wares carefully.",
                "Step right up! I've got potions, weapons, and magical trinkets!",
                "Don't let the dust fool you - these are genuine magical artifacts!",
                "I've been expecting you... well, someone like you anyway.",
                "Coin up front, no credit! But I guarantee satisfaction!",
                "Fresh stock from the deepest dungeons and highest towers!",
                "Quality merchandise at reasonable prices - well, mostly reasonable.",
                "Browse at your leisure, but don't touch what you can't afford!",
                "I've got items that have seen more adventure than most heroes!",
                "Each piece tells a story... usually involving previous owners' demise.",
                "Special deals for repeat customers! Are you a repeat customer?",
                "If you break it, you bought it! Magic items are particularly fragile.",
                "I accept gold, gems, and interesting tales of adventure!",
                "Need something sharpened? Enchanted? Cursed removed? I'm your man!",
                "Between you and me, that sword over there might be haunted.",
                "No returns after 24 hours - unless it tries to eat you, then we'll talk."
            ];

            const randomMessage = messages[Math.floor(Math.random() * messages.length)];
            showMerchantToast(randomMessage);
        }

        // Show merchant message as toast
        function showMerchantToast(message) {
            // Create toast element
            const toastHtml = `
                <div class="toast merchant-toast" role="alert" data-bs-autohide="true" data-bs-delay="6000">
                    <div class="toast-header bg-warning text-dark">
                        <i class="fas fa-user-tie me-2"></i>
                        <strong class="me-auto">Mystical Merchant</strong>
                        <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">
                        ${message}
                    </div>
                </div>
            `;

            // Add to toast container
            const toastContainer = document.querySelector('.toast-container');
            toastContainer.insertAdjacentHTML('beforeend', toastHtml);

            // Initialize and show the toast
            const newToast = toastContainer.lastElementChild;
            const toast = new bootstrap.Toast(newToast);
            toast.show();

            // Remove the toast element after it's hidden
            newToast.addEventListener('hidden.bs.toast', function() {
                this.remove();
            });
        }

    </script>
}
