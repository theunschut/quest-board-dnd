@using QuestBoard.Service.ViewModels.ShopViewModels
@model ShopItemDetailsViewModel
@{
    ViewData["Title"] = Model.Name + " - Shop Details";
    ViewData["Theme"] = "shop";
    var isModal = ViewBag.IsModal == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/markdown-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop-pages.mobile.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module" src="~/js/shop-item-sell.js" asp-append-version="true"></script>
}

@* The phone renders the same body as the desktop page and dialog; only the wrapper around it differs. *@
@if (isModal)
{
    <div class="item-details-content">
        <div class="item-details__head">
            <h3>@Model.Name</h3>
            <partial name="_ShopTypeChip" model="Model.Type" />
        </div>

        @await Html.PartialAsync("_ShopItemDetailsContent", Model)
    </div>
}
else
{
    <div class="item-details-content">
        <div class="card modern-card">
            <div class="card-header modern-card-header item-details__title-row">
                <h1 class="mb-0">@Model.Name</h1>
                <partial name="_ShopTypeChip" model="Model.Type" />
            </div>
            <div class="card-body modern-card-body">
                @await Html.PartialAsync("_ShopItemDetailsContent", Model)
            </div>
        </div>
    </div>
}

<div class="item-details__back">
    <a href="/Shop" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Shop
    </a>
</div>
