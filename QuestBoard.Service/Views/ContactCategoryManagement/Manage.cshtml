@using QuestBoard.Service.ViewModels.ContactViewModels
@model ContactCategoryManagementViewModel
@{
    ViewData["Title"] = "Manage Categories";
}

@section Styles {
    <link href="~/css/contact-categories.css" asp-append-version="true" rel="stylesheet" />
}

<div class="contact-categories-page">
    <div class="card modern-card mb-4">
        <div class="card-header modern-card-header">
            <h1 class="mb-0">
                <i class="fas fa-tags me-2" aria-hidden="true"></i>Manage Categories
            </h1>
        </div>
        <div class="card-body modern-card-body">
            <form asp-action="Add" method="post" class="category-add-form row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-sm-8 col-md-6">
                    <label asp-for="NewCategory.Name" class="form-label">New Category Name</label>
                    <input asp-for="NewCategory.Name" class="form-control" maxlength="60" placeholder="e.g. Guild Members" />
                    <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
                </div>
                <div class="col-sm-4 col-md-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Category
                    </button>
                </div>
            </form>
        </div>
    </div>

    <section class="card modern-card modern-card--aside mb-4">
        <div class="card-body modern-card-body">
            @if (Model.Categories.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle" aria-label="Manage Categories">
                        <thead>
                            <tr>
                                <th scope="col" class="category-col-order">Order</th>
                                <th scope="col" class="category-col-name">Name</th>
                                <th scope="col" class="category-col-contacts">Contacts</th>
                                <th scope="col" class="text-end category-col-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model.Categories)
                            {
                                var confirmMessage = category.ContactCount > 0
                                    ? $"Delete \"{category.Name}\"? This will move {category.ContactCount} contact{(category.ContactCount == 1 ? "" : "s")} to Ungrouped."
                                    : $"Delete \"{category.Name}\"? It has no contacts to move.";
                                <tr id="category-@category.Id-row" tabindex="-1">
                                    <td>
                                        <div class="btn-group" role="group" aria-label="Reorder @category.Name">
                                            <form asp-action="MoveUp" asp-route-id="@category.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-secondary btn-sm"
                                                        aria-label="Move @category.Name up" disabled="@category.IsFirst">
                                                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                            <form asp-action="MoveDown" asp-route-id="@category.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-secondary btn-sm"
                                                        aria-label="Move @category.Name down" disabled="@category.IsLast">
                                                    <i class="fas fa-arrow-down" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                    <td>@category.Name</td>
                                    <td>@category.ContactCount</td>
                                    <td class="text-end category-col-actions">
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-warning btn-sm me-2">
                                            <i class="fas fa-pen me-1" aria-hidden="true"></i>Rename
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline category-delete-form"
                                              data-confirm-message="@confirmMessage">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash me-1" aria-hidden="true"></i>Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-tags empty-state-icon" aria-hidden="true"></i>
                    <h2 class="empty-state-heading">No Categories Yet</h2>
                    <p class="empty-state-text">Add your first category above to start grouping your contacts.</p>
                </div>
            }
        </div>
    </section>

    <a href="@Url.Action("Index", "Contacts")" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Back to Contacts
    </a>
</div>

@section Scripts {
    <script type="module" src="~/js/confirm-submit.js" asp-append-version="true"></script>
}
