@using QuestBoard.Service.ViewModels.ContactViewModels
@model ContactCategoryManagementViewModel
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="contacts-page">
    <div class="card modern-card">
        <div class="card-header modern-card-header">
            <h2 class="mb-0">
                <i class="fas fa-tags text-warning me-2"></i>
                Manage Categories
            </h2>
        </div>
        <div class="card-body modern-card-body">
            <form asp-action="Add" method="post" class="row g-2 align-items-end mb-4">
                @Html.AntiForgeryToken()
                <div class="col-sm-8 col-md-6">
                    <label asp-for="NewCategory.Name" class="form-label">New Category Name</label>
                    <input asp-for="NewCategory.Name" class="form-control" maxlength="60" placeholder="e.g. Guild Members" />
                    <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
                </div>
                <div class="col-sm-4 col-md-auto">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-plus me-2"></i>Add Category
                    </button>
                </div>
            </form>

            <hr />

            @if (Model.Categories.Any())
            {
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 100px;">Order</th>
                            <th scope="col">Name</th>
                            <th scope="col" style="width: 110px;">Contacts</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr id="category-@category.Id-row" tabindex="-1">
                                <td>
                                    <div class="btn-group" role="group" aria-label="Reorder @category.Name">
                                        <form asp-action="MoveUp" asp-route-id="@category.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    aria-label="Move @category.Name up" disabled="@category.IsFirst">
                                                <i class="fas fa-arrow-up"></i>
                                            </button>
                                        </form>
                                        <form asp-action="MoveDown" asp-route-id="@category.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                    aria-label="Move @category.Name down" disabled="@category.IsLast">
                                                <i class="fas fa-arrow-down"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                <td>@category.Name</td>
                                <td>@category.ContactCount</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning me-2">
                                        <i class="fas fa-pen me-1"></i>Rename
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline category-delete-form"
                                          data-category-name="@category.Name" data-contact-count="@category.ContactCount">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash me-1"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                    <h4>No Categories Yet</h4>
                    <p class="text-muted">Add your first category above to start grouping your contacts.</p>
                </div>
            }

            <hr />
            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index", "Contacts")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Contacts
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.category-delete-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                var name = form.dataset.categoryName;
                var count = parseInt(form.dataset.contactCount, 10);
                var message = count > 0
                    ? 'Delete "' + name + '"? This will move ' + count + ' contact' + (count === 1 ? '' : 's') + ' to Ungrouped.'
                    : 'Delete "' + name + '"? It has no contacts to move.';
                if (!confirm(message)) {
                    e.preventDefault();
                }
            });
        });

        if (location.hash) {
            var target = document.querySelector(location.hash);
            if (target) {
                target.focus({ preventScroll: false });
            }
        }
    </script>
}
