@using QuestBoard.Service.ViewModels.ContactViewModels
@model ContactCategoryViewModel
@{
    ViewData["Title"] = "Rename Category";
}

<div class="form-page">
    <div class="row g-0 justify-content-center">
        <div class="col-md-6">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h1 class="mb-0">
                        <i class="fas fa-pen me-2" aria-hidden="true"></i>
                        Rename Category
                    </h1>
                </div>
                <div class="card-body modern-card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Category Name <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span></label>
                            <input asp-for="Name" class="form-control" maxlength="60" />
                            <span asp-validation-for="Name"></span>
                        </div>

                        <hr />

                        <div class="form-actions">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-pen me-2" aria-hidden="true"></i>Rename
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
