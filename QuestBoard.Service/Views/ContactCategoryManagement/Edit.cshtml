@using QuestBoard.Service.ViewModels.ContactViewModels
@model ContactCategoryViewModel
@{
    ViewData["Title"] = "Rename Category";
}

<div class="contacts-page">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card modern-card">
                <div class="card-header modern-card-header">
                    <h2 class="mb-0">
                        <i class="fas fa-pen text-warning me-2"></i>
                        Rename Category
                    </h2>
                </div>
                <div class="card-body modern-card-body">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Category Name</label>
                            <input asp-for="Name" class="form-control" maxlength="60" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-pen me-2"></i>Rename
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
