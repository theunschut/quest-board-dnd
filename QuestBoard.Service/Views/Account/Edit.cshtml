@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.AccountViewModels
@model EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-user-edit me-2" aria-hidden="true"></i>
                    @ViewData["Title"]
                </h1>
            </div>
            <div class="card-body modern-card-body">
                <form asp-action="Edit" method="post">
                    @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelEntry) && modelEntry.Errors.Count > 0)
                    {
                        <div role="alert" class="refusal-line mb-3">
                            <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Name"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="HasKey" class="form-check-input" type="checkbox" />
                        <label asp-for="HasKey" class="form-check-label">Has Building Key</label>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h2 class="section-heading mb-2">Password Management</h2>
                        <p class="text-muted">Want to change your password?</p>
                        <a asp-action="ChangePassword" class="btn btn-secondary">
                            <i class="fas fa-key me-2" aria-hidden="true"></i>
                            Change Password
                        </a>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="Profile" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>
                            Back to Profile
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2" aria-hidden="true"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
