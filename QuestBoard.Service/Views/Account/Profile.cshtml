@using QuestBoard.Domain.Interfaces
@using QuestBoard.Service.ViewModels.AccountViewModels
@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="row justify-content-center">
    <!-- Widened from col-md-6: the Calendar Subscription section below is a per-row list
         with an address field and four controls per row, which does not fit a half-width
         card. Accepted at design time as something that will dominate this page. -->
    <div class="col-lg-9 col-md-11">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">
                    <i class="fas fa-user-cog me-2" aria-hidden="true"></i>
                    @ViewData["Title"]
                </h1>
            </div>
            <div class="card-body modern-card-body">
                <dl class="row profile-fields">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.User?.Name</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.User?.Email</dd>

                    <dt class="col-sm-3">Account Type</dt>
                    @if ((bool?)ViewData["IsAdmin"] == true)
                    {
                        <dd class="col-sm-9"><i class="fas fa-shield-alt text-danger me-2" aria-hidden="true"></i>Administrator</dd>
                    }
                    else if ((bool?)ViewData["IsDungeonMaster"] == true)
                    {
                        <dd class="col-sm-9"><i class="fas fa-crown text-warning me-2" aria-hidden="true"></i>Dungeon Master & Player</dd>
                    }
                    else
                    {
                        <dd class="col-sm-9">Player</dd>
                    }

                    <dt class="col-sm-3">Building Access</dt>
                    @if (Model.User?.HasKey == true)
                    {
                        <dd class="col-sm-9"><i class="fas fa-key text-success me-2" aria-hidden="true"></i>Has Building Key</dd>
                    }
                    else
                    {
                        <dd class="col-sm-9"><i class="fas fa-times text-muted me-2" aria-hidden="true"></i>No Building Key</dd>
                    }
                </dl>

                <div class="calendar-subscription-section">
                    <h2 class="section-heading mb-3"><i class="fas fa-rss text-purple me-2" aria-hidden="true"></i>Calendar Subscription</h2>

                    @* Announces the Copy result to a screen reader: the button label changes for a couple of seconds only. *@
                    <div class="visually-hidden" role="status" data-copy-status></div>

                    @if (!Model.CalendarSubscriptions.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-rss empty-state-icon" aria-hidden="true"></i>
                            <h3 class="empty-state-heading">No calendar subscriptions yet</h3>
                            <p class="empty-state-text">Get this board's schedule onto your phone's own calendar app. The address you create acts like a password — anyone who has it can see your events, dates, and times, and it never expires on its own. Press Add Subscription to create one; nothing is generated until you do.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Subscription</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subscription in Model.CalendarSubscriptions)
                                {
                                    <tr>
                                        <td>
                                            <div class="subscription-item">
                                                <div class="subscription-summary">
                                                    <div>@subscription.Name</div>
                                                    <div class="calendar-subscription-meta">
                                                        Created @Html.LocalTime(subscription.CreatedAt, "date")
                                                        @if (subscription.LastFetchedAt.HasValue)
                                                        {
                                                            @:&middot; Last fetched @Html.LocalTime(subscription.LastFetchedAt.Value, "date-time")
                                                        }
                                                        else
                                                        {
                                                            @:&middot; Never fetched yet
                                                        }
                                                    </div>
                                                </div>
                                                <div class="calendar-subscription-actions">
                                                    @* Present and selectable but not shown: the address is a bearer credential,
                                                       and the only path that needs it on screen is the clipboard-denied
                                                       fallback, which reveals it. *@
                                                    <input type="text" readonly id="subscriptionAddress-@subscription.Id" class="form-control-plaintext font-monospace calendar-subscription-address visually-hidden" tabindex="-1" value="@subscription.HttpsAddress" aria-label="Subscription address for @subscription.Name" />
                                                    <button type="button" class="btn btn-secondary btn-sm calendar-subscription-copy-btn" data-address-target="#subscriptionAddress-@subscription.Id" aria-label="Copy address for @subscription.Name">
                                                        <i class="fas fa-copy me-2" aria-hidden="true"></i>Copy
                                                    </button>
                                                    <a class="btn btn-secondary btn-sm" href="@subscription.WebcalAddress">
                                                        <i class="fas fa-mobile-screen-button me-2" aria-hidden="true"></i>Open in Calendar App
                                                    </a>
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#qrSubscriptionModal-@subscription.Id">
                                                        <i class="fas fa-qrcode me-2" aria-hidden="true"></i>Show QR Code
                                                    </button>
                                                    <button type="button" class="btn btn-warning btn-sm calendar-subscription-rename-trigger" data-bs-toggle="modal" data-bs-target="#renameSubscriptionModal" data-subscription-id="@subscription.Id" data-subscription-name="@subscription.Name" aria-label="Rename @subscription.Name">
                                                        <i class="fas fa-pen me-2" aria-hidden="true"></i>Rename
                                                    </button>
                                                    <form asp-action="RevokeCalendarSubscription" method="post" class="d-inline calendar-subscription-delete-form">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@subscription.Id" />
                                                        <button type="submit" class="btn btn-danger btn-sm" data-subscription-id="@subscription.Id" data-subscription-name="@subscription.Name" aria-label="Delete @subscription.Name">
                                                            <i class="fas fa-trash me-2" aria-hidden="true"></i>Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @* One note for the whole list rather than a copy in every row: it says the
                           same thing each time and was the single biggest contributor to row height. *@
                        <div class="calendar-subscription-meta mb-3">If nothing happens, copy the address and add it in your calendar app manually.</div>
                    }

                    <form asp-action="AddCalendarSubscription" method="post" class="calendar-subscription-add-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-plus me-2" aria-hidden="true"></i>Add Subscription
                        </button>
                    </form>

                </div>

                <hr>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-home me-2" aria-hidden="true"></i>
                        Back to Quest Board
                    </a>
                    <a asp-action="Edit" class="btn btn-warning">
                        <i class="fas fa-edit me-2" aria-hidden="true"></i>
                        Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Dialogs live outside the card: a transformed or filtered ancestor becomes the containing
   block for fixed-position descendants, so a dialog nested in the card would be trapped in
   its stacking context and the page backdrop would paint over it and swallow every click,
   including Close. *@
    @if (Model.CalendarSubscriptions.Any())
    {
        <div class="modal fade" id="deleteSubscriptionModal" tabindex="-1" aria-labelledby="deleteSubscriptionModalLabel" aria-describedby="deleteSubscriptionMessage" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="deleteSubscriptionModalLabel">Delete Subscription</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0" id="deleteSubscriptionMessage">Delete "<span data-subscription-name-target></span>"? Any device using this address will silently stop receiving updates the next time it checks — this cannot be undone. You can always create a new subscription afterward.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-keep-subscription data-bs-dismiss="modal">Keep Subscription</button>
                        <form asp-action="RevokeCalendarSubscription" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="" />
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-2" aria-hidden="true"></i>Delete Subscription
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="renameSubscriptionModal" tabindex="-1" aria-labelledby="renameSubscriptionModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="RenameCalendarSubscription" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title" id="renameSubscriptionModalLabel">Rename Subscription</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="id" id="renameSubscriptionId" value="" />
                            <label for="renameSubscriptionName" class="form-label">Name</label>
                            <input type="text" name="name" id="renameSubscriptionName" class="form-control" maxlength="60" placeholder="e.g. My Phone" required />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Current Name</button>
                            <button type="submit" class="btn btn-primary">Save Name</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @foreach (var subscription in Model.CalendarSubscriptions)
        {
            <div class="modal fade" id="qrSubscriptionModal-@subscription.Id" tabindex="-1" aria-labelledby="qrSubscriptionModalLabel-@subscription.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title" id="qrSubscriptionModalLabel-@subscription.Id">Scan to Subscribe</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center">
                            <p>Point your phone's camera at this code to add @subscription.Name to your calendar app.</p>
                            @if (!string.IsNullOrEmpty(subscription.QrCodeSvg))
                            {
                                <div class="calendar-subscription-qr" role="img" aria-label="QR code encoding the @subscription.Name calendar subscription address">
                                    @Html.Raw(subscription.QrCodeSvg)
                                </div>
                            }
                            <div class="calendar-subscription-actions justify-content-center mt-3">
                                <button type="button" class="btn btn-secondary btn-sm calendar-subscription-copy-btn" data-address-target="#subscriptionAddress-@subscription.Id" aria-label="Copy address for @subscription.Name">
                                    <i class="fas fa-copy me-2" aria-hidden="true"></i>Copy
                                </button>
                                <a class="btn btn-secondary btn-sm" href="@subscription.WebcalAddress">
                                    <i class="fas fa-mobile-screen-button me-2" aria-hidden="true"></i>Open in Calendar App
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

@section Scripts {
    <script type="module" src="~/js/profile-subscriptions.js" asp-append-version="true"></script>
}
