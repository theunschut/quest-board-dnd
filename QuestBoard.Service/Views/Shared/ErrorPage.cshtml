@model QuestBoard.Service.ViewModels.ErrorViewModels.ErrorPageViewModel
@{
    Layout = "_Layout.Error";
    ViewData["Title"] = Model.Heading;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8 col-xl-6">
        <div class="card modern-card">
            <div class="card-header modern-card-header">
                <h1 class="mb-0">@Model.Heading</h1>
                <span class="header-subtitle">@Model.Docket</span>
            </div>
            <div class="card-body modern-card-body">
                <p>@Model.Sentence</p>
                @if (Model.Reference is not null)
                {
                    <p>Reference: <span class="error-reference">@Model.Reference</span></p>
                    <p class="form-text">Quote this reference if you ask for help.</p>
                }
                <hr>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-secondary" data-history-back href="@Model.BackHref" hidden="@(Model.BackHref is null)">
                        <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Go back
                    </a>
                    <div class="d-flex flex-wrap gap-2 ms-auto">
                        @if (Model.ShowSwitchBoard)
                        {
                            <a href="/groups/pick" class="btn btn-info">
                                <i class="fas fa-arrows-rotate me-2" aria-hidden="true"></i>Switch board
                            </a>
                        }
                        @if (Model.IsAuthenticated)
                        {
                            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="d-inline">
                                <input type="hidden" name="toLogin" value="true" />
                                <button type="submit" class="btn btn-secondary">
                                    <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>Log out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-area="" asp-route-returnUrl="@Model.LoginReturnUrl" class="btn btn-secondary">
                                <i class="fas fa-sign-in-alt me-2" aria-hidden="true"></i>Log in
                            </a>
                        }
                        <a href="/" class="btn btn-primary">
                            <i class="fas fa-home me-2" aria-hidden="true"></i>Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
