<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - D&D Quest Board</title>
    <link rel="preload" href="~/lib/bootstrap-5.3.8/css/bootstrap.min.css" as="style" />
    <link rel="preload" href="~/lib/fontawesome-6.7.2/css/all.min.css" as="style" />
    <link rel="preload" href="~/lib/cinzel/cinzel-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/legacy-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/group-picker.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 shell-fixed-nav group-picker">
<a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>

<header>
<nav class="navbar navbar-dark chrome fixed-top" aria-label="Main">
    <div class="container-fluid px-3">
        <div class="navbar-brand"><i class="fas fa-dice-d20"></i> D&amp;D Quest Board</div>
        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-light btn-sm">
                <i class="fas fa-sign-out-alt me-1"></i>Logout
            </button>
        </form>
    </div>
</nav>
</header>

<div class="container mt-4 flex-grow-1">
    <main id="main-content" tabindex="-1" role="main">
        @RenderBody()
    </main>
</div>
<partial name="_Toasts" />

<script src="~/lib/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
