@using QuestBoard.Service.Extensions
@* The single character add/change/clear modal shared by the desktop and mobile quest
   Details views. Exactly one instance of this partial is rendered per page, no matter
   how many rows offer a trigger for it -- every trigger primes this same modal from its
   own data-* attributes on open, instead of each row carrying its own copy of the modal.

   Trigger contract -- any element that opens this modal must carry:
     data-bs-toggle="modal" data-bs-target="#characterSelectModal"
     data-quest-id               -- the quest id
     data-current-character-id   -- the signup's current character id, or "" if none
     data-current-character-label -- that character's ToSelectLabel() text, or "" if none
*@
<div class="modal fade" id="characterSelectModal" tabindex="-1" aria-labelledby="characterSelectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="characterSelectModalLabel">
                    <i class="fas fa-user-edit me-2"></i><span id="characterSelectModalTitle">Add Character to Signup</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateSignupCharacter" method="post" id="characterSelectForm">
                <div class="modal-body">
                    <input type="hidden" name="questId" id="characterSelectQuestId" value="" />

                    <div class="mb-3">
                        <label for="characterSelect" class="form-label">Select Character <span class="text-danger">*</span></label>
                        <select name="characterId" id="characterSelect" class="form-select" required>
                            <option value="">-- Select a character --</option>
                            @foreach (var character in ViewBag.UserCharacters as List<Character> ?? new List<Character>())
                            {
                                <option value="@character.Id">@character.ToSelectLabel()</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-danger d-none" id="characterSelectRemoveBtn">
                        <i class="fas fa-user-minus me-2"></i>Remove Character
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-success" id="characterSelectSaveBtn">
                            <i class="fas fa-check me-2"></i>Save
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
