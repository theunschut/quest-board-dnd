@using QuestBoard.Domain.Interfaces
@using QuestBoard.Domain.Enums
@using QuestBoard.Service.Constants
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - D&D Quest Board</title>
    <link rel="preload" href="~/lib/bootstrap-5.3.8/css/bootstrap.min.css" as="style" />
    <link rel="preload" href="~/lib/fontawesome-6.7.2/css/all.min.css" as="style" />
    <link rel="preload" href="~/lib/cinzel/cinzel-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.mobile.css" asp-append-version="true" />
    <link href="~/lib/fontawesome-6.7.2/css/v4-shims.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modern-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/markdown-editor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/markdown-content.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 mobile-layout @ViewData["BodyClass"]">
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    @{
        var pages = await BoardPages.GetAsync();
        var homeRoute = BoardPageRoutes.HomeRoute(pages);
    }
    <header>
        <div class="navbar navbar-dark chrome">
            <div class="container-fluid px-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="navbar-brand" asp-controller="@homeRoute.Controller" asp-action="@homeRoute.Action">
                        <i class="fas fa-dice-d20"></i> Quest Board
                    </a>
                }
                else
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-dice-d20"></i> Quest Board
                    </a>
                }
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileNav"
                        aria-controls="mobileNav" aria-expanded="false" aria-label="Open navigation menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
    </header>

    <div class="offcanvas offcanvas-end" id="mobileNav" tabindex="-1" aria-labelledby="mobileNavTitle">
        <div class="offcanvas-header">
            <div class="offcanvas-title h5" id="mobileNavTitle">
                <i class="fas fa-dice-d20 me-2"></i>Quest Board
            </div>
            <button type="button" class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas" aria-label="Close navigation menu"></button>
        </div>
        <nav class="offcanvas-body" aria-label="Main menu">
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* Admin-only navigation items *@
                    @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOnly")).Succeeded)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                                <i class="fas fa-users-cog me-2"></i>User Management
                            </a>
                        </li>
                        @if (pages.Serves(BoardPage.Quests))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Quests">
                                <i class="fas fa-scroll me-2"></i>Quest Management
                            </a>
                        </li>
                        }
                    }

                    @* DM-only navigation items *@
                    @if ((await AuthorizationService.AuthorizeAsync(User, "DungeonMasterOnly")).Succeeded)
                    {
                        @if (pages.Serves(BoardPage.Quests))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Quest" asp-action="Create">
                                <i class="fas fa-scroll me-2"></i>Create Quest
                            </a>
                        </li>
                        }
                        @if (pages.Serves(BoardPage.Events))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Create">
                                <i class="fas fa-calendar-plus me-2"></i>Create Event
                            </a>
                        </li>
                        }
                        @if (pages.Allows(BoardPage.Events))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">
                                <i class="fas fa-calendar-check me-2"></i>Board Availability
                            </a>
                        </li>
                        }
                        @if (pages.Allows(BoardPage.Shop))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ShopManagement" asp-action="Index">
                                <i class="fas fa-coins me-2"></i>Manage Shop
                            </a>
                        </li>
                        }
                        @if (pages.Allows(BoardPage.DungeonMasterProfile))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DungeonMaster" asp-action="EditProfile">
                                <i class="fas fa-user-edit me-2"></i>Edit My Profile
                            </a>
                        </li>
                        }
                    }

                    @* Available to all authenticated users *@
                    @* The quest list is the front door unless the board chose another home, in which
                       case it needs its own entry so it stays one tap away. *@
                    @if (pages is not null && pages.EffectiveHome != BoardPage.Quests && pages.IsAvailable(BoardPage.Quests))
                    {
                    <li class="nav-item">
                        <a class="nav-link" id="nav-quests-mobile" asp-controller="Quest" asp-action="Index">
                            <i class="fas fa-scroll me-2"></i>Quests
                        </a>
                    </li>
                    }
                    @if (pages.Allows(BoardPage.Shop))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Shop" asp-action="Index">
                            <i class="fas fa-store me-2"></i>Shop
                        </a>
                    </li>
                    }
                    @if (pages.Serves(BoardPage.QuestLog))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="QuestLog" asp-action="Index">
                            <i class="fas fa-book-open me-2"></i>Quest Log
                        </a>
                    </li>
                    }
                    @if (pages.Serves(BoardPage.Characters))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Characters" asp-action="Index">
                            <i class="fas fa-people-group me-2"></i>Characters
                        </a>
                    </li>
                    }
                    @if (pages.Serves(BoardPage.Contacts))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Contacts" asp-action="Index">
                            <i class="fas fa-address-book me-2"></i>Contacts
                        </a>
                    </li>
                    }
                    @if (pages.Allows(BoardPage.Players))
                    {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Players" asp-action="Index">
                            <i class="fas fa-users me-2"></i>Players
                        </a>
                    </li>
                    }
                }

                @* The calendar shows only when the board has resolved and offers it; an
                   unresolved board is deliberately excluded rather than guessed at. *@
                @if (User.Identity?.IsAuthenticated == true && pages.Allows(BoardPage.Calendar))
                {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Calendar" asp-action="Index">
                        <i class="fas fa-calendar-alt me-2"></i>Calendar
                    </a>
                </li>
                }

                @* User profile / auth section *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var currentUser = await UserService.GetUserAsync(User);
                    var activeGroupName = HttpContextAccessor.HttpContext?.Session?.GetString(SessionKeys.ActiveGroupName);

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Profile">
                            <i class="fas fa-user-cog me-2"></i>@currentUser.Name
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="GroupPicker" asp-action="Index">
                            <i class="fas fa-arrows-rotate me-2"></i>@(string.IsNullOrEmpty(activeGroupName) ? "Switch Group" : activeGroupName)
                        </a>
                    </li>
                    @* Deliberately outside every board-type condition: this page is scoped by the
                       viewer's own board memberships, not by a resolved board type, and is the one
                       surface that works with no board selected -- gating it here would hide it in
                       exactly the situation it exists for. This is a flat sibling entry, matching
                       every other item in this offcanvas list. *@
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Agenda" asp-action="Index">
                            <i class="fas fa-calendar-days text-purple me-2"></i>My Agenda
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="nav-link btn btn-link text-start w-100"
                                    data-bs-dismiss="offcanvas">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>

    <main id="main-content" tabindex="-1" class="container-fluid px-2 mt-2 flex-grow-1">
        @RenderBody()
    </main>
    <partial name="_Toasts" />

    <partial name="_Footer.Mobile" />

    <script src="~/lib/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
