@* The two dialogs both management lists share. The Deny dialog is filled in by shop-management.js from the button
   that opened it; the Bulk Actions buttons only show a notice, because bulk actions are not built yet. *@
<div class="modal fade" id="bulkActionsModal" tabindex="-1" aria-labelledby="bulkActionsTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="bulkActionsTitle">Bulk Actions</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Select an action to apply to multiple items:</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-warning" data-bulk-action="discontinue">
                        <i class="fas fa-ban me-2" aria-hidden="true"></i>Discontinue Selected Items
                    </button>
                    <button type="button" class="btn btn-success" data-bulk-action="activate">
                        <i class="fas fa-check me-2" aria-hidden="true"></i>Activate Selected Items
                    </button>
                    <button type="button" class="btn btn-info" data-bulk-action="restock">
                        <i class="fas fa-plus-circle me-2" aria-hidden="true"></i>Restock Selected Items
                    </button>
                </div>
                <hr>
                <p class="mgmt-note mb-0">Note: Bulk actions will be available in a future update.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="denyModal" tabindex="-1" aria-labelledby="denyModalTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="denyForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title" id="denyModalTitle">
                        <i class="fas fa-times-circle me-2" aria-hidden="true"></i>Deny Item
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to deny: <strong data-deny-item-name></strong></p>
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
                        This item will be marked as denied and the creator will see your reason.
                    </div>
                    <div class="mb-3">
                        <label for="denialReason" class="form-label">
                            <i class="fas fa-comment me-1" aria-hidden="true"></i>
                            Reason for Denial <span class="text-danger" aria-hidden="true">*</span><span class="visually-hidden"> (required)</span>
                        </label>
                        <textarea class="form-control" id="denialReason" name="denialReason" rows="4"
                                  placeholder="Please provide a clear reason for denying this item..." required></textarea>
                        <div class="form-text">Explain why this item cannot be approved (e.g., too powerful, doesn't fit campaign setting, etc.)</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-2" aria-hidden="true"></i>Deny Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
